---
import { Image } from 'astro:assets';
import portrait from '../assets/magda-portrait.webp';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/withBase';
---

<Layout
  title="O mnie — Nulo Cake"
  description="Cześć, jestem Magda! Poznaj historię Nulo Cake — miejsca, w którym tworzę torty z dbałością o smak i każdy detal."
  isSubpage={true}
>
  <main id="hero-scroll-container" class="about-page" tabindex="-1">
    <section class="about-intro" aria-labelledby="about-heading">
      <div class="intro-copy">
        <h1 id="about-heading" class="display-lg section-title-lg intro-heading">
          Cześć!<br />Jestem <span class="accent">Magda.</span>
        </h1>
        <p class="intro-lead">Piekę torty, które cieszą oczy i podniebienia.</p>
        <p class="body-lg">
          W Nulo Cake piekę tak, jak lubię najbardziej — z dbałością o smak, jakość i każdy detal.
        </p>
        <p class="greeting">Miło Cię widzieć!</p>
      </div>

      <figure class="portrait">
        <Image
          src={portrait}
          alt="Magda, twórczyni Nulo Cake, trzyma tort ozdobiony figurką misia."
          widths={[320, 440, 644]}
          sizes="(max-width: 768px) calc(100vw - 3rem), (max-width: 1100px) 40vw, 440px"
          width={644}
          height={1024}
          loading="eager"
          fetchpriority="high"
          class="portrait-image"
        />
        <figcaption class="label-md portrait-caption">Magda / Nulo Cake</figcaption>
      </figure>
    </section>

    <section class="editorial-row story" aria-labelledby="story-heading">
      <p class="label-md section-label row-label">Moja historia</p>
      <div class="row-content">
        <h2 id="story-heading" class="display-sm section-title-sm section-heading">
          Zaczęło się<br /><span class="accent">niewinnie.</span>
        </h2>
        <p class="body-lg">
          Ciasto tu, ciasto tam… Potem tort dla siostry, znajomej, sąsiadki.
          I zanim się obejrzałam, powstało Nulo Cake.
        </p>
        <p class="body-lg">
          Miejsce, w którym piekę tak, jak lubię najbardziej — z dbałością o smak, jakość i każdy detal.
        </p>
      </div>
    </section>

    <section class="editorial-row workshop" aria-labelledby="workshop-heading">
      <p class="label-md section-label row-label">Moja pracownia</p>
      <div class="row-content">
        <h2 id="workshop-heading" class="title-lg section-title-sm workshop-heading">
          Smak, detale i bezpieczeństwo.
        </h2>
        <p class="body-lg">
          Moja pracownia spełnia wymogi sanepidu i podlega jego kontroli.
        </p>
      </div>
    </section>

    <section class="about-contact" aria-labelledby="contact-heading">
      <p class="label-md section-label">Stwórzmy coś razem</p>
      <h2 id="contact-heading" class="display-lg section-title-lg section-heading">
        Tort dopasowany<br /><span class="accent">do Ciebie.</span>
      </h2>
      <div class="contact-copy">
        <p class="body-lg">
          Masz ochotę na tort idealnie dopasowany do Ciebie?
          Napisz do mnie i stwórzmy razem coś wyjątkowego!
        </p>
        <p class="body-lg">
          Zamówienie możesz złożyć w wiadomości prywatnej lub mailowo.
        </p>
      </div>
      <div class="contact-actions">
        <a href="mailto:nulo.cake@gmail.com" class="btn-primary">Napisz do mnie</a>
        <a href={withBase('galeria')} class="btn-secondary">Zobacz moje torty</a>
      </div>
      <p class="farewell">Do zobaczenia!</p>
    </section>
  </main>
</Layout>

<style>
  .about-page {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 6rem) clamp(1.5rem, 5vw, 4rem) 0;
    flex-shrink: 0;
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(3.5rem, 8vw, 7rem);
  }

  .intro-copy {
    max-width: 34rem;
  }

  .section-label,
  .accent,
  .greeting {
    color: var(--color-primary);
  }

  .section-label {
    margin-bottom: 1.5rem;
  }

  .intro-heading {
    line-height: 1.1;
    margin-bottom: 2rem;
  }

  .intro-lead {
    max-width: 26ch;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .greeting {
    margin-top: 2rem;
    font-weight: 600;
  }

  .portrait {
    width: 100%;
    max-width: 440px;
    justify-self: end;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-surface);
  }

  .portrait-caption {
    margin-top: 1rem;
    color: var(--color-outline);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }

  .editorial-row {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    border-top: 1px solid var(--color-outline-variant);
  }

  .row-label {
    margin-bottom: 0;
    padding-top: 0.25rem;
    color: var(--color-outline);
  }

  .row-content {
    max-width: 42rem;
  }

  .story {
    padding: clamp(3rem, 6vw, 5.5rem) 0;
  }

  .section-heading {
    margin-bottom: 1.75rem;
  }

  .row-content .body-lg + .body-lg,
  .contact-copy .body-lg + .body-lg {
    margin-bottom: 1rem;
    margin-top: 1rem;
  }

  .workshop {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .workshop-heading {
    margin-bottom: 0.75rem;
  }

  .about-contact {
    padding: clamp(3.5rem, 8vw, 7rem) 0;
  }

  .contact-copy {
    max-width: 38rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .farewell {
    color: var(--color-on-surface-variant);
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .about-intro,
    .editorial-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .portrait {
      justify-self: start;
    }

    .row-label {
      padding-top: 0;
    }

    .contact-actions a {
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-actions a {
      transition: none;
      will-change: auto;
    }

    .contact-actions a:hover,
    .contact-actions a:active {
      transform: none;
    }
  }
</style>
