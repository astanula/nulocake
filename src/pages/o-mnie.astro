---
import { Image } from 'astro:assets';
import portrait from '../assets/magda-portrait.webp';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionDots from '../components/section-nav/SectionDots.astro';
import ScrollHintArrow from '../components/stack-fade/ScrollHintArrow.astro';
import { CUSTOM_MEDIA } from '../config/responsive';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/withBase';

const sectionLabels = ['Cześć! Jestem Magda.', 'Tort dopasowany do Ciebie.'];
---

<Layout
  title="O mnie — Nulo Cake"
  description="Cześć, jestem Magda! Poznaj historię Nulo Cake — miejsca, w którym tworzę torty z dbałością o smak i każdy detal."
>
  <Navigation />

  <main id="hero-scroll-container" class="about-page" tabindex="-1">
    <SectionDots labels={sectionLabels} class="about-dots" />
    <ScrollHintArrow class="about-hint" />

    <div class="about-split">
      <div class="about-text-col">
        <section class="about-section about-intro is-active" aria-labelledby="about-heading" tabindex="-1">
          <div class="content-section-inner intro-copy">
            <h1 id="about-heading" class="display-lg section-title-lg intro-heading">
              <span class="word">Cześć!</span><br /><span class="word">Jestem</span> <span class="word accent">Magda.</span>
            </h1>
            <p class="body-lg intro-lead blur-in">
              <span class="accent">Miło Cię widzieć!</span> Piekę torty, które cieszą oczy i podniebienia.
            </p>
            <p class="body-lg blur-in">
              Zaczęło się niewinnie — ciasto tu, ciasto tam… Potem tort dla siostry, znajomej, sąsiadki.
              I zanim się obejrzałam, powstało <span class="accent">Nulo Cake</span>.
            </p>
            <p class="body-lg blur-in">
              To miejsce, w którym piekę tak, jak lubię najbardziej — z dbałością o
              <span class="accent">smak</span>, <span class="accent">jakość</span> i każdy <span class="accent">detal</span>.
            </p>
            <p class="body-lg blur-in">
              Torty przygotowuję w swojej pracowni, która spełnia wymogi sanitarne i podlega kontroli sanepidu.
            </p>
          </div>
        </section>

        <section class="about-section about-contact" aria-labelledby="contact-heading" tabindex="-1">
          <div class="content-section-inner">
            <h2 id="contact-heading" class="display-lg section-title-lg section-heading">
              <span class="word">Tort</span> <span class="word">dopasowany</span><br /><span class="accent"><span class="word">do</span> <span class="word">Ciebie.</span></span>
            </h2>
            <div class="contact-copy">
              <p class="body-lg blur-in">
                Masz już pomysł na swój tort? Chętnie go poznam.
                A jeśli jeszcze nie wiesz, czego szukasz — pomogę Ci wybrać smaki i dekoracje.
              </p>
              <p class="body-lg blur-in">
                Napisz do mnie — resztę ustalimy razem.
              </p>
            </div>
            <div class="contact-actions section-cta-group blur-in">
              <a href="mailto:nulo.cake@gmail.com" class="btn-primary">Napisz do mnie</a>
              <a href={withBase('galeria')} class="btn-secondary">Zobacz moje torty</a>
            </div>
          </div>
        </section>
      </div>

      <div class="about-media-col">
        <div class="about-media-wrapper">
          <Image
            src={portrait}
            alt="Magda, twórczyni Nulo Cake, trzyma tort ozdobiony figurką misia."
            widths={[320, 440, 644]}
            sizes={`${CUSTOM_MEDIA['--below-tablet']} 100vw, ${CUSTOM_MEDIA['--below-desktop']} 36vw, 440px`}
            width={644}
            height={1024}
            loading="eager"
            fetchpriority="high"
            class="portrait-image"
          />
        </div>
      </div>
    </div>

    <div class="home-footer-dock" inert>
      <Footer />
    </div>
  </main>
</Layout>

<style>
  :global(html.home-snap-active) {
    scrollbar-gutter: stable;
    overscroll-behavior-y: none;
  }

  .about-page {
    position: relative;
    width: 100%;
    outline: none;
    --home-footer-h: 0px;
  }

  .about-page .about-dots {
    position: fixed;
    left: calc(
      var(--section-dots-offset) + var(--section-dot-mark-size) * (var(--section-dot-active-scale) - 1) / 2
    );
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
  }

  .about-page .about-hint {
    position: fixed;
    left: 50%;
    bottom: calc(var(--scroll-hint-bottom) + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 5;
  }

  .about-split {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  .about-text-col {
    position: relative;
    min-width: 0;
    z-index: 2;
  }

  .about-section {
    position: relative;
    min-height: 100dvh;
    height: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: calc(4.5rem + var(--subpage-top-offset)) 2rem 4.5rem 4rem;
    outline: none;
  }

  .about-contact {
    padding-bottom: calc(4.5rem + var(--home-footer-h));
  }

  .content-section-inner {
    min-width: 0;
    width: 100%;
  }

  .word {
    display: inline-block;
    will-change: filter, transform, opacity;
    transform-style: preserve-3d;
  }

  .intro-copy .body-lg {
    max-width: 34rem;
  }

  .accent {
    color: var(--color-primary);
  }

  .intro-heading {
    margin-bottom: 2rem;
  }

  .intro-lead {
    color: var(--color-on-surface);
    font-size: var(--type-title-lg-size);
    line-height: 1.55;
  }

  .intro-copy .body-lg + .body-lg {
    margin-top: 1.25rem;
  }

  .section-heading {
    margin-bottom: 1.75rem;
  }

  .contact-copy .body-lg + .body-lg {
    margin-bottom: 1rem;
    margin-top: 1rem;
  }

  .contact-copy {
    max-width: 38rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .about-media-col {
    position: sticky;
    top: 0;
    min-width: 0;
    height: 100dvh;
    align-self: start;
  }

  .about-media-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: calc(4.5rem + var(--subpage-top-offset)) 2rem 2rem;
    overflow: hidden;
  }

  .portrait-image {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 440px);
    max-height: calc(100dvh - 6.5rem - var(--subpage-top-offset));
    object-fit: contain;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  @media (--below-laptop) {
    .about-section {
      padding-inline: 2.5rem 1.5rem;
    }

    .about-media-wrapper {
      padding-inline: 1.5rem;
    }

    .portrait-image {
      max-width: min(100%, 400px);
    }
  }

  @media (--below-tablet) {
    .about-split {
      grid-template-columns: 1fr;
    }

    .about-media-col {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      z-index: 1;
      opacity: 0.16;
      pointer-events: none;
    }

    .about-media-wrapper {
      display: block;
      padding: 0;
    }

    .portrait-image {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      object-fit: cover;
      object-position: center top;
      border-radius: 0;
    }

    .about-text-col {
      grid-column: 1;
      grid-row: 1;
    }

    .about-section {
      padding-inline: 2.25rem 1.5rem;
    }

    .contact-actions a {
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-section:not(.is-active) {
      display: none;
    }

    .about-section.is-active {
      display: flex;
      overflow: clip;
    }

    .home-footer-dock {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-page .about-dots,
    .about-page .about-hint {
      display: none;
    }

    .contact-actions a {
      transition: none;
      will-change: auto;
    }

    .contact-actions a:hover,
    .contact-actions a:active {
      transform: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { computeSectionData, buildSectionTimeline } from '../home/sectionTimeline';
  import { mountSnapNavigator } from '../home/snapNavigator';

  declare global {
    interface Window {
      aboutPageLoadListenerAdded?: boolean;
      aboutPageBeforeSwapListenerAdded?: boolean;
      aboutMotionQueryListenerAdded?: boolean;
    }
  }

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  let teardownSnap: (() => void) | null = null;

  const isAboutPage = () => document.querySelector('.about-section') !== null;

  function showStaticAbout() {
    document.querySelector('.home-footer-dock')?.removeAttribute('inert');
    document.querySelectorAll<HTMLElement>('.about-section, .about-section .word, .about-section .blur-in').forEach((el) => {
      gsap.set(el, { clearProps: 'all' });
    });
  }

  function stopAboutAnimation() {
    teardownSnap?.();
    teardownSnap = null;
  }

  function initAboutPage() {
    const root = document.querySelector<HTMLElement>('.about-page');
    const sections = gsap.utils.toArray<HTMLElement>('.about-section');

    if (!root || sections.length === 0) return;

    stopAboutAnimation();

    if (motionQuery.matches) {
      showStaticAbout();
      return;
    }

    sections.forEach((sec, i) => sec.classList.toggle('is-active', i === 0));
    const layout = computeSectionData(sections);
    layout.sectionData[0].elements.forEach((elem) => {
      gsap.set(elem.el, { clearProps: 'all' });
    });

    teardownSnap = mountSnapNavigator(root, buildSectionTimeline(layout));
  }

  if (!window.aboutPageLoadListenerAdded) {
    document.addEventListener('astro:page-load', initAboutPage);
    window.aboutPageLoadListenerAdded = true;
  }

  if (!window.aboutPageBeforeSwapListenerAdded) {
    document.addEventListener('astro:before-swap', () => {
      if (!isAboutPage()) return;
      stopAboutAnimation();
    });
    window.aboutPageBeforeSwapListenerAdded = true;
  }

  if (!window.aboutMotionQueryListenerAdded) {
    motionQuery.addEventListener('change', (e) => {
      if (!isAboutPage()) return;
      if (e.matches) {
        stopAboutAnimation();
        showStaticAbout();
      } else {
        initAboutPage();
      }
    });
    window.aboutMotionQueryListenerAdded = true;
  }
</script>
