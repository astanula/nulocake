---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/withBase';
---

<Layout title="O mnie — Nulo Cake" description="Poznaj historię Nulo Cake. Artystyczne torty na zamówienie tworzone z pasją i sercem." isSubpage={true}>
  <main class="page-placeholder">
    <div class="placeholder-inner">
      <p class="label-md">O mnie</p>
      <h1 class="display-lg">Wkrótce</h1>
      <p class="body-lg">Ta strona jest w przygotowaniu.</p>
      <a href={withBase('')} class="btn-secondary">Wróć na stronę główną</a>
    </div>
  </main>
</Layout>

<style>
  .page-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 2rem;
  }
  .placeholder-inner {
    text-align: left;
    max-width: 480px;
  }
  .placeholder-inner .label-md {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .placeholder-inner .display-lg {
    margin-bottom: 1rem;
  }
  .placeholder-inner .body-lg {
    margin-bottom: 2rem;
  }
</style>
