---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionNavRail from '../components/section-nav/SectionNavRail.astro';
import { withBase } from '../utils/withBase';

const labels = ['Strona główna', 'O nas', 'Galeria', 'Opinie klientów', 'Kontakt'];

const galleryImages = [
  { src: 'gallery-1.webp', alt: 'Artystyczny tort weselny z różowymi różami' },
  { src: 'gallery-2.webp', alt: 'Kolorowy tort urodzinowy z akwarelowym wzorem' },
  { src: 'gallery-3.webp', alt: 'Elegancki minimalistyczny tort ze złotymi detalami' },
  { src: 'gallery-4.webp', alt: 'Fantazyjny tort dziecięcy z figurkami' },
  { src: 'gallery-1.webp', alt: 'Artystyczny tort weselny z różowymi różami' },
  { src: 'gallery-2.webp', alt: 'Kolorowy tort urodzinowy z akwarelowym wzorem' },
];

const testimonials = [
  {
    text: '"Tort był absolutnym dziełem sztuki. Nikt nie chciał go kroić, dopóki nie spróbowaliśmy pierwszego kawałka!"',
    name: 'Anna Kowalska',
    role: 'Wesele, czerwiec 2025',
  },
  {
    text: '"Szukałem czegoś unikalnego na 30-ste urodziny żony. Nulo Cake przerosiło moje oczekiwania."',
    name: 'Marek Wiśniewski',
    role: 'Urodziny, marzec 2025',
  },
  {
    text: '"Perfekcyjne wykonanie i niesamowity smak. Goście do dziś pytają, skąd mieliśmy ten tort!"',
    name: 'Katarzyna Nowicka',
    role: 'Komunia, maj 2025',
  },
];

const starPath = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z';
---

<Layout title="Nulo Cake — Artystyczne Torty Na Zamówienie" description="Wymarzony tort na Twoją wyjątkową okazję. Artystyczne torty na zamówienie tworzone z pasją. Jadalne dzieła sztuki, które dopełnią Twoją uroczystość.">
  <Navigation />

  <main class="v2-root" id="v2-root" tabindex="-1">
    <div class="v2-frame">
      <div class="v2-left">
        <SectionNavRail>
          <nav class="v2-dots" aria-label="Sekcje">
            <ul>
              {labels.map((label, i) => (
                <li>
                  <button type="button" class="v2-dot" data-v2-dot={i} aria-label={label} aria-current={i === 0 ? 'true' : undefined}>
                    <span class="v2-dot-mark" aria-hidden="true"></span>
                    <span class="v2-dot-label" aria-hidden="true">{label}</span>
                  </button>
                </li>
              ))}
            </ul>
          </nav>
        </SectionNavRail>

        <div class="v2-stage">
          <section id="v2-section-hero" class="v2-section is-active" aria-label={labels[0]} tabindex="-1">
            <div class="v2-section-inner">
              <h1 class="display-lg section-title-home v2-heading">
                Wymarzony tort<br />
                na Twoją <span class="accent-italic">wyjątkową</span> okazję.
              </h1>
              <p class="body-lg v2-body">
                Artystyczne torty na zamówienie tworzone z pasją. Jesteś w odpowiednim miejscu, aby to słodkie marzenie spełnić!
              </p>
              <div class="v2-cta-group">
                <a href={withBase('oferta')} class="btn-primary" id="v2-cta-oferta">Sprawdź ofertę</a>
                <a href={withBase('galeria')} class="btn-secondary" id="v2-cta-galeria">Zobacz galerię</a>
              </div>
            </div>
          </section>

          <section id="v2-section-story" class="v2-section" aria-label={labels[1]} tabindex="-1">
            <div class="v2-section-inner">
              <h2 class="display-lg section-title-home v2-heading">
                Sztuka, która<br />
                <span class="accent-italic">zachwyca</span> smakiem.
              </h2>
              <p class="body-lg v2-body">
                Wierzę, że każdy tort to osobna historia. W moją pracę wkładam całe serce, traktując każde zamówienie jako w 100% indywidualny projekt. Zależy mi na tym, aby efekt końcowy nie tylko zapierał dech w piersiach unikalną dekoracją dopracowaną w każdym detalu, ale również zniewalał smakiem od pierwszego kęsa.
              </p>
              <div class="v2-cta-group">
                <a href={withBase('o-mnie')} class="btn-secondary v2-link" id="v2-cta-historia">
                  Poznaj moją historię
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </a>
              </div>
            </div>
          </section>

          <section id="v2-section-gallery" class="v2-section" aria-label={labels[2]} tabindex="-1">
            <div class="v2-section-inner">
              <h2 class="display-lg section-title-home v2-heading">
                Moje słodkie<br />
                <span class="accent-italic">dzieła</span> sztuki
              </h2>
              <div class="v2-gallery">
                {galleryImages.map((img) => (
                  <div class="v2-gallery-item">
                    <img src={withBase(img.src)} alt={img.alt} width="400" height="400" loading="lazy" />
                  </div>
                ))}
              </div>
              <div class="v2-cta-group">
                <a href={withBase('galeria')} class="btn-secondary" id="v2-cta-full-galeria">Pełna Galeria</a>
              </div>
            </div>
          </section>

          <section id="v2-section-testimonials" class="v2-section" aria-label={labels[3]} tabindex="-1">
            <div class="v2-section-inner">
              <h2 class="display-lg section-title-home v2-heading">
                Co mówią moi<br />
                <span class="accent-italic">klienci?</span>
              </h2>
              <div class="v2-testimonials" id="v2-testimonials" aria-live="polite">
                <div class="v2-carousel-track">
                  {testimonials.map((t) => (
                    <blockquote class="v2-testimonial v2-carousel-slide">
                      <div class="v2-stars" role="img" aria-label="5 z 5 gwiazdek">
                        {Array.from({ length: 5 }).map(() => (
                          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d={starPath}/></svg>
                        ))}
                      </div>
                      <p class="v2-testimonial-text">{t.text}</p>
                      <footer class="v2-testimonial-author">
                        <span class="v2-testimonial-name">{t.name}</span>
                        <span class="v2-testimonial-role">{t.role}</span>
                      </footer>
                    </blockquote>
                  ))}
                </div>
                <button type="button" class="v2-carousel-btn v2-carousel-prev" aria-label="Poprzednia opinia" id="v2-carousel-prev">
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 3L5 8l5 5"/>
                  </svg>
                </button>
                <button type="button" class="v2-carousel-btn v2-carousel-next" aria-label="Następna opinia" id="v2-carousel-next">
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3l5 5-5 5"/>
                  </svg>
                </button>
              </div>
            </div>
          </section>

          <section id="v2-section-contact" class="v2-section v2-section--last" aria-label={labels[4]} tabindex="-1">
            <div class="v2-section-inner">
              <h2 class="display-lg section-title-home v2-heading">
                Gotowy na swój<br />
                <span class="accent-italic">wymarzony</span> tort?
              </h2>
              <p class="body-lg v2-body">
                Napisz do mnie — opowiedz o swojej okazji, a ja zajmę się resztą.
              </p>
              <div class="v2-cta-group">
                <a href={withBase('kontakt')} class="btn-primary" id="v2-cta-kontakt">Skontaktuj się i zarezerwuj termin</a>
              </div>
            </div>
          </section>
        </div>
      </div>

      <div class="v2-media" aria-hidden="true">
        <img src={withBase('hero-poster.webp')} alt="" class="v2-media-img" />
        <div class="v2-media-glow"></div>
      </div>
    </div>

    <div class="v2-footer-dock" inert>
      <Footer />
    </div>
  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════
     PAGE LOCK — v2 is a fixed full-screen page.
     Also neutralises Layout's `scroll-layout-active`
     (applied to every non-home path).
     ═══════════════════════════════════════════ */
  :global(html:has(.v2-root)),
  :global(html:has(.v2-root) body) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(body.scroll-layout-active:has(.v2-root)) {
    display: block;
  }

  :global(body.scroll-layout-active:has(.v2-root) .nav) {
    position: fixed !important;
  }

  /* ═══════════════════════════════════════════
     LAYOUT — Split Screen
     ═══════════════════════════════════════════ */
  .v2-root {
    position: relative;
    width: 100%;
    height: 100dvh;
    outline: none;
    --v2-footer-h: 0px;
  }

  .v2-frame {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1400px;
    margin: 0 auto;
  }

  .v2-left {
    position: relative;
    height: 100%;
    z-index: 2;
  }

  .v2-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 5.5rem);
    mask-image: linear-gradient(to bottom, transparent 0, #000 5.5rem);
  }

  /* ── Sections ────────────────────────────── */
  .v2-section {
    --v2-section-bg: var(--color-background);
    position: absolute;
    inset: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: max(7rem, 18vh) 2rem 4rem 4.5rem;
    background: var(--v2-section-bg);
    visibility: hidden;
    transform-origin: 50% 50%;
    outline: none;
  }

  .v2-section::-webkit-scrollbar {
    display: none;
  }

  .v2-section.is-active {
    visibility: visible;
  }

  .v2-section--last {
    padding-bottom: calc(4rem + var(--v2-footer-h));
  }

  .v2-section-inner {
    max-width: 560px;
    width: 100%;
  }

  .v2-heading {
    margin-bottom: 1.5rem;
  }

  .v2-body {
    margin-bottom: 2rem;
  }

  .v2-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .v2-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .v2-link svg {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .v2-link:hover svg,
  .v2-link:focus-visible svg,
  .v2-link:active svg {
    transform: translateX(4px);
  }

  /* ── Dots ────────────────────────────────── */
  .v2-dots ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .v2-dot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: var(--section-dot-size);
    height: var(--section-dot-size);
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    outline: none;
  }

  .v2-dot-mark {
    width: var(--section-dot-mark-size);
    height: var(--section-dot-mark-size);
    border-radius: 50%;
    background: var(--color-outline);
    opacity: 0.6;
    transform-origin: left center;
    transition: background 0.3s, opacity 0.3s, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s;
  }

  .v2-dot:hover .v2-dot-mark {
    opacity: 1;
    transform: scale(1.25);
  }

  .v2-dot[aria-current='true'] .v2-dot-mark {
    background: var(--color-primary);
    opacity: 1;
    transform: scale(1.35);
    box-shadow: 0 0 10px rgba(255, 170, 248, 0.5);
  }

  .v2-dot:focus-visible .v2-dot-mark {
    box-shadow: 0 0 0 3px var(--color-background), 0 0 0 4px var(--color-primary);
  }

  .v2-dot-label {
    position: absolute;
    left: calc(100% + 0.5rem);
    top: 50%;
    transform: translate(-0.25rem, -50%);
    white-space: nowrap;
    padding: 0.25rem 0.625rem;
    border-radius: 0.125rem;
    background: var(--color-surface-container-high);
    color: var(--color-on-surface);
    font-family: var(--font-family-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .v2-dot:hover .v2-dot-label,
  .v2-dot:focus-visible .v2-dot-label {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* ── Media (right) ───────────────────────── */
  .v2-media {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .v2-media-img {
    width: 85%;
    max-width: 560px;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .v2-media-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    height: 70%;
    background: radial-gradient(ellipse, var(--color-glow) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* ── Footer dock ─────────────────────────── */
  .v2-footer-dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    transform: translateY(100%);
  }

  /* ── Gallery strip ───────────────────────── */
  .v2-gallery {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-bottom: 0.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .v2-gallery::-webkit-scrollbar {
    display: none;
  }

  .v2-gallery-item {
    flex: 0 0 140px;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    border-radius: 0.25rem;
    aspect-ratio: 1;
    background: var(--color-surface-container-lowest);
    cursor: pointer;
  }

  .v2-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .v2-gallery-item:hover img,
  .v2-gallery-item:focus-within img,
  .v2-gallery-item:active img {
    transform: scale(1.06);
  }

  /* ── Testimonials carousel ───────────────── */
  .v2-testimonials {
    position: relative;
    overflow: hidden;
    margin-top: 1.5rem;
    padding: 0 10%;
  }

  .v2-carousel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .v2-carousel-slide {
    flex: 0 0 80%;
    padding: 0 0.5rem;
    box-sizing: border-box;
  }

  .v2-testimonial {
    padding: 1.5rem;
    background: var(--color-surface-container-low);
    border-radius: 0.25rem;
    border: none;
    margin: 0;
  }

  .v2-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background: var(--color-surface-container-low);
    border: 1px solid var(--color-outline);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-on-surface);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    padding: 0;
  }

  .v2-carousel-btn:hover,
  .v2-carousel-btn:focus-visible {
    background: var(--color-surface-container);
    border-color: var(--color-primary);
    outline: none;
  }

  .v2-carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .v2-carousel-prev {
    left: 0;
  }

  .v2-carousel-next {
    right: 0;
  }

  .v2-stars {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .v2-testimonial-text {
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-on-surface);
    font-style: italic;
    margin-bottom: 1rem;
  }

  .v2-testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .v2-testimonial-name {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-on-surface);
  }

  .v2-testimonial-role {
    font-family: var(--font-family-body);
    font-size: 0.875rem;
    color: var(--color-outline);
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — TABLET TIER
     ═══════════════════════════════════════════ */
  @media (--tablet-only) {
    .v2-section {
      padding: 6rem 1.5rem 3rem 3.5rem;
    }
    .v2-section--last {
      padding-bottom: calc(3rem + var(--v2-footer-h));
    }
    .v2-section-inner {
      max-width: 420px;
    }
    .v2-media-img {
      width: 90%;
      max-width: 400px;
    }
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — MOBILE COLLAPSE
     Image becomes a full-screen background; sections
     are a translucent dark layer so it shows through.
     ═══════════════════════════════════════════ */
  @media (--below-tablet) {
    .v2-frame {
      grid-template-columns: 1fr;
    }

    .v2-left {
      grid-column: 1;
      grid-row: 1;
    }

    .v2-media {
      grid-column: 1;
      grid-row: 1;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }

    .v2-media-img {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      border-radius: 0;
    }

    .v2-section {
      --v2-section-bg: rgba(19, 19, 19, 0.8);
      padding: max(6rem, 15vh) 1.5rem 3rem 2.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .v2-section--last {
      padding-bottom: calc(3rem + var(--v2-footer-h));
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { Observer } from 'gsap/Observer';
  import { mountStackFade } from '../home-v2/stackFade';
  import { initTestimonials } from '../home-v2/testimonialsCarousel';

  gsap.registerPlugin(Observer);

  let teardowns: Array<() => void> = [];

  function teardownHomeV2() {
    teardowns.forEach((fn) => fn());
    teardowns = [];
  }

  function initHomeV2() {
    const root = document.querySelector<HTMLElement>('.v2-root');
    if (!root) return;
    teardownHomeV2();
    teardowns.push(mountStackFade(root));
    const testimonials = root.querySelector<HTMLElement>('#v2-testimonials');
    if (testimonials) teardowns.push(initTestimonials(testimonials));
  }

  if (!window.homeV2PageLoadAdded) {
    document.addEventListener('astro:page-load', initHomeV2);
    window.homeV2PageLoadAdded = true;
  }

  if (!window.homeV2BeforeSwapAdded) {
    document.addEventListener('astro:before-swap', teardownHomeV2);
    window.homeV2BeforeSwapAdded = true;
  }
</script>
