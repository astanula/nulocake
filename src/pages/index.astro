---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Nulo Cake — Artystyczne Torty Na Zamówienie" description="Wymarzony tort na Twoją wyjątkową okazję. Artystyczne torty na zamówienie tworzone z pasją. Jadalne dzieła sztuki, które dopełnią Twoją uroczystość.">
  <Navigation />

  <!-- ═══════════════════════════════════════════
       HERO SCROLL CONTAINER
       Split-screen: Left = text sections, Right = pinned video
       ═══════════════════════════════════════════ -->
  <main id="hero-scroll-container" class="hero-container" tabindex="-1">
    <div class="hero-sticky-wrapper">
      <!-- ── LEFT: Scrolling Text Sections ──────── -->
      <div class="hero-text-col">

        <!-- Section 1: Hero / Above the Fold -->
        <section id="section-hero" class="hero-section" aria-label="Strona główna">
          <div class="hero-section-inner">
            <h1 class="display-lg section-heading">
              <span class="word">Wymarzony</span> <span class="word">tort</span><br />
              <span class="word">na</span> <span class="word">Twoją</span> <span class="word accent-italic">wyjątkową</span> <span class="word">okazję.</span>
            </h1>
            <p class="body-lg section-body blur-in">
              Artystyczne torty na zamówienie tworzone z pasją. Jesteś w odpowiednim miejscu, aby to słodkie marzenie spełnić!
            </p>
            <div class="section-cta-group blur-in">
              <a href="/oferta" class="btn-primary" id="cta-oferta">Sprawdź ofertę</a>
              <a href="/galeria" class="btn-secondary" id="cta-galeria">Zobacz galerię</a>
            </div>
          </div>
        </section>

        <!-- Section 2: About / Story -->
        <section id="section-story" class="hero-section" aria-label="O nas">
          <div class="hero-section-inner">
            <h2 class="display-lg section-heading">
              <span class="word">Sztuka,</span> <span class="word">która</span><br />
              <span class="word accent-italic">zachwyca</span> <span class="word">smakiem.</span>
            </h2>
            <p class="body-lg section-body blur-in">
              Wierzę, że każdy tort to osobna historia. W moją pracę wkładam całe serce, traktując każde zamówienie jako w 100% indywidualny projekt. Zależy mi na tym, aby efekt końcowy nie tylko zapierał dech w piersiach unikalną dekoracją dopracowaną w każdym detalu, ale również zniewalał smakiem od pierwszego kęsa.
            </p>
            <div class="section-cta-group blur-in">
              <a href="/o-mnie" class="btn-secondary section-link" id="cta-historia">
                Poznaj moją historię
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </a>
            </div>
          </div>
        </section>

        <!-- Section 3: Gallery Preview -->
        <section id="section-gallery" class="hero-section" aria-label="Galeria">
          <div class="hero-section-inner">
            <h2 class="display-lg section-heading">
              <span class="word">Moje</span> <span class="word">słodkie</span><br />
              <span class="word accent-italic">dzieła</span> <span class="word">sztuki</span>
            </h2>
            <div class="gallery-carousel blur-in">
              <div class="gallery-item">
                <img src="/gallery-1.webp" alt="Artystyczny tort weselny z różowymi różami" width="400" height="400" loading="lazy" />
              </div>
              <div class="gallery-item">
                <img src="/gallery-2.webp" alt="Kolorowy tort urodzinowy z akwarelowym wzorem" width="400" height="400" loading="lazy" />
              </div>
              <div class="gallery-item">
                <img src="/gallery-3.webp" alt="Elegancki minimalistyczny tort ze złotymi detalami" width="400" height="400" loading="lazy" />
              </div>
              <div class="gallery-item">
                <img src="/gallery-4.webp" alt="Fantazyjny tort dziecięcy z figurkami" width="400" height="400" loading="lazy" />
              </div>
              <div class="gallery-item">
                <img src="/gallery-1.webp" alt="Artystyczny tort weselny z różowymi różami" width="400" height="400" loading="lazy" />
              </div>
              <div class="gallery-item">
                <img src="/gallery-2.webp" alt="Kolorowy tort urodzinowy z akwarelowym wzorem" width="400" height="400" loading="lazy" />
              </div>
            </div>
            <div class="section-cta-group blur-in">
              <a href="/galeria" class="btn-secondary" id="cta-full-galeria">Pełna Galeria</a>
            </div>
          </div>
        </section>

        <!-- Section 4: Testimonials -->
        <section id="section-testimonials" class="hero-section" aria-label="Opinie klientów">
          <div class="hero-section-inner">
            <h2 class="display-lg section-heading">
              <span class="word">Co</span> <span class="word">mówią</span> <span class="word">moi</span><br />
              <span class="word accent-italic">klienci?</span>
            </h2>
            <div class="testimonials-carousel blur-in" id="testimonials-carousel" aria-live="polite">
              <div class="carousel-track">
                <blockquote class="testimonial-card carousel-slide">
                  <div class="testimonial-stars" role="img" aria-label="5 z 5 gwiazdek">
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  </div>
                  <p class="testimonial-text">"Tort był absolutnym dziełem sztuki. Nikt nie chciał go kroić, dopóki nie spróbowaliśmy pierwszego kawałka!"</p>
                  <footer class="testimonial-author">
                    <span class="testimonial-name">Anna Kowalska</span>
                    <span class="testimonial-role">Wesele, czerwiec 2025</span>
                  </footer>
                </blockquote>

                <blockquote class="testimonial-card carousel-slide">
                  <div class="testimonial-stars" role="img" aria-label="5 z 5 gwiazdek">
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  </div>
                  <p class="testimonial-text">"Szukałem czegoś unikalnego na 30-ste urodziny żony. Nulo Cake przerosiło moje oczekiwania."</p>
                  <footer class="testimonial-author">
                    <span class="testimonial-name">Marek Wiśniewski</span>
                    <span class="testimonial-role">Urodziny, marzec 2025</span>
                  </footer>
                </blockquote>

                <blockquote class="testimonial-card carousel-slide">
                  <div class="testimonial-stars" role="img" aria-label="5 z 5 gwiazdek">
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  </div>
                  <p class="testimonial-text">"Perfekcyjne wykonanie i niesamowity smak. Goście do dziś pytają, skąd mieliśmy ten tort!"</p>
                  <footer class="testimonial-author">
                    <span class="testimonial-name">Katarzyna Nowicka</span>
                    <span class="testimonial-role">Komunia, maj 2025</span>
                  </footer>
                </blockquote>
              </div>
              <button class="carousel-btn carousel-prev" aria-label="Poprzednia opinia" id="carousel-prev">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 3L5 8l5 5"/>
                </svg>
              </button>
              <button class="carousel-btn carousel-next" aria-label="Następna opinia" id="carousel-next">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 3l5 5-5 5"/>
                </svg>
              </button>
            </div>
          </div>
        </section>

        <!-- Section 5: CTA / Contact -->
        <section id="section-contact" class="hero-section" aria-label="Kontakt">
          <div class="hero-section-inner">
            <h2 class="display-lg section-heading">
              <span class="word">Gotowy</span> <span class="word">na</span> <span class="word">swój</span><br />
              <span class="word accent-italic">wymarzony</span> <span class="word">tort?</span>
            </h2>
            <p class="body-lg section-body blur-in">
              Napisz do mnie — opowiedz o swojej okazji, a ja zajmę się resztą.
            </p>
            <div class="section-cta-group blur-in">
              <a href="/kontakt" class="btn-primary" id="cta-kontakt">Skontaktuj się i zarezerwuj termin</a>
            </div>
          </div>
        </section>

      </div>

      <!-- ── RIGHT: Pinned Video ────────────────── -->
      <div class="hero-video-col" id="hero-video-col">
        <div class="hero-video-wrapper">
          <!-- TEMPORARILY DISABLED VIDEO FOR PERFORMANCE
          <video
            id="hero-video"
            src="/hero-video.mp4"
            poster="/hero-poster.webp"
            muted
            playsinline
            preload="metadata"
            class="hero-video"
            aria-hidden="true"
            tabindex="-1"
          ></video>
          -->
          <img src="/hero-poster.webp" alt="" class="hero-video" id="hero-video-fallback" />
          <!-- Subtle ambient glow behind the video -->
          <div class="hero-video-glow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════════
     HERO SCROLL LAYOUT — Split Screen
     ═══════════════════════════════════════════ */
  .hero-container {
    position: relative;
    width: 100%;
  }

  .hero-sticky-wrapper {
    height: 100dvh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1400px;
    margin: 0 auto;
    overflow: hidden;
  }

  /* ── Left Column: scrolling text ─────────── */
  .hero-text-col {
    position: relative;
    height: 100%;
    z-index: 2;
  }

  .hero-section {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: max(7rem, 18vh) 2rem 4rem 4rem;
    pointer-events: none;
    visibility: hidden;
  }

  .hero-section.is-active {
    pointer-events: auto;
    visibility: visible;
  }

  .hero-section-inner {
    max-width: 560px;
    width: 100%;
  }

  .word {
    display: inline-block;
    will-change: filter, transform, opacity;
    transform-style: preserve-3d;
  }

  .section-label {
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-body {
    margin-bottom: 1rem;
  }

  .section-body:last-of-type {
    margin-bottom: 2rem;
  }

  .section-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-link svg {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .section-link:hover svg,
  .section-link:focus-visible svg,
  .section-link:active svg {
    transform: translateX(4px);
  }

  /* ── Right Column: pinned video ──────────── */
  .hero-video-col {
    position: relative;
    height: 100%;
  }

  .hero-video-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-video {
    width: 85%;
    max-width: 560px;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .hero-video-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    height: 70%;
    background: radial-gradient(ellipse, var(--color-glow) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* ── Gallery Carousel ──────────────────────── */
  .gallery-carousel {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-bottom: 0.5rem; /* Room for focus/hover rings */
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }

  .gallery-carousel::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    flex: 0 0 140px; /* Fixed width to allow 3-4 to be visible */
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    border-radius: 0.25rem;
    aspect-ratio: 1;
    background: var(--color-surface-container-lowest);
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-item:hover img,
  .gallery-item:focus-within img,
  .gallery-item:active img {
    transform: scale(1.06);
  }

  /* ── Testimonials Carousel ─────────────────── */
  .testimonials-carousel {
    position: relative;
    overflow: hidden;
    margin-top: 1.5rem;
    padding: 0 10%;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);

  }

  .carousel-slide {
    flex: 0 0 80%;
    padding: 0 0.5rem;
    box-sizing: border-box;
  }

  .testimonial-card {
    padding: 1.5rem;
    background: var(--color-surface-container-low);
    border-radius: 0.25rem;
    border: none;
    margin: 0;
  }

  .carousel-slide .testimonial-card {
    height: 100%;
    margin: 0;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background: var(--color-surface-container-low);
    border: 1px solid var(--color-outline);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-on-surface);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    padding: 0;
  }

  .carousel-btn:hover,
  .carousel-btn:focus-visible {
    background: var(--color-surface-container);
    border-color: var(--color-primary);
    outline: none;
  }

  .carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel-prev {
    left: 0;
  }

  .carousel-next {
    right: 0;
  }

  .testimonial-stars {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .testimonial-text {
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-on-surface);
    font-style: italic;
    margin-bottom: 1rem;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .testimonial-name {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-on-surface);
  }

  .testimonial-role {
    font-family: var(--font-family-body);
    font-size: 0.875rem;
    color: var(--color-outline);
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — TABLET (769px–1024px)
     ═══════════════════════════════════════════ */
  @media (min-width: 769px) and (max-width: 1024px) {
    .hero-section {
      padding: 3rem 1.5rem 3rem 2.5rem;
    }
    .hero-section-inner {
      max-width: 420px;
    }
    .hero-video {
      width: 90%;
      max-width: 400px;
    }
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — MOBILE COLLAPSE
     ═══════════════════════════════════════════ */
  @media (max-width: 768px) {
    .hero-sticky-wrapper {
      display: grid;
      grid-template-columns: 1fr;
    }

    .hero-video-col {
      grid-column: 1;
      grid-row: 1;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      opacity: 0.2;
      pointer-events: none;
    }

    .hero-video-wrapper {
      height: 100%;
      padding-top: 0;
    }

    .hero-video {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
    }

    .hero-text-col {
      grid-column: 1;
      grid-row: 1;
      position: relative;
      z-index: 2;
    }

    .hero-section {
      padding: max(6rem, 15vh) 1.5rem 3rem 1.5rem;
      justify-content: flex-start;
      align-items: center;
    }

    .section-heading {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    PX_PER_WU,
    DURGAP,
    HOLD,
    FDUR_RATIO,
    MS_PER_WU,
    WU_WORD,
    WU_BODY,
    WU_CTA,
    WU_CAROUSEL
  } from '../config/animation';

  gsap.registerPlugin(ScrollTrigger);

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function makeAllSectionsVisible() {
    document.querySelectorAll('.hero-section').forEach((el) => {
      (el as HTMLElement).style.visibility = 'visible';
      (el as HTMLElement).style.opacity = '1';
    });
    document.querySelectorAll('.word, .blur-in').forEach((el) => {
      (el as HTMLElement).style.opacity = '1';
      (el as HTMLElement).style.filter = 'none';
      (el as HTMLElement).style.transform = 'none';
    });
  }

  if (!motionQuery.matches) {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const heroContainer = document.getElementById('hero-scroll-container');
    const sections = gsap.utils.toArray('.hero-section') as HTMLElement[];

    if (heroContainer) {
      const initTimeline = () => {
        // ── Word-Based Scroll Unit System ──────────────────
        // Every element has a weight in WU (Word Units).
        // Duration = WU × PX_PER_WU (in timeline/scroll-px units).
        // Elements cascade: each starts at DURGAP × previous duration
        // after the previous element's start.
        // ScrollTrigger end is in pixels → viewport-independent.

        const HOLD_PX      = HOLD * PX_PER_WU;

        // ── Element data structure ─────────────────────────
        type AnimElement = {
          el: Element;
          wu: number;
          duration: number;
          start: number;
          type: 'word' | 'blur-in';
        };

        function getBlurInWeight(el: Element): number {
          if (el.classList.contains('gallery-carousel'))   return WU_CAROUSEL;
          if (el.classList.contains('testimonials-carousel')) return WU_CAROUSEL;
          if (el.classList.contains('section-cta-group'))  return WU_CTA;
          return WU_BODY;
        }

        function buildSectionElements(section: HTMLElement): AnimElement[] {
          const words   = Array.from(section.querySelectorAll('.word'));
          const blurIns = Array.from(section.querySelectorAll('.blur-in'));
          const elems: AnimElement[] = [];

          for (const w of words) {
            elems.push({ el: w, wu: WU_WORD, duration: 0, start: 0, type: 'word' });
          }
          for (const b of blurIns) {
            elems.push({ el: b, wu: getBlurInWeight(b), duration: 0, start: 0, type: 'blur-in' });
          }

          // Compute duration and cascading start times
          for (let j = 0; j < elems.length; j++) {
            elems[j].duration = elems[j].wu * PX_PER_WU;
            elems[j].start = j === 0
              ? 0
              : elems[j - 1].start + elems[j - 1].duration * DURGAP;
          }
          return elems;
        }

        // ── Compute per-section metrics ────────────────────
        const sectionData = sections.map((section, i) => {
          const elements  = buildSectionElements(section);
          const last      = elements[elements.length - 1];
          const introSpan = last.start + last.duration;
          // Section 0: outro only (time-based intro, no scroll intro/hold)
          const sw = (i === 0) ? introSpan : introSpan + HOLD_PX + introSpan;
          return { section, elements, introSpan, sw };
        });

        const sectionStarts: number[] = [];
        let cumulative = 0;
        for (const data of sectionData) {
          sectionStarts.push(cumulative);
          cumulative += data.sw;
        }
        const totalDuration = cumulative;

        // ════════════════════════════════════════════════════
        // PHASE 1 — Time-based intro for section 0 (page load)
        // Runs once, blocks scroll, then self-destructs.
        // The scroll timeline does NOT exist during this phase.
        // ════════════════════════════════════════════════════

        // Block scroll while the intro plays
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';

        const section0 = sections[0] as HTMLElement;
        section0.classList.add('is-active');
        const s0elements = sectionData[0].elements;

        // Set initial hidden state
        s0elements.forEach((elem) => {
          if (elem.type === 'word') {
            gsap.set(elem.el, {
              opacity: 0, filter: 'blur(16px) brightness(0.6)',
              y: 30, scale: 0.9, rotateX: -15
            });
          } else {
            gsap.set(elem.el, { opacity: 0, filter: 'blur(16px)', y: 30 });
          }
        });

        // Create time-based intro tweens (WU cascade with MS_PER_WU)
        const introTweens: gsap.core.Tween[] = [];
        s0elements.forEach((elem, idx) => {
          const delayS = (elem.start / PX_PER_WU) * MS_PER_WU / 1000;
          const durS   = (elem.wu * MS_PER_WU) / 1000;
          const fdurS  = durS * FDUR_RATIO;

          if (elem.type === 'word') {
            const blur  = 12 + Math.floor(Math.random() * 8);
            const scale = 0.9 + Math.sin(idx * 0.2) * 0.05;

            gsap.set(elem.el, { filter: `blur(${blur}px) brightness(0.6)`, scale });

            introTweens.push(gsap.to(elem.el, {
              opacity: 1, y: 0, scale: 1, rotateX: 0,
              duration: durS, ease: 'none', delay: delayS
            }));
            introTweens.push(gsap.to(elem.el, {
              filter: 'blur(0px) brightness(1)',
              duration: fdurS, ease: 'none', delay: delayS
            }));
          } else {
            introTweens.push(gsap.to(elem.el, {
              opacity: 1, y: 0,
              duration: durS, ease: 'none', delay: delayS
            }));
            introTweens.push(gsap.to(elem.el, {
              filter: 'blur(0px)',
              duration: fdurS, ease: 'none', delay: delayS
            }));
          }
        });

        // When the last element finishes: kill intro, wipe styles, build scroll timeline
        const lastS0 = s0elements[s0elements.length - 1];
        const introEndS =
          ((lastS0.start / PX_PER_WU) * MS_PER_WU / 1000) +
          ((lastS0.wu * MS_PER_WU) / 1000);

        gsap.delayedCall(introEndS, () => {
          // Kill every time-based tween
          introTweens.forEach(t => t.kill());
          introTweens.length = 0;

          // Clear ALL inline styles — elements revert to CSS defaults (visible)
          s0elements.forEach(elem => {
            gsap.set(elem.el, { clearProps: 'all' });
          });

          // Unblock scroll and ensure we're at the top
          window.scrollTo(0, 0);
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';

          // ════════════════════════════════════════════════════
          // PHASE 2 — Scroll-driven timeline (all sections)
          // Created AFTER the time-based intro is fully cleaned up.
          // Section 0 elements are in pristine CSS state (visible).
          // No fromTo/immediateRender hacks needed.
          // ════════════════════════════════════════════════════
          buildScrollTimeline();
        });

        function buildScrollTimeline() {
          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: heroContainer,
              start: 'top top',
              end: '+=' + totalDuration,
              pin: '.hero-sticky-wrapper',
              scrub: 1,
              onUpdate: (self) => {
                // Active section detection (variable-width lookup)
                const timelinePos = self.progress * totalDuration;
                let activeIndex = sections.length - 1;
                for (let k = 0; k < sectionData.length; k++) {
                  if (timelinePos < sectionStarts[k] + sectionData[k].sw) {
                    activeIndex = k;
                    break;
                  }
                }

                sections.forEach((sec, idx) => {
                  sec.classList.toggle('is-active', idx === activeIndex);
                });
              }
            }
          });

          // ── Set up animations per section ──────────────────
          sectionData.forEach((data, i) => {
            const { section, elements, introSpan } = data;
            const secStart = sectionStarts[i];

            // SECTION 0: No scroll intro — time-based intro already handled it.
            // Elements are in clean visible state (no inline styles).

            // SECTIONS 1+: Scroll-driven intro
            if (i > 0) {
              // Set initial hidden state
              elements.forEach((elem) => {
                if (elem.type === 'word') {
                  gsap.set(elem.el, {
                    opacity: 0, filter: 'blur(16px) brightness(0.6)',
                    y: 30, scale: 0.9, rotateX: -15
                  });
                } else {
                  gsap.set(elem.el, { opacity: 0, filter: 'blur(16px)', y: 30 });
                }
              });

              elements.forEach((elem, idx) => {
                const dur  = elem.duration;
                const fdur = dur * FDUR_RATIO;
                const pos  = secStart + elem.start;

                if (elem.type === 'word') {
                  const blur  = 12 + Math.floor(Math.random() * 8);
                  const scale = 0.9 + Math.sin(idx * 0.2) * 0.05;

                  tl.set(elem.el, { filter: `blur(${blur}px) brightness(0.6)`, scale }, secStart);

                  tl.to(elem.el, {
                    opacity: 1, y: 0, scale: 1, rotateX: 0,
                    duration: dur, ease: 'none'
                  }, pos);
                  tl.to(elem.el, {
                    filter: 'blur(0px) brightness(1)',
                    duration: fdur, ease: 'none'
                  }, pos);
                } else {
                  tl.to(elem.el, {
                    opacity: 1, y: 0,
                    duration: dur, ease: 'none'
                  }, pos);
                  tl.to(elem.el, {
                    filter: 'blur(0px)',
                    duration: fdur, ease: 'none'
                  }, pos);
                }
              });
            }

            // ALL SECTIONS EXCEPT LAST: Scroll-driven outro
            // Outro mirrors intro — same start offsets and durations
            if (i < sections.length - 1) {
              const outroStart = (i === 0) ? secStart : secStart + introSpan + HOLD_PX;

              elements.forEach((elem) => {
                const dur  = elem.duration;
                const fdur = dur * FDUR_RATIO;
                const pos  = outroStart + elem.start;

                // All sections use .to() — no special cases.
                // Section 0: elements are in clean CSS visible state,
                //   .to() records visible as "from" → animates to hidden. ✓
                // Sections 1+: intro tweens leave elements visible,
                //   .to() records visible as "from" → animates to hidden. ✓
                if (elem.type === 'word') {
                  if (i === 0) tl.set(elem.el, { filter: 'blur(0px) brightness(1)' }, pos);
                  tl.to(elem.el, {
                    opacity: 0, y: -30, scale: 1.1, rotateX: 15,
                    duration: dur, ease: 'none'
                  }, pos);
                  tl.to(elem.el, {
                    filter: 'blur(16px) brightness(0.6)',
                    duration: fdur, ease: 'none'
                  }, pos);
                } else {
                  if (i === 0) tl.set(elem.el, { filter: 'blur(0px)' }, pos);
                  tl.to(elem.el, {
                    opacity: 0, y: -30,
                    duration: dur, ease: 'none'
                  }, pos);
                  tl.to(elem.el, {
                    filter: 'blur(16px)',
                    duration: fdur, ease: 'none'
                  }, pos);
                }
              });
            }
          });

          // Force timeline duration to exactly match totalDuration
          tl.set({}, {}, totalDuration);
        }
      };

      if (video && video.readyState >= 1) {
        initTimeline();
      } else if (video) {
        video.addEventListener('loadedmetadata', initTimeline, { once: true });
      } else {
        initTimeline();
      }
    }
  } else {
    makeAllSectionsVisible();
  }

  motionQuery.addEventListener('change', (e) => {
    if (e.matches) {
      ScrollTrigger.getAll().forEach((t) => t.kill());
      makeAllSectionsVisible();
    }
  });

  /* ═══════════════════════════════════════════
     TESTIMONIALS CAROUSEL
     Auto-play every 10s, manual nav with arrows
     ═══════════════════════════════════════════ */
  function initTestimonialsCarousel() {
    const carousel = document.getElementById('testimonials-carousel');
    if (!carousel) return;

    const track = carousel.querySelector('.carousel-track') as HTMLElement | null;
    const slides = carousel.querySelectorAll('.carousel-slide');
    const prevBtn = document.getElementById('carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('carousel-next') as HTMLButtonElement | null;

    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    let autoPlayInterval: ReturnType<typeof setInterval> | null = null;
    const AUTO_PLAY_DELAY = 10000; // 10 seconds

    function updateCarousel(animate: boolean = true) {
      const slideWidth = 80; // 80% as set in CSS
      const offset = -(currentIndex * slideWidth);
      if (animate) {
        track.style.transition = 'transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
      } else {
        track.style.transition = 'none';
      }
      track.style.transform = `translateX(${offset}%)`;
    }

    function goToPrev() {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      updateCarousel();
      resetAutoPlay();
    }

    function goToNext() {
      currentIndex = (currentIndex + 1) % slides.length;
      updateCarousel();
      resetAutoPlay();
    }

    function startAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(goToNext, AUTO_PLAY_DELAY);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }

    function resetAutoPlay() {
      stopAutoPlay();
      startAutoPlay();
    }

    // Event listeners for buttons
    if (prevBtn) prevBtn.addEventListener('click', goToPrev);
    if (nextBtn) nextBtn.addEventListener('click', goToNext);

    // Pause on hover/focus
    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);
    carousel.addEventListener('focusin', stopAutoPlay);
    carousel.addEventListener('focusout', startAutoPlay);

    // Touch/swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          goToNext();
        } else {
          goToPrev();
        }
      }
    }, { passive: true });

    // Keyboard navigation
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goToPrev();
      if (e.key === 'ArrowRight') goToNext();
    });

    // Initialize
    updateCarousel(false);
    startAutoPlay();
  }

  initTestimonialsCarousel();
</script>

