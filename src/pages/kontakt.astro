---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt — Nulo Cake" description="Skontaktuj się z Nulo Cake. Zamów artystyczny tort na swoją wyjątkową okazję." isSubpage={true}>
  <main class="page-placeholder">
    <div class="placeholder-inner">
      <p class="label-md">Kontakt</p>
      <h1 class="display-lg">Wkrótce</h1>
      <p class="body-lg">Ta strona jest w przygotowaniu.</p>
      <a href="/" class="btn-secondary">Wróć na stronę główną</a>
    </div>
  </main>
</Layout>

<style>
  .page-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 2rem;
  }
  .placeholder-inner {
    text-align: left;
    max-width: 480px;
  }
  .placeholder-inner .label-md {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .placeholder-inner .display-lg {
    margin-bottom: 1rem;
  }
  .placeholder-inner .body-lg {
    margin-bottom: 2rem;
  }
</style>
