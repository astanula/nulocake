---
import Layout from '../layouts/Layout.astro';
import ContactChannels from '../components/contact/ContactChannels.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactMap from '../components/contact/ContactMap.astro';
import { CONTACT_DETAILS, CONTACT_LINKS } from '../config/contact';
---

<Layout title="Kontakt — Nulo Cake" description="Skontaktuj się z Nulo Cake. Zamów artystyczny tort na swoją wyjątkową okazję." isSubpage={true}>
  <main class="contact-page" data-contact-page>
    <div class="contact-column">
      <section class="contact-intro" aria-labelledby="contact-heading">
        <h1 id="contact-heading" class="display-lg section-title-lg contact-heading">
          Porozmawiajmy<br /><span class="accent-italic">o Twoim torcie.</span>
        </h1>
        <p class="body-lg">
          Nie musisz znać wszystkich szczegółów. Napisz, czego szukasz — chętnie doradzę.
        </p>
      </section>

      <section class="contact-channels-section" aria-labelledby="contact-channels-heading">
        <ContactChannels />
      </section>

      <section class="contact-details" aria-labelledby="contact-details-heading">
        <h2 class="label-md contact-details-heading" id="contact-details-heading">Dane kontaktowe</h2>
        <dl class="contact-facts">
          <div>
            <dt>
              <span class="sr-only">Telefon</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.91.69 2.81a2 2 0 0 1-.45 2.11L8.08 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.69A2 2 0 0 1 22 16.92Z" />
              </svg>
            </dt>
            <dd><a href={CONTACT_LINKS.phone}>{CONTACT_DETAILS.phone}</a></dd>
          </div>
          <div>
            <dt>
              <span class="sr-only">E-mail</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </dt>
            <dd><a href={CONTACT_LINKS.email}>{CONTACT_DETAILS.email}</a></dd>
          </div>
        </dl>
      </section>

      <section class="contact-map-section" aria-label="Lokalizacja">
        <ContactMap />
      </section>
    </div>

    <div class="contact-column">
      <section class="contact-form-section" aria-labelledby="contact-email-heading">
        <h2 class="label-md contact-email-heading" id="contact-email-heading">Wyślij wiadomość przez formularz</h2>
        <p class="contact-email-intro">Zostaw adres i napisz tyle, ile już wiesz.</p>
        <ContactForm />
      </section>
    </div>
  </main>
</Layout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.5rem clamp(2.5rem, 6vw, 6rem);
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--subpage-top-offset) clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 6vw, 6rem);
    flex-shrink: 0;
  }

  .contact-column {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .contact-intro {
    min-width: 0;
    max-width: 30rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .contact-heading {
    margin-bottom: 1.5rem;
  }

  .contact-channels-section,
  .contact-form-section {
    min-width: 0;
    max-width: 44rem;
  }

  .contact-details {
    min-width: 0;
  }

  .contact-details-heading {
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .contact-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .contact-facts > div {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    min-height: 44px;
  }

  .contact-facts dt {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .contact-facts svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-facts dd {
    min-width: 0;
    font-size: 1rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .contact-facts a {
    display: block;
    min-height: 44px;
    padding: 0.5rem 0;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .contact-facts a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .contact-email-heading {
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .contact-email-intro {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant);
  }

  .contact-map-section {
    min-width: 0;
  }

  @media (--below-laptop) {
    .contact-page {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
