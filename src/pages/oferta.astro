---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionDots from '../components/section-nav/SectionDots.astro';
import ScrollHintArrow from '../components/stack-fade/ScrollHintArrow.astro';
import CakeSizeGuide from '../components/offer/CakeSizeGuide.astro';
import FlavorSelector from '../components/offer/FlavorSelector.astro';
import { withBase } from '../utils/withBase';

const sectionLabels = ['Smaki', 'Dekoracje', 'Porcje i cennik', 'Jak zamówić', 'Dodatkowa oferta'];
---

<Layout title="Oferta — Nulo Cake" description="Poznaj ofertę artystycznych tortów na zamówienie. Składniki, dekoracje, cennik i sposób zamawiania.">
  <Navigation />

  <main id="hero-scroll-container" class="oferta-container" tabindex="-1">
    <SectionDots labels={sectionLabels} class="oferta-dots" />
    <ScrollHintArrow class="oferta-hint" />

    <!-- Sekcja 1: Co kryje się w środku? -->
    <section class="oferta-section is-active" aria-label={sectionLabels[0]} tabindex="-1">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">
          <span class="word">Co</span> <span class="word">kryje</span> <span class="word">się</span> <span class="section-heading-accent"><span class="word">w</span> <span class="word">środku<span class="section-heading-punct">?</span></span></span>
        </h2>
        <p class="body-lg section-body blur-in">W moich tortach nie znajdziesz gotowych mieszanek – używam tylko prawdziwego masła, belgijskiej czekolady i świeżych owoców.</p>
        <div class="oferta-block blur-in">
          <FlavorSelector />
        </div>
        <div class="section-cta-group blur-in">
          <a href={withBase('kontakt')} class="btn-primary">Mam pytanie o smaki</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 2: Jak dekoruję -->
    <section class="oferta-section" aria-label={sectionLabels[1]} tabindex="-1">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">
          <span class="word">Jak</span> <span class="word">dekoruję?</span>
        </h2>
        <p class="body-lg section-body blur-in">W moich projektach najczęściej wykorzystuję:</p>
        <ul class="decor-list blur-in">
          <li class="decor-item">
            <svg class="decor-check" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 12 6 6L21 6" />
            </svg>
            <span>Ręcznie rzeźbione figurki (Masa cukrowa)</span>
          </li>
          <li class="decor-item">
            <svg class="decor-check" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 12 6 6L21 6" />
            </svg>
            <span>Wydruki jadalne (Opłatek lub masa cukrowa)</span>
          </li>
          <li class="decor-item">
            <svg class="decor-check" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 12 6 6L21 6" />
            </svg>
            <span>Dekoracje z papieru waflowego</span>
          </li>
          <li class="decor-item">
            <svg class="decor-check" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 12 6 6L21 6" />
            </svg>
            <span>Dekoracje naturalne (Żywe kwiaty i owoce)</span>
          </li>
          <li class="decor-item">
            <svg class="decor-check" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 12 6 6L21 6" />
            </svg>
            <span>Słodycze i technika Drip Cake</span>
          </li>
          <li class="decor-item">
            <svg class="decor-check" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 12 6 6L21 6" />
            </svg>
            <span>Napisy i Toppery</span>
          </li>
        </ul>
        <p class="body-lg section-body blur-in">Każdy tort wyceniam indywidualnie, ponieważ stopień skomplikowania dekoracji (np. ręczne lepienie figurek) wpływa na czas mojej pracy i ostateczny koszt.</p>
        <div class="section-cta-group blur-in">
          <a href={withBase('kontakt')} class="btn-primary">Mam pytanie o dekoracje</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 3: Przewodnik po porcjach i cennik -->
    <section class="oferta-section" aria-label={sectionLabels[2]} tabindex="-1">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">
          <span class="word">Przewodnik</span> <span class="word">po</span> <span class="word">porcjach</span> <span class="word">i</span> <span class="word">cennik</span>
        </h2>
        <div class="portion-pricing blur-in">
          <p class="portion-price">
            <strong>20 <span class="portion-price-currency">zł</span></strong>
            <span class="portion-price-label">za porcję</span>
          </p>
          <p class="body-lg portion-price-note">Ostateczna cena tortu zależy od liczby porcji oraz stopnia skomplikowania dekoracji.</p>
        </div>
        <div class="oferta-block blur-in">
          <CakeSizeGuide />
        </div>
        <div class="section-cta-group blur-in">
          <a href={withBase('kontakt')} class="btn-primary">Zapytaj o rozmiar i cenę</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 4: Jak zamówić wymarzony tort? -->
    <section class="oferta-section" aria-label={sectionLabels[3]} tabindex="-1">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">
          <span class="word section-heading-accent">Jak</span> <span class="word section-heading-accent">zamówić</span> <span class="word">wymarzony</span> <span class="word">tort?</span>
        </h2>
        <ol class="steps-list blur-in">
          <li>
            <h3 class="body-lg section-body">Podaj szczegóły (Zapytanie)</h3>
            <ul class="section-body body-lg">
              <li><strong>Datę uroczystości</strong> (sprawdzę dostępność terminu)</li>
              <li><strong>Liczbę gości</strong> (dobierzemy odpowiednią wielkość/liczbę pięter)</li>
              <li><strong>Okazję oraz motyw przewodni</strong> (np. „urodziny w stylu leśnym”, „wesele boho”)</li>
            </ul>
          </li>
          <li>
            <h3 class="body-lg section-body">Ustalimy smaki i design</h3>
          </li>
          <li>
            <h3 class="body-lg section-body">Zamów i zarezerwuj termin</h3>
          </li>
        </ol>
        <div class="section-cta-group blur-in">
          <a href={withBase('kontakt')} class="btn-primary">Zamów lub zadaj pytanie</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 5: Coś więcej niż torty? -->
    <section class="oferta-section oferta-section--last" aria-label={sectionLabels[4]} tabindex="-1">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">
          <span class="word">Coś</span> <span class="word">więcej</span> <span class="word">niż</span> <span class="word">torty?</span>
        </h2>
        <p class="body-lg section-body blur-in">Opis co oprócz tortów jest w ofercie</p>
        <ul class="section-body body-lg blur-in">
          <li>Babeczki</li>
          <li>Zestawy prezentowe: Bento cake + babeczki</li>
          <li>Zapytaj jeśli potrzebujesz czegoś innego.</li>
        </ul>
        <div class="section-cta-group blur-in">
          <a href={withBase('kontakt')} class="btn-primary">Zapytaj o dodatkową ofertę</a>
        </div>
      </div>
    </section>

    <div class="home-footer-dock" inert>
      <Footer />
    </div>
  </main>
</Layout>

<style>
  :global(html.home-snap-active) {
    scrollbar-gutter: stable;
    overscroll-behavior-y: none;
  }

  .oferta-container {
    position: relative;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    width: 100%;
    outline: none;
    --home-footer-h: 0px;
  }

  .oferta-container .oferta-dots {
    position: fixed;
    left: calc(
      var(--section-dots-offset) + var(--section-dot-mark-size) * (var(--section-dot-active-scale) - 1) / 2
    );
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
  }

  .oferta-container .oferta-hint {
    position: fixed;
    left: 50%;
    bottom: calc(var(--scroll-hint-bottom) + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 5;
  }

  .oferta-section {
    position: relative;
    min-height: 100dvh;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: calc(4.5rem + var(--subpage-top-offset)) 2rem 4.5rem 4rem;
    outline: none;
  }

  .oferta-section--last {
    padding-bottom: calc(4.5rem + var(--home-footer-h));
  }

  @media (prefers-reduced-motion: no-preference) {
    .oferta-section:not(.is-active) {
      display: none;
    }

    .oferta-section.is-active {
      display: flex;
      overflow: clip;
    }

    .home-footer-dock {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oferta-section {
      display: flex;
      visibility: visible;
      pointer-events: auto;
    }

    .oferta-container .oferta-dots,
    .oferta-container .oferta-hint {
      display: none;
    }
  }

  .content-section-inner {
    max-width: none;
    min-width: 0;
    width: 100%;
  }

  .oferta-block {
    min-width: 0;
    width: 100%;
  }

  .word {
    display: inline-block;
    will-change: filter, transform, opacity;
    transform-style: preserve-3d;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading-accent {
    color: var(--color-primary);
  }

  .section-heading-punct {
    color: var(--color-on-surface);
  }

  .section-body {
    margin-bottom: 1rem;
  }

  .section-body:last-of-type {
    margin-bottom: 2rem;
  }

  .section-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .portion-pricing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
    margin-bottom: 2rem;
  }

  .portion-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.875rem;
  }

  .portion-price strong {
    color: var(--color-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.715rem, 2.94vw, 2.45rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .portion-price-currency {
    font-size: 0.45em;
    letter-spacing: -0.02em;
  }

  .portion-price-label {
    color: var(--color-on-surface-variant);
    font-size: 1rem;
  }

  .portion-price-note {
    max-width: 38ch;
  }

  .section-body ul, .section-body ol:not(.steps-list) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .section-body li {
    margin-bottom: 0.5rem;
  }

  .steps-list {
    counter-reset: step;
    list-style: none;
    padding-left: 0;
    margin: 1.5rem 0 2rem 0;
  }

  .steps-list > li {
    counter-increment: step;
    margin-bottom: 1.5rem;
    padding-left: calc(var(--type-body-lg-size) + 0.5rem);
    position: relative;
  }

  .steps-list > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: calc(var(--type-body-lg-size) * 0.35);
    width: var(--type-body-lg-size);
    height: var(--type-body-lg-size);
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1;
  }

  .steps-list ul {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .steps-list h3 {
    margin-bottom: 0.5rem;
  }

  .decor-list {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0 2rem 0;
  }

  .decor-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 1.125rem;
    color: var(--color-text-primary);
  }

  .decor-check {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (--tablet-only) {
    .oferta-section {
      padding: calc(4.5rem + var(--subpage-top-offset)) 1.5rem 3.5rem 3.5rem;
    }

    .oferta-section--last {
      padding-bottom: calc(3.5rem + var(--home-footer-h));
    }
  }

  @media (--below-tablet) {
    .oferta-section {
      padding: calc(4.5rem + var(--subpage-top-offset)) 1.5rem 3.5rem 2.25rem;
      justify-content: flex-start;
      align-items: center;
    }

    .oferta-section--last {
      padding-bottom: calc(3.5rem + var(--home-footer-h));
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { computeSectionData, buildSectionTimeline } from '../home/sectionTimeline';
  import { mountSnapNavigator } from '../home/snapNavigator';

  declare global {
    interface Window {
      ofertaPageLoadListenerAdded?: boolean;
      ofertaPageBeforeSwapListenerAdded?: boolean;
      ofertaMotionQueryListenerAdded?: boolean;
    }
  }

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  let teardownSnap: (() => void) | null = null;

  const isOfertaPage = () => document.querySelector('.oferta-section') !== null;

  function showStaticOferta() {
    document.querySelector('.home-footer-dock')?.removeAttribute('inert');
    document.querySelectorAll<HTMLElement>('.oferta-section').forEach((sec) => {
      gsap.set(sec, { clearProps: 'all' });
    });
    document.querySelectorAll<HTMLElement>('.oferta-section .word, .oferta-section .blur-in').forEach((el) => {
      gsap.set(el, { clearProps: 'all' });
    });
  }

  function stopOfertaAnimation() {
    teardownSnap?.();
    teardownSnap = null;
  }

  function initOfertaPage() {
    const root = document.getElementById('hero-scroll-container');
    const sections = gsap.utils.toArray<HTMLElement>('.oferta-section');

    if (!root || sections.length === 0) return;

    stopOfertaAnimation();

    if (motionQuery.matches) {
      showStaticOferta();
      return;
    }

    sections.forEach((sec, i) => sec.classList.toggle('is-active', i === 0));
    const layout = computeSectionData(sections);
    layout.sectionData[0].elements.forEach((elem) => {
      gsap.set(elem.el, { clearProps: 'all' });
    });

    teardownSnap = mountSnapNavigator(root, buildSectionTimeline(layout));
  }

  if (!window.ofertaPageLoadListenerAdded) {
    document.addEventListener('astro:page-load', initOfertaPage);
    window.ofertaPageLoadListenerAdded = true;
  }

  if (!window.ofertaPageBeforeSwapListenerAdded) {
    document.addEventListener('astro:before-swap', () => {
      if (!isOfertaPage()) return;
      stopOfertaAnimation();
    });
    window.ofertaPageBeforeSwapListenerAdded = true;
  }

  if (!window.ofertaMotionQueryListenerAdded) {
    motionQuery.addEventListener('change', (e) => {
      if (!isOfertaPage()) return;
      if (e.matches) {
        stopOfertaAnimation();
        showStaticOferta();
      } else {
        initOfertaPage();
      }
    });
    window.ofertaMotionQueryListenerAdded = true;
  }
</script>
