---
import Layout from '../layouts/Layout.astro';
import CakeSizeGuide from '../components/offer/CakeSizeGuide.astro';
import FlavorSelector from '../components/offer/FlavorSelector.astro';
import { withBase } from '../utils/withBase';
---

<Layout title="Oferta — Nulo Cake" description="Poznaj ofertę artystycznych tortów na zamówienie. Składniki, dekoracje, cennik i sposób zamawiania." isSubpage={true}>
  <main class="oferta-container">
    <!-- Sekcja 1: Co kryje się w środku? -->
    <section class="content-section">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">Co kryje się <span class="section-heading-accent">w środku</span>?</h2>
        <p class="body-lg section-body">W moich tortach nie znajdziesz gotowych mieszanek – używam tylko prawdziwego masła, belgijskiej czekolady i świeżych owoców.</p>
        <FlavorSelector />
        <div class="section-cta-group">
          <a href={withBase('kontakt')} class="btn-primary">Mam pytanie o smaki</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 2: Jak dekoruję -->
    <section class="content-section">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">Jak dekoruję?</h2>
        <p class="body-lg section-body">W moich projektach najczęściej wykorzystuję:</p>
        <ul class="decor-list">
          <li class="decor-item">
            <span class="checkbox"></span>
            <span>Ręcznie rzeźbione figurki (Masa cukrowa)</span>
          </li>
          <li class="decor-item">
            <span class="checkbox"></span>
            <span>Wydruki jadalne (Opłatek lub masa cukrowa)</span>
          </li>
          <li class="decor-item">
            <span class="checkbox"></span>
            <span>Dekoracje z papieru waflowego</span>
          </li>
          <li class="decor-item">
            <span class="checkbox"></span>
            <span>Dekoracje naturalne (Żywe kwiaty i owoce)</span>
          </li>
          <li class="decor-item">
            <span class="checkbox"></span>
            <span>Słodycze i technika Drip Cake</span>
          </li>
          <li class="decor-item">
            <span class="checkbox"></span>
            <span>Napisy i Toppery</span>
          </li>
        </ul>
        <p class="body-lg section-body">Każdy tort wyceniam indywidualnie, ponieważ stopień skomplikowania dekoracji (np. ręczne lepienie figurek) wpływa na czas mojej pracy i ostateczny koszt.</p>
        <div class="section-cta-group">
          <a href={withBase('kontakt')} class="btn-primary">Mam pytanie o dekoracje</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 3: Przewodnik po porcjach i cennik -->
    <section class="content-section">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">Przewodnik po porcjach i cennik</h2>
        <div class="portion-pricing">
          <p class="portion-price">
            <strong>22 <span class="portion-price-currency">zł</span></strong>
            <span class="portion-price-label">za porcję</span>
          </p>
          <p class="body-lg portion-price-note">Ostateczna cena tortu zależy od liczby porcji oraz stopnia skomplikowania dekoracji.</p>
        </div>
        <CakeSizeGuide />
        <div class="section-cta-group">
          <a href={withBase('kontakt')} class="btn-primary">Zapytaj o rozmiar i cenę</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 4: Jak zamówić wymarzony tort? -->
    <section class="content-section">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">Jak zamówić wymarzony tort? (4 proste kroki)</h2>
        <ol class="steps-list">
          <li>
            <h3 class="body-lg section-body">Podaj szczegóły (Zapytanie)</h3>
            <ul class="section-body body-lg">
              <li><strong>Datę uroczystości</strong> (sprawdzę dostępność terminu)</li>
              <li><strong>Liczbę gości</strong> (dobierzemy odpowiednią wielkość/liczbę pięter)</li>
              <li><strong>Okazję oraz motyw przewodni</strong> (np. „urodziny w stylu leśnym”, „wesele boho”)</li>
            </ul>
          </li>
          <li>
            <h3 class="body-lg section-body">Ustalimy smaki i design</h3>
          </li>
          <li>
            <h3 class="body-lg section-body">Zamów i zarezerwuj termin</h3>
          </li>
          <li>
            <h3 class="body-lg section-body">Odbiór i dostawa (podać gdzie)</h3>
          </li>
        </ol>
        <div class="section-cta-group">
          <a href={withBase('kontakt')} class="btn-primary">Zamów lub zadaj pytanie</a>
        </div>
      </div>
    </section>

    <!-- Sekcja 5: Coś więcej niż torty? -->
    <section class="content-section">
      <div class="content-section-inner">
        <h2 class="display-lg section-title-lg section-heading">Coś więcej niż torty?</h2>
        <p class="body-lg section-body">Opis co oprócz tortów jest w ofercie</p>
        <ul class="section-body body-lg">
          <li>Babeczki</li>
          <li>Zestawy prezentowe: Bento cake + babeczki</li>
          <li>Zapytaj jeśli potrzebujesz czegoś innego.</li>
        </ul>
        <div class="section-cta-group">
          <a href={withBase('kontakt')} class="btn-primary">Zapytaj o dodatkową ofertę</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .oferta-container {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .content-section {
    position: relative;
    visibility: visible;
    pointer-events: auto;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 4rem 2rem 4rem 4rem;
  }

  .content-section-inner {
    max-width: none;
    width: 100%;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading-accent {
    color: var(--color-primary);
  }

  .section-body {
    margin-bottom: 1rem;
  }

  .section-body:last-of-type {
    margin-bottom: 2rem;
  }

  .section-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .portion-pricing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
    margin-bottom: 2rem;
  }

  .portion-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.875rem;
  }

  .portion-price strong {
    color: var(--color-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.715rem, 2.94vw, 2.45rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .portion-price-currency {
    font-size: 0.45em;
    letter-spacing: -0.02em;
  }

  .portion-price-label {
    color: var(--color-on-surface-variant);
    font-size: 1rem;
  }

  .portion-price-note {
    max-width: 38ch;
  }

  .section-body ul, .section-body ol:not(.steps-list) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .section-body li {
    margin-bottom: 0.5rem;
  }

  .steps-list {
    counter-reset: step;
    list-style: none;
    padding-left: 0;
    margin: 1.5rem 0 2rem 0;
  }

  .steps-list li {
    counter-increment: step;
    margin-bottom: 1.5rem;
    padding-left: 3rem;
    position: relative;
  }

  .steps-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 2rem;
    height: 2rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .steps-list h3 {
    margin-bottom: 0.5rem;
  }

  .decor-list {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0 2rem 0;
  }

  .decor-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 1.125rem;
    color: var(--color-text-primary);
  }

  .checkbox {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .checkbox::after {
    content: '';
    display: block;
    width: 0.625rem;
    height: 0.375rem;
    border-left: 2px solid var(--color-on-primary);
    border-bottom: 2px solid var(--color-on-primary);
    transform: rotate(-45deg);
    margin-top: -2px;
  }

  @media (max-width: 768px) {
    .content-section {
      padding: 2rem 1.5rem 3rem 1.5rem;
      justify-content: flex-start;
      align-items: center;
    }

    .steps-list li {
      padding-left: 2.5rem;
    }
  }
</style>
