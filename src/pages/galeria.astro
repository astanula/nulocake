---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { COLUMN_SPEEDS, IMAGE_GAP, IMAGE_BORDER_RADIUS, GALLERY_PADDING_DESKTOP, GALLERY_PADDING_MOBILE } from '../config/gallery';

// ── Fetch all gallery images at build time ──────────────
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

// ── Parse filenames and sort by column-row ──────────────
type GalleryImage = {
  src: ImageMetadata;
  column: number;
  row: number;
};

const allImages: GalleryImage[] = Object.entries(imageModules)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.[^.]+$/, '');
    const [colStr, rowStr] = filename.split('-');
    return {
      src: mod.default,
      column: parseInt(colStr, 10),
      row: parseInt(rowStr, 10),
    };
  })
  .sort((a, b) => a.column - b.column || a.row - b.row);

// ── Distribute images into 4 columns (round-robin by original column) ──
const columns: GalleryImage[][] = [[], [], [], []];
allImages.forEach((img, i) => {
  columns[i % 4].push(img);
});
---

<Layout title="Galeria — Nulo Cake" description="Galeria artystycznych tortów na zamówienie. Torty weselne, urodzinowe i okolicznościowe.">
  <Navigation />
  <main class="gallery-page" id="gallery-page">
    <div class="gallery-container" id="gallery-container" style={`gap: ${IMAGE_GAP}; --gallery-image-radius: ${IMAGE_BORDER_RADIUS}; --gallery-padding-desktop: ${GALLERY_PADDING_DESKTOP}; --gallery-padding-mobile: ${GALLERY_PADDING_MOBILE};`}>
      {columns.map((colImages, colIndex) => (
        <div
          class="gallery-column"
          data-col-index={colIndex}
          data-col-direction={colIndex % 2 === 0 ? 'up' : 'down'}
          data-col-speed={COLUMN_SPEEDS[colIndex]}
        >
          <div class="gallery-column-inner">
            {/* Original set */}
            <div class="gallery-set-original" style={`gap: ${IMAGE_GAP}; padding-bottom: ${IMAGE_GAP};`}>
              {colImages.map((img, imgIndex) => (
                <div class="gallery-image-wrapper" data-original-index={imgIndex * 4 + colIndex}>
                  <Image
                    src={img.src}
                    alt={`Tort ${colIndex + 1}-${imgIndex + 1}`}
                    widths={[300, 500]}
                    sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                    loading="lazy"
                    class="gallery-image"
                  />
                </div>
              ))}
            </div>
            {/* Duplicated set for seamless loop */}
            <div class="gallery-set-duplicate" aria-hidden="true" style={`gap: ${IMAGE_GAP}; padding-bottom: ${IMAGE_GAP};`}>
              {colImages.map((img) => (
                <div class="gallery-image-wrapper" aria-hidden="true">
                  <Image
                    src={img.src}
                    alt=""
                    widths={[300, 500]}
                    sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                    loading="lazy"
                    class="gallery-image"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .gallery-page {
    width: 100%;
    min-height: 100dvh;
    position: relative;
    padding-top: max(7rem, 18vh);
    padding-bottom: 4rem;
  }

  .gallery-container {
    display: flex;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gallery-padding-desktop, 4rem);
  }

  .gallery-column {
    flex: 1;
    overflow: hidden;
    position: relative;
    min-width: 0;
  }

  /* Columns hidden on smaller viewports get display:none via JS class */
  .gallery-column.is-hidden {
    display: none;
  }

  .gallery-column-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    will-change: transform;
  }

  .gallery-set-original,
  .gallery-set-duplicate {
    display: flex;
    flex-direction: column;
  }

  .gallery-image-wrapper {
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--gallery-image-radius, 0px);
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: inherit;
  }

  @media (max-width: 768px) {
    .gallery-page {
      padding-top: max(6rem, 15vh);
      padding-bottom: 3rem;
    }

    .gallery-container {
      padding: 0 var(--gallery-padding-mobile, 1.5rem);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import {
    BREAKPOINTS,
    HOVER_TRANSITION_DURATION,
  } from '../config/gallery';

  let activeTweens: gsap.core.Tween[] = [];
  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  let imageLoadTimer: ReturnType<typeof setTimeout> | null = null;
  let cleanupController: AbortController | null = null;

  /**
   * Determine how many columns should be visible based on viewport width.
   */
  function getColumnCount(): number {
    const w = window.innerWidth;
    if (w >= BREAKPOINTS.desktop) return 4;
    if (w >= BREAKPOINTS.tablet) return 3;
    return 2;
  }

  /**
   * Redistribute images into currently visible columns.
   * Moves actual DOM nodes so Astro's optimized <img> elements are preserved.
   */
  function redistributeColumns(
    allColumns: HTMLElement[],
    visibleCount: number,
    allImageWrappers: HTMLElement[]
  ): void {
    // Clear all original and duplicate sets first
    allColumns.forEach((col) => {
      const orig = col.querySelector('.gallery-set-original');
      if (orig) orig.innerHTML = '';
      const dupe = col.querySelector('.gallery-set-duplicate');
      if (dupe) dupe.innerHTML = '';
    });

    // Round-robin distribute original image wrappers to currently visible columns
    const visibleOriginals = allColumns
      .slice(0, visibleCount)
      .map((col) => col.querySelector('.gallery-set-original')!);

    allImageWrappers.forEach((wrapper, i) => {
      const targetOriginal = visibleOriginals[i % visibleCount];
      if (targetOriginal) {
        targetOriginal.appendChild(wrapper);
      }
    });

    // Rebuild the duplicate set in each visible column
    allColumns.slice(0, visibleCount).forEach((col) => {
      const orig = col.querySelector('.gallery-set-original') as HTMLElement;
      const dupe = col.querySelector('.gallery-set-duplicate') as HTMLElement;
      if (!orig || !dupe) return;

      // Clone the current original images as new duplicates
      const originals = Array.from(orig.querySelectorAll('.gallery-image-wrapper'));
      originals.forEach((origWrapper) => {
        const clone = origWrapper.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        // Clear alt on cloned images
        const img = clone.querySelector('img');
        if (img) img.alt = '';
        dupe.appendChild(clone);
      });
    });

    // Toggle visibility
    allColumns.forEach((col, i) => {
      col.classList.toggle('is-hidden', i >= visibleCount);
    });
  }

  /**
   * Update columns' style height based on their original set height.
   */
  function updateColumnHeights(allColumns: HTMLElement[]): void {
    allColumns.forEach((col) => {
      if (col.classList.contains('is-hidden')) {
        col.style.height = '';
        return;
      }
      const originalSet = col.querySelector('.gallery-set-original') as HTMLElement;
      if (originalSet) {
        col.style.height = `${originalSet.offsetHeight}px`;
      }
    });
  }

  /**
   * Create GSAP infinite loop tweens for each visible column.
   */
  function createLoopTweens(allColumns: HTMLElement[]): void {
    // Kill any existing tweens
    activeTweens.forEach((t) => t.kill());
    activeTweens = [];

    allColumns.forEach((col) => {
      if (col.classList.contains('is-hidden')) return;

      const inner = col.querySelector('.gallery-column-inner') as HTMLElement;
      if (!inner) return;

      const direction = col.dataset.colDirection;
      const speed = parseFloat(col.dataset.colSpeed || '30');

      if (direction === 'up') {
        // Scroll up: translate from 0% to -50%
        const tween = gsap.to(inner, {
          yPercent: -50,
          duration: speed,
          ease: 'none',
          repeat: -1,
        });
        activeTweens.push(tween);
      } else {
        // Scroll down: translate from -50% to 0%
        const tween = gsap.fromTo(
          inner,
          { yPercent: -50 },
          {
            yPercent: 0,
            duration: speed,
            ease: 'none',
            repeat: -1,
          }
        );
        activeTweens.push(tween);
      }
    });
  }

  /**
   * Attach hover listeners for smooth pause/resume.
   * Uses the AbortController signal so listeners are auto-removed on cleanup.
   */
  function attachHoverListeners(
    container: HTMLElement,
    signal: AbortSignal
  ): void {
    container.addEventListener('mouseenter', () => {
      activeTweens.forEach((tween) => {
        gsap.to(tween, {
          timeScale: 0,
          duration: HOVER_TRANSITION_DURATION,
          ease: 'power2.out',
        });
      });
    }, { signal });

    container.addEventListener('mouseleave', () => {
      activeTweens.forEach((tween) => {
        gsap.to(tween, {
          timeScale: 1,
          duration: HOVER_TRANSITION_DURATION,
          ease: 'power2.in',
        });
      });
    }, { signal });
  }

  /**
   * Clean up all gallery resources (tweens, timers, event listeners).
   */
  function cleanupGallery(): void {
    // Kill all loop tweens
    activeTweens.forEach((t) => t.kill());
    activeTweens = [];

    // Clear debounce timers
    if (resizeTimer) {
      clearTimeout(resizeTimer);
      resizeTimer = null;
    }
    if (imageLoadTimer) {
      clearTimeout(imageLoadTimer);
      imageLoadTimer = null;
    }

    // Abort all event listeners (resize + hover)
    if (cleanupController) {
      cleanupController.abort();
      cleanupController = null;
    }
  }

  /**
   * Main initialization — called on every page load.
   */
  function initGallery(): void {
    const container = document.getElementById('gallery-container');
    if (!container) return;

    const allColumns = Array.from(
      container.querySelectorAll('.gallery-column')
    ) as HTMLElement[];
    if (allColumns.length === 0) return;

    // Reduced motion: show static grid, no animation
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (motionQuery.matches) return;

    // Clean up any previous instance (e.g., from a prior page-load)
    cleanupGallery();

    // Create a new AbortController for this gallery instance
    cleanupController = new AbortController();
    const { signal } = cleanupController;

    // Collect and sort all original image wrappers before redistributing
    const allImageWrappers = allColumns.flatMap((col) =>
      Array.from(col.querySelectorAll('.gallery-set-original > .gallery-image-wrapper'))
    ) as HTMLElement[];

    allImageWrappers.sort((a, b) => {
      const idxA = parseInt(a.dataset.originalIndex || '0', 10);
      const idxB = parseInt(b.dataset.originalIndex || '0', 10);
      return idxA - idxB;
    });

    const visibleCount = getColumnCount();
    redistributeColumns(allColumns, visibleCount, allImageWrappers);
    updateColumnHeights(allColumns);
    createLoopTweens(allColumns);
    attachHoverListeners(container, signal);

    // Watch for image loads to recompute heights as they stream in
    const images = container.querySelectorAll('.gallery-set-original img') as NodeListOf<HTMLImageElement>;
    
    function triggerHeightRecalc() {
      if (imageLoadTimer) clearTimeout(imageLoadTimer);
      imageLoadTimer = setTimeout(() => {
        updateColumnHeights(allColumns);
        createLoopTweens(allColumns);
      }, 50);
    }

    images.forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', triggerHeightRecalc, { signal, once: true });
        img.addEventListener('error', triggerHeightRecalc, { signal, once: true });
      }
    });

    // Handle resize — uses signal so it's auto-removed on cleanup
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const newCount = getColumnCount();
        // Kill old tweens
        activeTweens.forEach((t) => t.kill());
        activeTweens = [];
        // Reset column transforms & height styles
        allColumns.forEach((col) => {
          col.style.height = '';
          const inner = col.querySelector('.gallery-column-inner') as HTMLElement;
          if (inner) gsap.set(inner, { clearProps: 'all' });
        });
        redistributeColumns(allColumns, newCount, allImageWrappers);
        updateColumnHeights(allColumns);
        createLoopTweens(allColumns);
      }, 200);
    }, { signal });
  }

  // ── Astro lifecycle ───────────────────────────────
  if (!(window as any).__galleryListenerAdded) {
    document.addEventListener('astro:page-load', initGallery);
    (window as any).__galleryListenerAdded = true;
  }

  // Clean up on navigation away
  if (!(window as any).__galleryBeforeSwapAdded) {
    document.addEventListener('astro:before-swap', () => {
      const container = document.getElementById('gallery-container');
      if (!container) return;
      cleanupGallery();
    });
    (window as any).__galleryBeforeSwapAdded = true;
  }
</script>
