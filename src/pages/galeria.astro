---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import { COLUMN_SPEEDS, IMAGE_GAP, IMAGE_BORDER_RADIUS, GALLERY_PADDING_DESKTOP, GALLERY_PADDING_MOBILE, GALLERY_FADE_HEIGHT, GALLERY_FADE_MIDPOINT_RATIO, FLOAT_HOVER_DELAY_MS, FLOAT_SCALE_AMOUNT, FLOAT_ZOOM_AMOUNT, FLOAT_ANIMATION_DURATION, FLOAT_EASE } from '../config/gallery';

// ── Fetch all gallery images at build time ──────────────
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

// ── Parse filenames and sort by column-row ──────────────
type GalleryImage = {
  src: ImageMetadata;
  column: number;
  row: number;
};

const allImages: GalleryImage[] = Object.entries(imageModules)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.[^.]+$/, '');
    const [colStr, rowStr] = filename.split('-');
    return {
      src: mod.default,
      column: parseInt(colStr, 10),
      row: parseInt(rowStr, 10),
    };
  })
  .sort((a, b) => a.column - b.column || a.row - b.row);

// ── Distribute images into 4 columns (round-robin by original column) ──
const columns: GalleryImage[][] = [[], [], [], []];
allImages.forEach((img, i) => {
  columns[i % 4].push(img);
});
---

<Layout title="Galeria — Nulo Cake" description="Galeria artystycznych tortów na zamówienie. Torty weselne, urodzinowe i okolicznościowe." isSubpage={true}>
  <main class="gallery-page" id="gallery-page">
    <div class="gallery-container" id="gallery-container" style={`gap: ${IMAGE_GAP}; --gallery-image-radius: ${IMAGE_BORDER_RADIUS}; --gallery-padding-desktop: ${GALLERY_PADDING_DESKTOP}; --gallery-padding-mobile: ${GALLERY_PADDING_MOBILE}; --gallery-fade-height: ${GALLERY_FADE_HEIGHT}; --gallery-fade-midpoint-ratio: ${GALLERY_FADE_MIDPOINT_RATIO};`}>
      {columns.map((colImages, colIndex) => (
        <div
          class="gallery-column"
          data-col-index={colIndex}
          data-col-direction={colIndex % 2 === 0 ? 'up' : 'down'}
          data-col-speed={COLUMN_SPEEDS[colIndex]}
        >
          <div class="gallery-column-inner">
            {/* Original set */}
            <div class="gallery-set-original" style={`gap: ${IMAGE_GAP}; padding-bottom: ${IMAGE_GAP};`}>
              {colImages.map((img, imgIndex) => (
                <div class="gallery-image-wrapper" data-original-index={imgIndex * 4 + colIndex}>
                  <Image
                    src={img.src}
                    alt={`Tort ${colIndex + 1}-${imgIndex + 1}`}
                    widths={[300, 500]}
                    sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                    loading="lazy"
                    class="gallery-image"
                  />
                </div>
              ))}
            </div>
            {/* Duplicated set for seamless loop */}
            <div class="gallery-set-duplicate" aria-hidden="true" style={`gap: ${IMAGE_GAP}; padding-bottom: ${IMAGE_GAP};`}>
              {colImages.map((img) => (
                <div class="gallery-image-wrapper" aria-hidden="true">
                  <Image
                    src={img.src}
                    alt=""
                    widths={[300, 500]}
                    sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                    loading="lazy"
                    class="gallery-image"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .gallery-page {
    width: 100%;
    position: relative;
    padding-top: var(--gallery-top-gap, 2.5rem);
    padding-bottom: 4rem;
  }

  .gallery-container {
    display: flex;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    --gallery-current-padding: var(--gallery-padding-desktop, 4rem);
    padding: 0 var(--gallery-current-padding);
    position: relative;
    overflow: clip;

    /* Hardware-accelerated non-linear transparency fade mask at bottom only */
    mask-image: linear-gradient(
      to bottom,
      black 0px,
      black calc(100% - var(--gallery-fade-height)),
      calc(100% - var(--gallery-fade-height) * var(--gallery-fade-midpoint-ratio)),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0px,
      black calc(100% - var(--gallery-fade-height)),
      calc(100% - var(--gallery-fade-height) * var(--gallery-fade-midpoint-ratio)),
      transparent 100%
    );
  }

  :global(body.gallery-page-active) :global(.scroll-container) {
    --gallery-top-gap: 2.5rem;
    --gallery-fade-height: 60px;
    --gallery-fade-midpoint-ratio: 0.3;
    /* Hardware-accelerated non-linear transparency fade mask at top only, offset by the gap */
    mask-image: linear-gradient(
      to bottom,
      transparent 0px,
      transparent var(--gallery-top-gap),
      calc(var(--gallery-top-gap) + var(--gallery-fade-height) * var(--gallery-fade-midpoint-ratio)),
      black calc(var(--gallery-top-gap) + var(--gallery-fade-height)),
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0px,
      transparent var(--gallery-top-gap),
      calc(var(--gallery-top-gap) + var(--gallery-fade-height) * var(--gallery-fade-midpoint-ratio)),
      black calc(var(--gallery-top-gap) + var(--gallery-fade-height)),
      black 100%
    );
  }

  .gallery-column {
    flex:1;
    overflow: visible;
    position: relative;
    min-width: 0;
  }

  /* Columns hidden on smaller viewports get display:none via JS class */
  .gallery-column.is-hidden {
    display: none;
  }

  .gallery-column.is-elevated {
    z-index: 5;
  }

  /* Columns hidden on smaller viewports get display:none via JS class */
  .gallery-column.is-hidden {
    display: none;
  }

  .gallery-column-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    will-change: transform;
  }

  .gallery-set-original,
  .gallery-set-duplicate {
    display: flex;
    flex-direction: column;
  }

  .gallery-image-wrapper {
    flex-shrink:0;
    overflow: hidden;
    border-radius: var(--gallery-image-radius, 0px);
    cursor: pointer;
    position: relative;
    will-change: transform;
    backface-visibility: hidden;
  }

  .gallery-image-wrapper.is-floating {
    z-index: 10;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: inherit;
    will-change: transform;
    backface-visibility: hidden;
  }

  @media (max-width: 768px) {
    :global(body.gallery-page-active) :global(.scroll-container) {
      --gallery-top-gap: 1.5rem;
    }

    .gallery-page {
      padding-bottom: 3rem;
    }

    .gallery-container {
      --gallery-current-padding: var(--gallery-padding-mobile, 1.5rem);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import {
    BREAKPOINTS,
    HOVER_TRANSITION_DURATION,
    FLOAT_HOVER_DELAY_MS,
    FLOAT_SCALE_AMOUNT,
    FLOAT_ZOOM_AMOUNT,
    FLOAT_ANIMATION_DURATION,
    FLOAT_EASE,
  } from '../config/gallery';

  let activeTweens: gsap.core.Tween[] = [];
  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  let imageLoadTimer: ReturnType<typeof setTimeout> | null = null;
  let cleanupController: AbortController | null = null;

  let activeFloatWrapper: HTMLElement | null = null;
  let activeFloatTimeline: gsap.core.Timeline | null = null;
  let pendingWrapper: HTMLElement | null = null;
  let pendingTimer: ReturnType<typeof setTimeout> | null = null;

  /**
   * Determine how many columns should be visible based on viewport width.
   */
  function getColumnCount(): number {
    const w = window.innerWidth;
    if (w >= BREAKPOINTS.desktop) return 4;
    if (w >= BREAKPOINTS.tablet) return 3;
    return 2;
  }

  /**
   * Smoothly decelerate all loop tweens to pause.
   */
  function pauseGallery(): void {
    activeTweens.forEach((tween) => {
      gsap.to(tween, {
        timeScale: 0,
        duration: HOVER_TRANSITION_DURATION,
        ease: 'power2.out',
      });
    });
  }

  /**
   * Smoothly accelerate all loop tweens back to normal speed.
   */
  function resumeGallery(): void {
    activeTweens.forEach((tween) => {
      gsap.to(tween, {
        timeScale: 1,
        duration: HOVER_TRANSITION_DURATION,
        ease: 'power2.in',
      });
    });
  }

  /**
   * Immediately kill any running float animation and restore all
   * GSAP-applied transforms, z-indices, and classes to their default state.
   */
  function forceResetActiveFloat(): void {
    if (pendingTimer) {
      clearTimeout(pendingTimer);
      pendingTimer = null;
    }
    pendingWrapper = null;

    if (activeFloatTimeline) {
      activeFloatTimeline.kill();
      activeFloatTimeline = null;
    }

    if (activeFloatWrapper) {
      const col = activeFloatWrapper.closest('.gallery-column') as HTMLElement;
      const img = activeFloatWrapper.querySelector('.gallery-image') as HTMLElement;

      // Clear wrapper & image inline styles
      gsap.set(activeFloatWrapper, { clearProps: 'scale,zIndex,y' });
      activeFloatWrapper.classList.remove('is-floating');
      if (img) gsap.set(img, { clearProps: 'scale' });

      // Reset column elevation and all sibling shifts
      if (col) {
        col.classList.remove('is-elevated');
        col.style.zIndex = '';
        const colWrappers = col.querySelectorAll('.gallery-image-wrapper');
        gsap.set(colWrappers, { clearProps: 'y' });
      }

      activeFloatWrapper = null;
    }

    resumeGallery();
  }

  /**
   * Activate the floating effect on the given image wrapper.
   *
   * Builds a reversible GSAP timeline that:
   * 1. Pauses the gallery loop
   * 2. Elevates the parent column's stacking context
   * 3. Scales the wrapper + shifts it vertically to stay in view
   * 4. Zooms the inner image
   * 5. Shifts adjacent wrappers in the same column to maintain spacing
   *
   * The timeline's onReverseComplete cleans up all state.
   */
  function triggerFloat(wrapper: HTMLElement): void {
    // If there's already an active float on a different element, force-reset it
    if (activeFloatWrapper && activeFloatWrapper !== wrapper) {
      forceResetActiveFloat();
    }

    const col = wrapper.closest('.gallery-column') as HTMLElement;
    const img = wrapper.querySelector('.gallery-image') as HTMLElement;
    if (!col || !img) return;

    // ── Pause the gallery loop ──
    pauseGallery();

    // ── Viewport boundary shift calculation ──
    const colRect = col.getBoundingClientRect();
    const wrapperRect = wrapper.getBoundingClientRect();
    const scaledHeight = wrapperRect.height * FLOAT_SCALE_AMOUNT;
    const yCenter = (wrapperRect.top + wrapperRect.bottom) / 2;
    const projectedTop = yCenter - scaledHeight / 2;
    const projectedBottom = yCenter + scaledHeight / 2;

    let offset = 0;
    if (projectedTop < colRect.top) {
      // Cut off at the top — shift down
      offset = colRect.top - projectedTop;
    } else if (projectedBottom > colRect.bottom) {
      // Cut off at the bottom — shift up
      offset = colRect.bottom - projectedBottom;
    }

    // ── Spacing preservation ──
    const shiftAmount = (wrapperRect.height * (FLOAT_SCALE_AMOUNT - 1)) / 2;

    // Identify siblings in the same gallery-set (original or duplicate)
    const parentSet = wrapper.closest('.gallery-set-original, .gallery-set-duplicate') as HTMLElement;
    if (!parentSet) return;
    const allWrappersInSet = Array.from(parentSet.querySelectorAll('.gallery-image-wrapper')) as HTMLElement[];
    const wrapperIndex = allWrappersInSet.indexOf(wrapper);

    const above = allWrappersInSet.filter((_, i) => i < wrapperIndex);
    const below = allWrappersInSet.filter((_, i) => i > wrapperIndex);

    // ── Build the reversible timeline ──
    activeFloatWrapper = wrapper;

    // Elevate column stacking context
    col.classList.add('is-elevated');
    wrapper.classList.add('is-floating');

    const tl = gsap.timeline({
      defaults: {
        duration: FLOAT_ANIMATION_DURATION,
        ease: FLOAT_EASE,
      },
      onReverseComplete: () => {
        // Cleanup after full reverse
        col.classList.remove('is-elevated');
        wrapper.classList.remove('is-floating');

        gsap.set(wrapper, { clearProps: 'scale,zIndex,y' });
        gsap.set(img, { clearProps: 'scale' });
        gsap.set(allWrappersInSet, { clearProps: 'y' });

        activeFloatWrapper = null;
        activeFloatTimeline = null;

        resumeGallery();
      },
    });

    // Wrapper: scale up + apply viewport offset
    tl.to(wrapper, { scale: FLOAT_SCALE_AMOUNT, y: offset }, 0);

    // Inner image: zoom
    tl.to(img, { scale: FLOAT_ZOOM_AMOUNT }, 0);

    // Adjacent wrappers: shift to maintain spacing
    if (above.length > 0) {
      tl.to(above, { y: -shiftAmount + offset }, 0);
    }
    if (below.length > 0) {
      tl.to(below, { y: shiftAmount + offset }, 0);
    }

    activeFloatTimeline = tl;
  }

  /**
   * Attach delegated pointer/click listeners for the floating effect.
   *
   * Desktop: pointerover starts a delay timer → triggerFloat().
   *          pointerout cancels the timer or reverses the animation.
   * Mobile:  click toggles float immediately (no delay).
   *
   * Uses AbortController signal for automatic cleanup on navigation.
   */
  function attachFloatListeners(
    container: HTMLElement,
    signal: AbortSignal
  ): void {
    // ── Desktop: hover delay ──
    container.addEventListener('pointerover', (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;

      const wrapper = (e.target as HTMLElement).closest('.gallery-image-wrapper') as HTMLElement | null;
      if (!wrapper || wrapper === pendingWrapper || wrapper === activeFloatWrapper) return;

      // Cancel any pending timer from a previous hover
      if (pendingTimer) {
        clearTimeout(pendingTimer);
        pendingTimer = null;
      }

      // If hovering a different image while one is active, reverse it
      if (activeFloatWrapper && activeFloatWrapper !== wrapper) {
        activeFloatTimeline?.reverse();
      }

      pendingWrapper = wrapper;
      pendingTimer = setTimeout(() => {
        pendingTimer = null;
        pendingWrapper = null;
        triggerFloat(wrapper);
      }, FLOAT_HOVER_DELAY_MS);
    }, { signal });

    // ── Desktop: pointer leaves the container ──
    container.addEventListener('pointerleave', (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;

      if (pendingTimer) {
        clearTimeout(pendingTimer);
        pendingTimer = null;
      }
      pendingWrapper = null;

      if (activeFloatWrapper) {
        activeFloatTimeline?.reverse();
      }
    }, { signal });

    // ── Desktop: pointer moves between wrappers within the container ──
    container.addEventListener('pointerout', (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;

      const relatedWrapper = (e.relatedTarget as HTMLElement | null)?.closest('.gallery-image-wrapper') as HTMLElement | null;

      // Only cancel if pointer left the current pending/active wrapper
      // and didn't move to another wrapper (pointerover handles that case)
      if (!relatedWrapper) {
        if (pendingTimer && pendingWrapper) {
          const leavingWrapper = (e.target as HTMLElement).closest('.gallery-image-wrapper') as HTMLElement | null;
          if (leavingWrapper === pendingWrapper) {
            clearTimeout(pendingTimer);
            pendingTimer = null;
            pendingWrapper = null;
          }
        }
      }
    }, { signal });

    // ── Mobile: tap to toggle ──
    container.addEventListener('click', (e: MouseEvent) => {
      // Only handle touch-originated clicks
      // PointerEvent extends MouseEvent; check pointerType if available
      const pe = e as PointerEvent;
      if (pe.pointerType !== 'touch') return;

      const wrapper = (e.target as HTMLElement).closest('.gallery-image-wrapper') as HTMLElement | null;
      if (!wrapper) return;

      e.preventDefault();

      if (activeFloatWrapper === wrapper) {
        // Tap the active image → reverse (close)
        activeFloatTimeline?.reverse();
      } else {
        // Tap a new image → force-reset old, open new immediately
        forceResetActiveFloat();
        triggerFloat(wrapper);
      }
    }, { signal });
  }

  /**
   * Redistribute images into currently visible columns.
   * Moves actual DOM nodes so Astro's optimized <img> elements are preserved.
   */
  function redistributeColumns(
    allColumns: HTMLElement[],
    visibleCount: number,
    allImageWrappers: HTMLElement[]
  ): void {
    // Clear all original and duplicate sets first
    allColumns.forEach((col) => {
      const orig = col.querySelector('.gallery-set-original');
      if (orig) orig.innerHTML = '';
      const dupe = col.querySelector('.gallery-set-duplicate');
      if (dupe) dupe.innerHTML = '';
    });

    // Round-robin distribute original image wrappers to currently visible columns
    const visibleOriginals = allColumns
      .slice(0, visibleCount)
      .map((col) => col.querySelector('.gallery-set-original')!);

    allImageWrappers.forEach((wrapper, i) => {
      const targetOriginal = visibleOriginals[i % visibleCount];
      if (targetOriginal) {
        targetOriginal.appendChild(wrapper);
      }
    });

    // Rebuild the duplicate set in each visible column
    allColumns.slice(0, visibleCount).forEach((col) => {
      const orig = col.querySelector('.gallery-set-original') as HTMLElement;
      const dupe = col.querySelector('.gallery-set-duplicate') as HTMLElement;
      if (!orig || !dupe) return;

      // Clone the current original images as new duplicates
      const originals = Array.from(orig.querySelectorAll('.gallery-image-wrapper'));
      originals.forEach((origWrapper) => {
        const clone = origWrapper.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        // Clear alt on cloned images
        const img = clone.querySelector('img');
        if (img) img.alt = '';
        dupe.appendChild(clone);
      });
    });

    // Toggle visibility
    allColumns.forEach((col, i) => {
      col.classList.toggle('is-hidden', i >= visibleCount);
    });
  }

  /**
   * Update columns' style height based on their original set height.
   * Equalizes the height of all visible columns to the height of the shortest one.
   */
  function updateColumnHeights(allColumns: HTMLElement[]): void {
    let minHeight = Infinity;

    // Find the minimum height among all visible original sets
    allColumns.forEach((col) => {
      if (col.classList.contains('is-hidden')) return;
      const originalSet = col.querySelector('.gallery-set-original') as HTMLElement;
      if (originalSet && originalSet.offsetHeight > 0) {
        minHeight = Math.min(minHeight, originalSet.offsetHeight);
      }
    });

    // Apply the minimum height to all visible columns
    allColumns.forEach((col) => {
      if (col.classList.contains('is-hidden')) {
        col.style.height = '';
        return;
      }
      if (minHeight !== Infinity) {
        col.style.height = `${minHeight}px`;
      }
    });
  }

  /**
   * Create GSAP infinite loop tweens for each visible column.
   */
  function createLoopTweens(allColumns: HTMLElement[]): void {
    // Kill any existing tweens
    activeTweens.forEach((t) => t.kill());
    activeTweens = [];

    // Find the minimum original set height among all visible columns
    let minHeight = Infinity;
    allColumns.forEach((col) => {
      if (col.classList.contains('is-hidden')) return;
      const originalSet = col.querySelector('.gallery-set-original') as HTMLElement;
      if (originalSet && originalSet.offsetHeight > 0) {
        minHeight = Math.min(minHeight, originalSet.offsetHeight);
      }
    });

    allColumns.forEach((col) => {
      if (col.classList.contains('is-hidden')) return;

      const inner = col.querySelector('.gallery-column-inner') as HTMLElement;
      const originalSet = col.querySelector('.gallery-set-original') as HTMLElement;
      if (!inner || !originalSet) return;

      const direction = col.dataset.colDirection;
      const baseSpeed = parseFloat(col.dataset.colSpeed || '30');

      // Scale duration based on this column's height vs the min height (shortest column)
      let duration = baseSpeed;
      if (minHeight !== Infinity && minHeight > 0) {
        duration = baseSpeed * (originalSet.offsetHeight / minHeight);
      }

      if (direction === 'up') {
        // Scroll up: translate from 0% to -50%
        const tween = gsap.to(inner, {
          yPercent: -50,
          duration: duration,
          ease: 'none',
          repeat: -1,
        });
        activeTweens.push(tween);
      } else {
        // Scroll down: translate from -50% to 0%
        const tween = gsap.fromTo(
          inner,
          { yPercent: -50 },
          {
            yPercent: 0,
            duration: duration,
            ease: 'none',
            repeat: -1,
          }
        );
        activeTweens.push(tween);
      }
    });
  }

  /**
   * Clean up all gallery resources (tweens, timers, event listeners).
   */
  function cleanupGallery(): void {
    // Reset any active float effect first
    forceResetActiveFloat();

    // Kill all loop tweens
    activeTweens.forEach((t) => t.kill());
    activeTweens = [];

    // Clear debounce timers
    if (resizeTimer) {
      clearTimeout(resizeTimer);
      resizeTimer = null;
    }
    if (imageLoadTimer) {
      clearTimeout(imageLoadTimer);
      imageLoadTimer = null;
    }

    // Abort all event listeners (resize + hover + float)
    if (cleanupController) {
      cleanupController.abort();
      cleanupController = null;
    }
  }

  /**
   * Main initialization — called on every page load.
   */
  function initGallery(): void {
    const container = document.getElementById('gallery-container');
    if (!container) return;

    const allColumns = Array.from(
      container.querySelectorAll('.gallery-column')
    ) as HTMLElement[];
    if (allColumns.length === 0) return;

    // Reduced motion: show static grid, no animation
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (motionQuery.matches) return;

    // Clean up any previous instance (e.g., from a prior page-load)
    cleanupGallery();

    // Create a new AbortController for this gallery instance
    cleanupController = new AbortController();
    const { signal } = cleanupController;

    // Collect and sort all original image wrappers before redistributing
    const allImageWrappers = allColumns.flatMap((col) =>
      Array.from(col.querySelectorAll('.gallery-set-original > .gallery-image-wrapper'))
    ) as HTMLElement[];

    allImageWrappers.sort((a, b) => {
      const idxA = parseInt(a.dataset.originalIndex || '0', 10);
      const idxB = parseInt(b.dataset.originalIndex || '0', 10);
      return idxA - idxB;
    });

    const visibleCount = getColumnCount();
    redistributeColumns(allColumns, visibleCount, allImageWrappers);
    updateColumnHeights(allColumns);
    createLoopTweens(allColumns);
    attachFloatListeners(container, signal);

    // Watch for image loads to recompute heights as they stream in
    const images = container.querySelectorAll('.gallery-set-original img') as NodeListOf<HTMLImageElement>;
    
    function triggerHeightRecalc() {
      if (imageLoadTimer) clearTimeout(imageLoadTimer);
      imageLoadTimer = setTimeout(() => {
        updateColumnHeights(allColumns);
        createLoopTweens(allColumns);
      }, 50);
    }

    images.forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', triggerHeightRecalc, { signal, once: true });
        img.addEventListener('error', triggerHeightRecalc, { signal, once: true });
      }
    });

    // Handle resize — uses signal so it's auto-removed on cleanup
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        // Reset any active float before rebuilding layout
        forceResetActiveFloat();

        const newCount = getColumnCount();
        // Kill old tweens
        activeTweens.forEach((t) => t.kill());
        activeTweens = [];
        // Reset column transforms & height styles
        allColumns.forEach((col) => {
          col.style.height = '';
          const inner = col.querySelector('.gallery-column-inner') as HTMLElement;
          if (inner) gsap.set(inner, { clearProps: 'all' });
        });
        redistributeColumns(allColumns, newCount, allImageWrappers);
        updateColumnHeights(allColumns);
        createLoopTweens(allColumns);
      }, 200);
    }, { signal });
  }

  // ── Astro lifecycle ───────────────────────────────
  if (!(window as any).__galleryListenerAdded) {
    document.addEventListener('astro:page-load', initGallery);
    (window as any).__galleryListenerAdded = true;
  }

  // Clean up on navigation away
  if (!(window as any).__galleryBeforeSwapAdded) {
    document.addEventListener('astro:before-swap', () => {
      const container = document.getElementById('gallery-container');
      if (!container) return;
      cleanupGallery();
    });
    (window as any).__galleryBeforeSwapAdded = true;
  }
