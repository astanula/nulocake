---
import logo from '../assets/nulocake logo.svg';
import { Image } from 'astro:assets';
const path = Astro.url.pathname;
---

<nav id="main-nav" class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Nulo Cake - strona główna">
      <Image src={logo} alt="Nulo Cake" width={40} height={40} class="nav-logo-img" />
    </a>

    <button id="nav-toggle" class="nav-hamburger" aria-label="Otwórz menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <ul id="nav-links" class="nav-links">
      <div id="nav-limelight" class="limelight" aria-hidden="true">
        <div class="limelight-glow"></div>
      </div>
      <li>
        <button id="nav-close" class="nav-close" aria-label="Zamknij menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M4 4l12 12M16 4L4 16"/>
          </svg>
        </button>
      </li>
      <li><a href="/oferta" class:list={['nav-link', { 'nav-link--active': path === '/oferta' || path === '/oferta/' }]} aria-current={path === '/oferta' || path === '/oferta/' ? 'page' : undefined}>Oferta</a></li>
      <li><a href="/galeria" class:list={['nav-link', { 'nav-link--active': path === '/galeria' || path === '/galeria/' }]} aria-current={path === '/galeria' || path === '/galeria/' ? 'page' : undefined}>Galeria</a></li>
      <li><a href="/o-mnie" class:list={['nav-link', { 'nav-link--active': path === '/o-mnie' || path === '/o-mnie/' }]} aria-current={path === '/o-mnie' || path === '/o-mnie/' ? 'page' : undefined}>O mnie</a></li>
      <li><a href="/kontakt" class:list={['nav-link', { 'nav-link--active': path === '/kontakt' || path === '/kontakt/' }]} aria-current={path === '/kontakt' || path === '/kontakt/' ? 'page' : undefined}>Kontakt</a></li>
    </ul>

    <a
      id="nav-cta"
      href="/kontakt"
      class="nav-cta"
      aria-label="Zamów tort"
    >Zamów</a>
  </div>
</nav>
<div id="nav-backdrop" class="nav-backdrop" aria-hidden="true"></div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    padding: 1rem 0;
    transition: background 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                backdrop-filter 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav.scrolled {
    background: rgba(19, 19, 19, 0.6);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(68, 66, 65, 0.15);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    gap: 1rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .nav-logo:hover {
    opacity: 0.8;
  }

  .nav-logo-img {
    width: 40px;
    height: auto;
    object-fit: contain;
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 50;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-on-surface);
    border-radius: 1px;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-hamburger.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-hamburger.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .nav-hamburger.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    /* Center the links in the remaining space */
    flex: 1;
    justify-content: center;
    position: relative;
  }

  .limelight {
    position: absolute;
    top: -8px;
    width: 50px;
    height: 5px;
    background-color: var(--color-primary);
    border-radius: 9999px;
    box-shadow: 0 4px 10px rgba(255, 170, 248, 0.5);
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    left: 0;
  }

  .limelight::after {
    content: '';
    position: absolute;
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 12px;
    background-color: rgba(210, 80, 190, 0.4);
    border-radius: 50%;
    filter: blur(4px);
    pointer-events: none;
  }

  .limelight-glow {
    position: absolute;
    left: -25%;
    top: 0;
    width: 150%;
    height: 46px;
    clip-path: polygon(0% 100%, 16.66% 0, 83.33% 0, 100% 100%);
    background: linear-gradient(to bottom, rgba(255, 170, 248, 0.18) 0%, rgba(255, 170, 248, 0.06) 70%, rgba(255, 170, 248, 0.01) 100%);
    pointer-events: none;
  }

  .nav-link {
    font-family: var(--font-family-body);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    position: relative;
    z-index: 10;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover {
    color: var(--color-on-surface);
  }

  /* Active / current-page state */
  .nav-link--active {
    color: var(--color-on-surface);
  }

  /* Right-side CTA button */
  .nav-cta {
    flex-shrink: 0;
    padding: 0.5rem 1.25rem;
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-outline-variant);
    border-radius: 0.125rem;
    font-family: var(--font-family-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                background 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-cta:hover {
    border-color: var(--color-primary);
    background: rgba(255, 170, 248, 0.06);
  }

  /* Close button inside mobile drawer */
  .nav-close {
    display: none;
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-on-surface-variant);
    padding: 0.5rem;
  }

  /* Backdrop overlay */
  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .nav-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .limelight {
      display: none;
    }

    .nav-hamburger {
      display: flex;
    }

    .nav-close {
      display: block;
    }

    /* Hide the CTA button on mobile — it's accessible via the drawer */
    .nav-cta {
      display: none;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 75%;
      max-width: 320px;
      height: 100dvh;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      background: rgba(14, 14, 14, 0.95);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      padding: 2rem;
      transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-links.open {
      right: 0;
    }

    .nav-link {
      font-size: 1rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { navigate } from 'astro:transitions/client';

  let isInitialized = false;
  let ticking = false;
  let resizeTimer;

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const nav = document.getElementById('main-nav');
        if (window.scrollY > 60) {
          nav?.classList.add('scrolled');
        } else {
          nav?.classList.remove('scrolled');
        }
        ticking = false;
      });
      ticking = true;
    }
  };

  function initNav() {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    const links = document.getElementById('nav-links');
    const backdrop = document.getElementById('nav-backdrop');
    const closeBtn = document.getElementById('nav-close');

    if (!isInitialized) {
      window.addEventListener('scroll', onScroll, { passive: true });
      
      window.addEventListener('resize', () => {
        const limelight = document.getElementById('nav-limelight');
        const activeLink = document.querySelector('.nav-link--active');
        if (window.innerWidth > 768 && limelight) {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (activeLink) {
              const getLimelightX = (element) => element.offsetLeft + (element.offsetWidth / 2) - 25;
              gsap.to(limelight, { x: getLimelightX(activeLink), duration: 0.2, ease: 'power2.out' });
            }
          }, 100);
        }
      });
      
      document.addEventListener('keydown', (e) => {
        const currentLinks = document.getElementById('nav-links');
        if (!currentLinks?.classList.contains('open')) return;
        const focusable = currentLinks.querySelectorAll('a, button');
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.key === 'Tab') {
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault(); last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault(); first.focus();
          }
        }
        if (e.key === 'Escape') {
          const t = document.getElementById('nav-toggle');
          const b = document.getElementById('nav-backdrop');
          t?.classList.remove('active');
          currentLinks?.classList.remove('open');
          b?.classList.remove('open');
          t?.focus();
        }
      });

      isInitialized = true;
    }
    
    onScroll();

    /* Open / close helpers */
    function openMenu() {
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Zamknij menu');
      toggle?.classList.add('active');
      links?.classList.add('open');
      backdrop?.classList.add('open');
      closeBtn?.focus();
    }

    function closeMenu() {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Otwórz menu');
      toggle?.classList.remove('active');
      links?.classList.remove('open');
      backdrop?.classList.remove('open');
      toggle?.focus();
    }

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    const navLinksArray = Array.from(links?.querySelectorAll('a') || []);
    navLinksArray.forEach((link) => {
      // Avoid attaching closeMenu to desktop links if they animate, but it's harmless
      link.addEventListener('click', closeMenu);
    });

    /* Limelight animation using GSAP */
    const limelight = document.getElementById('nav-limelight');
    const activeLink = document.querySelector('.nav-link--active');
    
    if (limelight && window.innerWidth > 768) {
      const getLimelightX = (element) => {
        return element.offsetLeft + (element.offsetWidth / 2) - 25;
      };

      // Position immediately on load
      const targetLink = activeLink || Array.from(document.querySelectorAll('.nav-link'))[0];
      if (targetLink) {
        gsap.set(limelight, { x: getLimelightX(targetLink), opacity: 1 });
      }

      document.querySelectorAll('.nav-link').forEach((link) => {
        link.addEventListener('click', (e) => {
          const anchor = e.currentTarget;
          e.preventDefault();
          
          document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('nav-link--active'));
          anchor.classList.add('nav-link--active');
          
          gsap.to(limelight, {
            x: getLimelightX(anchor),
            duration: 0.4,
            ease: 'power2.inOut',
            opacity: 1,
            onComplete: () => {
              navigate(anchor.href);
            }
          });
        });
      });
    }
  }

  // Run on initial load and every subsequent page swap
  document.addEventListener('astro:page-load', initNav);
</script>
