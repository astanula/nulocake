---
import { CONTACT_DETAILS, CONTACT_LINKS } from '../../config/contact';
---

<contact-location-map
  data-map-src={CONTACT_LINKS.mapEmbed}
  data-map-title={`Google Maps: ${CONTACT_DETAILS.address}`}
>
  <div class="map-surface panel" data-map-surface>
    <div class="map-placeholder">
      <svg class="map-pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
      <p>{CONTACT_DETAILS.address}</p>
      <button type="button" class="map-load" aria-describedby="contact-map-note" data-map-load>
        Wczytaj map&#281; Google
      </button>
    </div>
  </div>
  <div class="map-caption">
    <p id="contact-map-note">Mapa &#322;&#261;czy si&#281; z Google po klikni&#281;ciu.</p>
    <a href={CONTACT_LINKS.directions} target="_blank" rel="noopener noreferrer">
      Wyznacz tras&#281;
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M4 12 12 4M4 4h8v8" />
      </svg>
    </a>
  </div>
</contact-location-map>

<script>
  class ContactLocationMap extends HTMLElement {
    private controller: AbortController | null = null;

    connectedCallback() {
      this.controller?.abort();
      const button = this.querySelector<HTMLButtonElement>('[data-map-load]');
      const surface = this.querySelector<HTMLElement>('[data-map-surface]');
      const src = this.dataset.mapSrc;
      if (!button || !surface || !src) return;

      this.controller = new AbortController();
      button.addEventListener(
        'click',
        () => {
          const frame = document.createElement('iframe');
          frame.title = this.dataset.mapTitle ?? 'Google Maps';
          frame.src = src;
          frame.referrerPolicy = 'strict-origin-when-cross-origin';
          frame.allowFullscreen = true;
          surface.replaceChildren(frame);
          frame.focus();
        },
        { once: true, signal: this.controller.signal },
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.controller = null;
    }
  }

  if (!customElements.get('contact-location-map')) {
    customElements.define('contact-location-map', ContactLocationMap);
  }
</script>

<style>
  contact-location-map {
    display: block;
    min-width: 0;
  }

  .map-surface {
    height: 214px;
    overflow: hidden;
  }

  .map-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    height: 100%;
    padding: 1.25rem;
    text-align: center;
    background:
      radial-gradient(ellipse at center, var(--color-glow), transparent 75%),
      repeating-linear-gradient(0deg, transparent 0 37px, color-mix(in srgb, var(--color-outline-variant) 20%, transparent) 37px 38px),
      repeating-linear-gradient(90deg, transparent 0 37px, color-mix(in srgb, var(--color-outline-variant) 20%, transparent) 37px 38px);
  }

  .map-pin {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.5;
  }

  .map-placeholder p {
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
  }

  .map-load {
    min-height: 44px;
    padding: 0.625rem 1rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-on-surface);
    background: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: 0.125rem;
    cursor: pointer;
    touch-action: manipulation;
  }

  .map-load:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .map-surface :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.625rem;
    font-size: 0.6875rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant);
  }

  .map-caption a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    color: var(--color-primary);
    text-decoration: none;
  }

  .map-caption a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .map-caption svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
</style>
