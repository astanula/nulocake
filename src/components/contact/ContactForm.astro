---
import { CREAM_FLAVORS, MAX_CREAM_FLAVORS, MESSAGE_FALLBACK } from '../../config/contact';
---

<form class="contact-form" id="contact-form" data-contact-form novalidate>
  <div class="field">
    <div class="field overlay-field" data-state="empty">
      <label class="visually-hidden" for="contact-email">E-mail</label>
      <input
        class="field-control"
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        aria-describedby="contact-email-error"
      />
      <span class="field-overlay field-overlay-empty" aria-hidden="true"><span class="field-name">E-mail</span></span>
      <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">E-mail:</span>{' '}<span data-email-label></span></span>
    </div>
    <p class="field-error" id="contact-email-error"></p>
  </div>

  <div class="field overlay-field overlay-field-message" data-state="empty">
    <label class="visually-hidden" for="contact-message">Wiadomość, opcjonalnie</label>
    <textarea
      class="field-control field-textarea"
      id="contact-message"
      name="message"
      rows="5"
      placeholder={MESSAGE_FALLBACK}
    ></textarea>
    <span class="field-overlay field-overlay-empty" aria-hidden="true"><span class="field-name">Wiadomość</span>{' '}<span class="field-optional">— opcjonalnie</span></span>
    <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">Wiadomość:</span>{' '}<span data-message-label></span></span>
  </div>

  <div class="field-row">
    <div class="field overlay-field" data-state="empty">
      <label class="visually-hidden" for="contact-date">Termin, opcjonalnie</label>
      <input
        class="field-control"
        id="contact-date"
        name="date"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        maxlength="10"
        placeholder="yyyy/mm/dd"
      />
      <span class="field-overlay field-overlay-empty" aria-hidden="true">
        <span class="field-name">Termin</span>{' '}<span class="field-optional">— opcjonalnie</span>
      </span>
      <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">Termin:</span>{' '}<span data-date-label></span></span>
      <input class="date-native" type="date" tabindex="-1" aria-hidden="true" data-date-native />
      <button type="button" class="date-picker" aria-label="Wybierz termin z kalendarza" data-date-picker>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <div class="field overlay-field overlay-field-people" data-state="empty">
      <label class="visually-hidden" for="contact-people">Liczba osób, opcjonalnie</label>
      <input
        class="field-control"
        id="contact-people"
        name="people"
        type="number"
        min="1"
        step="1"
        inputmode="numeric"
      />
      <span class="field-overlay field-overlay-empty" aria-hidden="true">
        <span class="field-name">Liczba osób</span>{' '}<span class="field-optional">— opcjonalnie</span>
      </span>
      <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">Liczba osób:</span>{' '}<span data-people-label></span></span>
    </div>
  </div>

  <fieldset class="field" aria-label="Smaki kremów">
    <details class="flavor-dropdown">
      <summary class="field-control flavor-summary">
        <span class="flavor-summary-selection">
          <span class="flavor-summary-text" data-flavors-summary>Wybierz smaki</span>{' '}
          <span class="flavor-summary-count" aria-live="polite" data-flavors-count>(0 z {MAX_CREAM_FLAVORS})</span>{' '}
          <span class="field-optional flavor-summary-optional" data-flavors-optional>— opcjonalnie</span>
        </span>
        <svg class="flavor-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </summary>
      <div class="flavor-options">
        {CREAM_FLAVORS.map((flavor) => (
          <label class="flavor-option">
            <input class="flavor-input" type="checkbox" name="flavors" value={flavor} />
            <span>{flavor}</span>
          </label>
        ))}
      </div>
    </details>
  </fieldset>

  <div class="field">
    <input id="contact-images" type="file" accept="image/*" multiple hidden data-image-input />
    <button type="button" class="btn-secondary image-trigger" data-image-trigger>Dodaj zdjęcie inspiracji</button>
    <ul class="image-list" aria-label="Wybrane zdjęcia" data-image-list></ul>
  </div>

  <div class="contact-actions">
    <button type="submit" class="btn-secondary email-submit">Wyślij e-mailem</button>
  </div>

  <p class="form-status" role="status" data-form-status></p>
</form>

<script>
  import { CONTACT_CHANNELS, MAX_CREAM_FLAVORS, type ContactChannelId } from '../../config/contact';
  import {
    EMAIL_SUBMIT_EVENT,
    channelSupportsPrefill,
    channelUrl,
    formatEnquiryText,
    hasCustomContent,
    isValidDate,
    isValidEmail,
    type EmailSubmitDetail,
    type EnquiryDraft,
  } from '../../utils/contactEnquiry';

  interface SelectedImage {
    file: File;
    url: string;
  }

  let cleanupController: AbortController | null = null;

  const todayIso = () => {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    return now.toISOString().slice(0, 10);
  };

  const MONTHS = [
    'stycznia',
    'lutego',
    'marca',
    'kwietnia',
    'maja',
    'czerwca',
    'lipca',
    'sierpnia',
    'września',
    'października',
    'listopada',
    'grudnia',
  ];

  const dateLabel = (value: string) => {
    if (!isValidDate(value)) return value;
    const [year, month, day] = value.split('/').map(Number);
    return `${day} ${MONTHS[month - 1]} ${year}`;
  };

  const fileKey = (file: File) => `${file.name}:${file.size}:${file.lastModified}`;

  const emailErrorText = (value: string) => {
    if (!value.trim()) return 'Podaj adres e-mail, abym mogła odpowiedzieć.';
    return isValidEmail(value) ? '' : 'Sprawdź adres e-mail, np. anna@example.com.';
  };

  function initContactForm() {
    cleanupController?.abort();
    cleanupController = null;

    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const page = form?.closest<HTMLElement>('[data-contact-page]');
    if (!form || !page) return;

    cleanupController = new AbortController();
    const { signal } = cleanupController;
    const query = <T extends Element>(selector: string) => form.querySelector<T>(selector)!;
    const queryPage = <T extends Element>(selector: string) => page.querySelector<T>(selector)!;

    const email = query<HTMLInputElement>('#contact-email');
    const emailError = query<HTMLElement>('#contact-email-error');
    const message = query<HTMLTextAreaElement>('#contact-message');
    const emailDisplay = query<HTMLElement>('[data-email-label]');
    const messageDisplay = query<HTMLElement>('[data-message-label]');
    const date = query<HTMLInputElement>('#contact-date');
    const people = query<HTMLInputElement>('#contact-people');
    const dateDisplay = query<HTMLElement>('[data-date-label]');
    const dateNative = query<HTMLInputElement>('[data-date-native]');
    const datePicker = query<HTMLButtonElement>('[data-date-picker]');
    const peopleDisplay = query<HTMLElement>('[data-people-label]');
    const flavorDropdown = query<HTMLDetailsElement>('.flavor-dropdown');
    const flavorInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="flavors"]'));
    const flavorCount = query<HTMLElement>('[data-flavors-count]');
    const flavorSummary = query<HTMLElement>('[data-flavors-summary]');
    const flavorOptional = query<HTMLElement>('[data-flavors-optional]');
    const imageInput = query<HTMLInputElement>('[data-image-input]');
    const imageTrigger = query<HTMLButtonElement>('[data-image-trigger]');
    const imageList = query<HTMLUListElement>('[data-image-list]');
    const imagesNote = queryPage<HTMLElement>('[data-images-note]');
    const channelLinks = Array.from(page.querySelectorAll<HTMLAnchorElement>('a[data-channel]'));
    const handoff = queryPage<HTMLElement>('[data-handoff]');
    const handoffNames = Array.from(page.querySelectorAll<HTMLElement>('[data-handoff-channel]'));
    const handoffPreview = queryPage<HTMLTextAreaElement>('[data-handoff-preview]');
    const handoffCopy = queryPage<HTMLButtonElement>('[data-handoff-copy]');
    const handoffOpen = queryPage<HTMLAnchorElement>('[data-handoff-open]');
    const handoffStatus = queryPage<HTMLElement>('[data-handoff-status]');
    const formStatus = query<HTMLElement>('[data-form-status]');

    let images: SelectedImage[] = [];
    let emailAttempted = false;

    dateNative.min = todayIso();

    const readDraft = (): EnquiryDraft => ({
      email: email.value.trim(),
      message: message.value,
      date: date.value,
      people: people.value,
      flavors: flavorInputs.filter((input) => input.checked).map((input) => input.value),
      images: images.map(({ file }) => file),
    });

    const showEmailError = (text: string) => {
      emailError.textContent = text;
      if (text) email.setAttribute('aria-invalid', 'true');
      else email.removeAttribute('aria-invalid');
    };

    const updateOverlays = () => {
      email.parentElement!.dataset.state = email.value ? 'filled' : 'empty';
      emailDisplay.textContent = email.value;
      message.parentElement!.dataset.state = message.value ? 'filled' : 'empty';
      messageDisplay.textContent = message.value;
      date.parentElement!.dataset.state = date.value ? 'filled' : 'empty';
      dateDisplay.textContent = date.value ? dateLabel(date.value) : '';
      people.parentElement!.dataset.state = people.value ? 'filled' : 'empty';
      peopleDisplay.textContent = people.value;
    };

    const updateFlavors = () => {
      const selectedFlavors = flavorInputs.filter((input) => input.checked);
      const selected = selectedFlavors.length;
      flavorInputs.forEach((input) => {
        input.disabled = selected >= MAX_CREAM_FLAVORS && !input.checked;
      });
      flavorCount.textContent = `(${selected} z ${MAX_CREAM_FLAVORS})`;
      flavorSummary.textContent = selectedFlavors.map((input) => input.value).join(', ') || 'Wybierz smaki';
      flavorOptional.hidden = selected > 0;
    };

    const refreshHandoff = () => {
      const text = formatEnquiryText(readDraft());
      channelLinks.forEach((link) => {
        const channel = CONTACT_CHANNELS.find(({ id }) => id === link.dataset.channel);
        const url = channel && channelUrl(channel, text);
        if (url) link.href = url;
      });
      if (!handoff.hidden) handoffPreview.value = text;
    };

    const renderImages = () => {
      imageList.replaceChildren(
        ...images.map(({ file, url }, index) => {
          const item = document.createElement('li');
          item.className = 'image-item';
          const thumb = document.createElement('img');
          thumb.className = 'image-thumb';
          thumb.src = url;
          thumb.alt = '';
          const name = document.createElement('span');
          name.className = 'image-name';
          name.textContent = file.name;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'image-remove';
          remove.dataset.removeIndex = String(index);
          remove.textContent = 'Usuń';
          remove.setAttribute('aria-label', `Usuń ${file.name}`);
          item.append(thumb, name, remove);
          return item;
        }),
      );
      imagesNote.hidden = images.length === 0;
    };

    date.addEventListener(
      'input',
      () => {
        const digits = date.value.replace(/\D/g, '').slice(0, 8);
        const masked = [digits.slice(0, 4), digits.slice(4, 6), digits.slice(6, 8)].filter(Boolean).join('/');
        if (masked !== date.value) date.value = masked;
        date.removeAttribute('aria-invalid');
      },
      { signal },
    );

    date.addEventListener(
      'blur',
      () => {
        if (date.value && !isValidDate(date.value)) date.setAttribute('aria-invalid', 'true');
      },
      { signal },
    );

    datePicker.addEventListener(
      'click',
      () => {
        dateNative.value = isValidDate(date.value) ? date.value.replaceAll('/', '-') : '';
        dateNative.showPicker();
      },
      { signal },
    );

    dateNative.addEventListener(
      'change',
      () => {
        date.value = dateNative.value.replaceAll('-', '/');
        date.removeAttribute('aria-invalid');
        date.dispatchEvent(new Event('input', { bubbles: true }));
      },
      { signal },
    );

    form.addEventListener(
      'input',
      () => {
        updateOverlays();
        formStatus.textContent = '';
        if (emailAttempted) showEmailError(emailErrorText(email.value));
        refreshHandoff();
      },
      { signal },
    );

    flavorInputs.forEach((input) =>
      input.addEventListener(
        'change',
        () => {
          if (flavorInputs.filter((item) => item.checked).length > MAX_CREAM_FLAVORS) input.checked = false;
          updateFlavors();
          refreshHandoff();
          if (input.checked && flavorInputs.filter((item) => item.checked).length === MAX_CREAM_FLAVORS) {
            flavorDropdown.open = false;
            flavorDropdown.querySelector('summary')?.focus();
          }
        },
        { signal },
      ),
    );

    document.addEventListener(
      'click',
      (event) => {
        if (!flavorDropdown.contains(event.target as Node | null)) flavorDropdown.open = false;
      },
      { signal },
    );

    imageTrigger.addEventListener('click', () => imageInput.click(), { signal });

    imageInput.addEventListener(
      'change',
      () => {
        const known = new Set(images.map(({ file }) => fileKey(file)));
        Array.from(imageInput.files ?? [])
          .filter((file) => file.type.startsWith('image/') && !known.has(fileKey(file)))
          .forEach((file) => {
            known.add(fileKey(file));
            images.push({ file, url: URL.createObjectURL(file) });
          });
        imageInput.value = '';
        renderImages();
      },
      { signal },
    );

    imageList.addEventListener(
      'click',
      (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-remove-index]');
        if (!button) return;
        const index = Number(button.dataset.removeIndex);
        URL.revokeObjectURL(images[index].url);
        images = images.filter((_, i) => i !== index);
        renderImages();
        const next = imageList.querySelectorAll<HTMLButtonElement>('[data-remove-index]')[Math.min(index, images.length - 1)];
        (next ?? imageTrigger).focus();
      },
      { signal },
    );

    form.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();
        emailAttempted = true;
        const error = emailErrorText(email.value);
        showEmailError(error);
        if (error) {
          formStatus.textContent = '';
          email.focus();
          return;
        }

        const draft = readDraft();
        const handled = !form.dispatchEvent(
          new CustomEvent<EmailSubmitDetail>(EMAIL_SUBMIT_EVENT, {
            cancelable: true,
            detail: { draft, text: formatEnquiryText(draft) },
          }),
        );
        if (!handled) {
          formStatus.textContent = 'Wysyłka e-mailem nie jest jeszcze dostępna. Twoje dane zostają w formularzu.';
        }
      },
      { signal },
    );

    channelLinks.forEach((link) =>
      link.addEventListener(
        'click',
        (event) => {
          refreshHandoff();
          const draft = readDraft();
          if (channelSupportsPrefill(link.dataset.channel as ContactChannelId) || !hasCustomContent(draft)) return;

          event.preventDefault();
          handoffNames.forEach((name) => {
            name.textContent = link.dataset.label ?? '';
          });
          handoffOpen.href = link.href;
          handoffStatus.textContent = '';
          handoff.hidden = false;
          handoffPreview.value = formatEnquiryText(draft);
          handoffCopy.focus();
        },
        { signal },
      ),
    );

    handoffCopy.addEventListener(
      'click',
      async () => {
        try {
          await navigator.clipboard.writeText(handoffPreview.value);
          handoffStatus.textContent = 'Skopiowano treść.';
        } catch {
          handoffPreview.focus();
          handoffPreview.select();
          handoffStatus.textContent = 'Nie udało się skopiować automatycznie. Treść jest zaznaczona — skopiuj ją ręcznie.';
        }
      },
      { signal },
    );

    signal.addEventListener('abort', () => images.forEach(({ url }) => URL.revokeObjectURL(url)));

    updateOverlays();
    updateFlavors();
    refreshHandoff();
  }

  document.addEventListener('astro:page-load', initContactForm);
  document.addEventListener('astro:before-swap', () => {
    cleanupController?.abort();
    cleanupController = null;
  });
</script>

<style>
  .contact-form {
    --form-row-gap: 1.12rem;
    display: flex;
    flex-direction: column;
    gap: var(--form-row-gap);
    width: 100%;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    border: none;
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--form-row-gap) 1.25rem;
  }

  .field-optional {
    font-weight: 400;
    color: var(--color-outline);
  }

  .field-name,
  .flavor-summary-selection:has(.flavor-summary-optional:not([hidden])) .flavor-summary-text {
    color: var(--color-primary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .overlay-field {
    position: relative;
  }

  .field-overlay {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    gap: 0.3em;
    padding: 0.875rem 3rem 0.875rem 1rem;
    border: 1px solid transparent;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
  }

  .overlay-field:not(:has(.field-control:focus))[data-state='empty'] .field-overlay-empty,
  .overlay-field:not(:has(.field-control:focus))[data-state='filled'] .field-overlay-filled {
    display: flex;
  }

  .overlay-field-message .field-overlay {
    align-items: flex-start;
    padding-right: 1rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .overlay-field-message:not(:has(.field-control:focus))[data-state='filled'] .field-overlay-filled {
    display: block;
  }

  .field-overlay-filled > span:not(.field-name) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .overlay-field:not(:has(.field-control:focus)) .field-control {
    color: transparent;
  }

  .overlay-field:not(:has(.field-control:focus)) .field-control::placeholder {
    color: transparent;
  }

  .date-native {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .date-picker {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    padding: 0;
    color: var(--color-on-surface-variant);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .date-picker svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .date-picker:hover {
    color: var(--color-primary);
  }

  .date-picker:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -4px;
  }

  #contact-date {
    padding-right: 3rem;
  }

  .field-control {
    width: 100%;
    padding: 0.875rem 1rem;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-on-surface);
    background: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: 0.125rem;
    color-scheme: dark;
    transition: border-color 0.2s ease;
  }

  .field-control::placeholder {
    color: var(--color-outline);
    opacity: 1;
  }

  .field-control:hover {
    border-color: var(--color-outline);
  }

  .field-control:focus-visible {
    outline: none;
    border-color: var(--color-primary);
  }

  .field-control[aria-invalid='true'] {
    border-color: var(--color-error);
    box-shadow: 0 0 0 1px var(--color-error);
  }

  .field-textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field-error {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-error);
  }

  .field-error:empty,
  .form-status:empty {
    display: none;
  }

  .flavor-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .flavor-summary::-webkit-details-marker {
    display: none;
  }

  .flavor-summary-selection {
    display: flex;
    gap: 0.3rem;
    min-width: 0;
  }

  .flavor-summary-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .flavor-summary-count,
  .flavor-summary-optional {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .flavor-chevron {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-on-surface-variant);
    transition: transform 0.2s ease;
  }

  .flavor-dropdown[open] .flavor-chevron {
    transform: rotate(180deg);
  }

  .flavor-options {
    max-height: 16rem;
    overflow-y: auto;
    padding: 0.375rem;
    background: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-top: 0;
  }

  .flavor-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.5rem 0.625rem;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .flavor-input {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin: 0;
    accent-color: var(--color-primary);
    cursor: inherit;
  }

  .flavor-option:hover {
    background: rgba(255, 170, 248, 0.04);
  }

  .flavor-option:has(:checked) {
    color: var(--color-primary);
  }

  .flavor-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .flavor-option:has(:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .image-trigger {
    align-self: flex-start;
    color: var(--color-on-surface);
  }

  .image-list {
    display: flex;
    flex-direction: column;
