---
import { CAKE_FLAVORS } from '../../config/cakeFlavors';
import { CONTACT_IMAGES, MESSAGE_FALLBACK } from '../../config/contact';
import CakeCrossSection from '../offer/CakeCrossSection.astro';
---

<form class="contact-form" id="contact-form" data-contact-form novalidate>
  <div class="field">
    <div class="field overlay-field" data-state="empty">
      <label class="visually-hidden" for="contact-email">E-mail</label>
      <input
        class="field-control"
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        aria-describedby="contact-email-error"
      />
      <span class="field-overlay field-overlay-empty" aria-hidden="true"><span class="field-name">E-mail</span></span>
      <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">E-mail:</span>{' '}<span data-email-label></span></span>
    </div>
    <p class="field-error" id="contact-email-error"></p>
  </div>

  <div class="field overlay-field overlay-field-message" data-state="empty">
    <label class="visually-hidden" for="contact-message">Wiadomość, opcjonalnie</label>
    <textarea
      class="field-control field-textarea"
      id="contact-message"
      name="message"
      rows="5"
      placeholder={MESSAGE_FALLBACK}
    ></textarea>
    <span class="field-overlay field-overlay-empty" aria-hidden="true"><span class="field-name">Wiadomość</span>{' '}<span class="field-optional">— opcjonalnie</span></span>
    <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">Wiadomość:</span>{' '}<span data-message-label></span></span>
  </div>

  <div class="field-row">
    <div class="field overlay-field" data-state="empty">
      <label class="visually-hidden" for="contact-date">Termin, opcjonalnie</label>
      <input
        class="field-control"
        id="contact-date"
        name="date"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        maxlength="10"
        placeholder="yyyy/mm/dd"
      />
      <span class="field-overlay field-overlay-empty" aria-hidden="true">
        <span class="field-name">Termin</span>{' '}<span class="field-optional">— opcjonalnie</span>
      </span>
      <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">Termin:</span>{' '}<span data-date-label></span></span>
      <input class="date-native" type="date" tabindex="-1" aria-hidden="true" data-date-native />
      <button type="button" class="date-picker" aria-label="Wybierz termin z kalendarza" data-date-picker>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <div class="field overlay-field overlay-field-people" data-state="empty">
      <label class="visually-hidden" for="contact-people">Liczba osób, opcjonalnie</label>
      <input
        class="field-control"
        id="contact-people"
        name="people"
        type="number"
        min="1"
        step="1"
        inputmode="numeric"
      />
      <span class="field-overlay field-overlay-empty" aria-hidden="true">
        <span class="field-name">Liczba osób</span>{' '}<span class="field-optional">— opcjonalnie</span>
      </span>
      <span class="field-overlay field-overlay-filled" aria-hidden="true"><span class="field-name">Liczba osób:</span>{' '}<span data-people-label></span></span>
    </div>
  </div>

  <fieldset class="field" aria-label="Smak tortu">
    <div class="flavor-field" data-state="empty">
      <details class="flavor-dropdown">
        <summary class="field-control flavor-summary">
          <span class="flavor-summary-selection">
            <span class="field-name" data-flavor-prefix>Smak tortu</span>{' '}
            <span class="flavor-summary-value" data-flavor-value hidden></span>
            <span class="field-optional flavor-summary-optional" data-flavor-optional>— opcjonalnie</span>
          </span>
          <svg class="flavor-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </summary>
        <div class="flavor-options">
          {CAKE_FLAVORS.map((flavor) => (
            <label class="flavor-option">
              <input class="flavor-input" type="radio" name="flavor" value={flavor.name} />
              <span class="flavor-thumb"><CakeCrossSection flavor={flavor} /></span>
              <span class="flavor-option-name">{flavor.name}</span>
              <svg class="flavor-option-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3 8.5l3.2 3L13 4.5" />
              </svg>
            </label>
          ))}
        </div>
      </details>
      <button
        type="button"
        class="flavor-clear"
        aria-label="Wyczyść wybrany smak"
        data-flavor-clear
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 7l10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </fieldset>

  <div class="field">
    <input id="contact-images" type="file" accept={CONTACT_IMAGES.mimeTypes.join(',')} multiple hidden data-image-input />
    <div class="image-panel panel">
      <ul class="image-list" aria-label="Wybrane zdjęcia" data-image-list></ul>
    </div>
    <div class="contact-actions">
      <div class="image-actions">
        <button type="button" class="btn-secondary image-trigger" aria-describedby="contact-images-hint contact-images-error" data-image-trigger>Dodaj zdjęcie inspiracji</button>
        <div class="image-info-wrap" data-image-info-wrap>
          <button type="button" class="image-info" aria-label="Informacje o zdjęciach" aria-describedby="contact-images-hint" data-image-info>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 11v5M12 8h.01" />
            </svg>
          </button>
          <p class="image-hint" id="contact-images-hint" role="tooltip">
            JPEG, PNG lub WebP. Maksymalnie {CONTACT_IMAGES.maxCount} zdjęć, do {CONTACT_IMAGES.maxFileBytes / (1024 * 1024)} MB każde.
            Zdjęcia prześlemy po kliknięciu "Wyślij wiadomość". Każdy, kto ma link, może je wyświetlić.
          </p>
        </div>
      </div>
      <button type="submit" class="btn-primary email-submit">
        <svg
          class="email-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="1.5" y="4.5" width="21" height="15" rx="2.5" />
          <path d="M2 7.2 10.6 13a2.5 2.5 0 0 0 2.8 0L22 7.2" />
        </svg>
        Wyślij wiadomość
      </button>
    </div>
    <p class="field-error" id="contact-images-error" role="alert" data-image-error></p>
  </div>
</form>
<p class="form-status" role="status" aria-atomic="true" data-form-status></p>

<script>
  import { CONTACT_CHANNELS, type ContactChannelId } from '../../config/contact';
  import {
    EMAIL_SUBMIT_EVENT,
    channelSupportsPrefill,
    channelUrl,
    formatEnquiryText,
    hasCustomContent,
    isValidDate,
    isValidEmail,
    type EmailSubmitDetail,
    type EnquiryDraft,
  } from '../../utils/contactEnquiry';
  import { ContactSubmissionError, imageSelectionError, submitContactEnquiry, uploadContactImage } from '../../utils/contactSubmission';

  interface SelectedImage {
    file: File;
    url: string;
    uploadedUrl?: string;
  }

  let cleanupController: AbortController | null = null;

  const todayIso = () => {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    return now.toISOString().slice(0, 10);
  };

  const MONTHS = [
    'stycznia',
    'lutego',
    'marca',
    'kwietnia',
    'maja',
    'czerwca',
    'lipca',
    'sierpnia',
    'września',
    'października',
    'listopada',
    'grudnia',
  ];

  const dateLabel = (value: string) => {
    if (!isValidDate(value)) return value;
    const [year, month, day] = value.split('/').map(Number);
    return `${day} ${MONTHS[month - 1]} ${year}`;
  };

  const fileKey = (file: File) => `${file.name}:${file.size}:${file.lastModified}`;

  const emailErrorText = (value: string) => {
    if (!value.trim()) return 'Podaj adres e-mail, abym mogła odpowiedzieć.';
    return isValidEmail(value) ? '' : 'Sprawdź adres e-mail, np. anna@example.com.';
  };

  function initContactForm() {
    cleanupController?.abort();
    cleanupController = null;

    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const page = form?.closest<HTMLElement>('[data-contact-page]');
    if (!form || !page) return;

    cleanupController = new AbortController();
    const { signal } = cleanupController;
    const query = <T extends Element>(selector: string) => form.querySelector<T>(selector)!;
    const queryPage = <T extends Element>(selector: string) => page.querySelector<T>(selector)!;

    const email = query<HTMLInputElement>('#contact-email');
    const emailError = query<HTMLElement>('#contact-email-error');
    const message = query<HTMLTextAreaElement>('#contact-message');
    const emailDisplay = query<HTMLElement>('[data-email-label]');
    const messageDisplay = query<HTMLElement>('[data-message-label]');
    const date = query<HTMLInputElement>('#contact-date');
    const people = query<HTMLInputElement>('#contact-people');
    const dateDisplay = query<HTMLElement>('[data-date-label]');
    const dateNative = query<HTMLInputElement>('[data-date-native]');
    const datePicker = query<HTMLButtonElement>('[data-date-picker]');
    const peopleDisplay = query<HTMLElement>('[data-people-label]');
    const flavorField = query<HTMLElement>('.flavor-field');
    const flavorDropdown = query<HTMLDetailsElement>('.flavor-dropdown');
    const flavorSummaryControl = query<HTMLElement>('.flavor-summary');
    const flavorInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="flavor"]'));
    const flavorPrefix = query<HTMLElement>('[data-flavor-prefix]');
    const flavorValue = query<HTMLElement>('[data-flavor-value]');
    const flavorOptional = query<HTMLElement>('[data-flavor-optional]');
    const flavorClear = query<HTMLButtonElement>('[data-flavor-clear]');
    const imageInput = query<HTMLInputElement>('[data-image-input]');
    const imageTrigger = query<HTMLButtonElement>('[data-image-trigger]');
    const imageInfo = query<HTMLButtonElement>('[data-image-info]');
    const imageInfoWrap = query<HTMLElement>('[data-image-info-wrap]');
    const imageList = query<HTMLUListElement>('[data-image-list]');
    const imageError = query<HTMLElement>('[data-image-error]');
    const imagesNote = queryPage<HTMLElement>('[data-images-note]');
    const channelLinks = Array.from(page.querySelectorAll<HTMLAnchorElement>('a[data-channel]'));
    const handoff = queryPage<HTMLElement>('[data-handoff]');
    const handoffNames = Array.from(page.querySelectorAll<HTMLElement>('[data-handoff-channel]'));
    const handoffPreview = queryPage<HTMLTextAreaElement>('[data-handoff-preview]');
    const handoffCopy = queryPage<HTMLButtonElement>('[data-handoff-copy]');
    const handoffOpen = queryPage<HTMLAnchorElement>('[data-handoff-open]');
    const handoffStatus = queryPage<HTMLElement>('[data-handoff-status]');
    const formStatus = queryPage<HTMLElement>('[data-form-status]');

    let images: SelectedImage[] = [];
    let emailAttempted = false;
    let isSubmitting = false;

    const setStatus = (text: string, state = '') => {
      formStatus.textContent = text;
      formStatus.dataset.state = state;
    };

    dateNative.min = todayIso();

    const selectedFlavor = () => flavorInputs.find((input) => input.checked)?.value ?? '';

    const readDraft = (): EnquiryDraft => ({
      email: email.value.trim(),
      message: message.value,
      date: date.value,
      people: people.value,
      flavor: selectedFlavor(),
      images: images.map(({ file }) => file),
    });

    const showEmailError = (text: string) => {
      emailError.textContent = text;
      if (text) email.setAttribute('aria-invalid', 'true');
      else email.removeAttribute('aria-invalid');
    };

    const updateOverlays = () => {
      email.parentElement!.dataset.state = email.value ? 'filled' : 'empty';
      emailDisplay.textContent = email.value;
      message.parentElement!.dataset.state = message.value ? 'filled' : 'empty';
      messageDisplay.textContent = message.value;
      date.parentElement!.dataset.state = date.value ? 'filled' : 'empty';
      dateDisplay.textContent = date.value ? dateLabel(date.value) : '';
      people.parentElement!.dataset.state = people.value ? 'filled' : 'empty';
      peopleDisplay.textContent = people.value;
    };

    const updateFlavor = () => {
      const value = selectedFlavor();
      const filled = Boolean(value);
      flavorField.dataset.state = filled ? 'filled' : 'empty';
      flavorPrefix.textContent = filled ? 'Smak tortu:' : 'Smak tortu';
      flavorValue.textContent = value;
      flavorValue.hidden = !filled;
      flavorOptional.hidden = filled;
      flavorClear.hidden = !filled;
      flavorClear.disabled = isSubmitting;
      flavorInputs.forEach((input) => {
        input.disabled = isSubmitting;
      });
    };

    const refreshHandoff = () => {
      const text = formatEnquiryText(readDraft());
      channelLinks.forEach((link) => {
        const channel = CONTACT_CHANNELS.find(({ id }) => id === link.dataset.channel);
        const url = channel && channelUrl(channel, text);
        if (url) link.href = url;
      });
      if (!handoff.hidden) handoffPreview.value = text;
    };

    const renderImages = () => {
      imageList.replaceChildren(
        ...images.map(({ file, url }, index) => {
          const item = document.createElement('li');
          item.className = 'image-item';
          const thumb = document.createElement('img');
          thumb.className = 'image-thumb';
          thumb.src = url;
          thumb.alt = '';
          const name = document.createElement('span');
          name.className = 'image-name';
          name.textContent = file.name;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'image-remove';
          remove.dataset.removeIndex = String(index);
          remove.textContent = 'Usuń';
          remove.setAttribute('aria-label', `Usuń ${file.name}`);
          item.append(thumb, name, remove);
          return item;
        }),
      );
      if (images.length > 3) imageList.setAttribute('tabindex', '0');
      else imageList.removeAttribute('tabindex');
      imagesNote.hidden = images.length === 0;
    };

    date.addEventListener(
      'input',
      () => {
        const digits = date.value.replace(/\D/g, '').slice(0, 8);
        const masked = [digits.slice(0, 4), digits.slice(4, 6), digits.slice(6, 8)].filter(Boolean).join('/');
        if (masked !== date.value) date.value = masked;
        date.removeAttribute('aria-invalid');
      },
      { signal },
    );

    date.addEventListener(
      'blur',
      () => {
        if (date.value && !isValidDate(date.value)) date.setAttribute('aria-invalid', 'true');
      },
      { signal },
    );

    datePicker.addEventListener(
      'click',
      () => {
        dateNative.value = isValidDate(date.value) ? date.value.replaceAll('/', '-') : '';
        dateNative.showPicker();
      },
      { signal },
    );

    dateNative.addEventListener(
      'change',
      () => {
        date.value = dateNative.value.replaceAll('-', '/');
        date.removeAttribute('aria-invalid');
        date.dispatchEvent(new Event('input', { bubbles: true }));
      },
      { signal },
    );

    form.addEventListener(
      'input',
      () => {
        if (isSubmitting) return;
        updateOverlays();
        setStatus('');
        if (emailAttempted) showEmailError(emailErrorText(email.value));
        refreshHandoff();
      },
      { signal },
    );

    const closeFlavorDropdown = () => {
      if (!flavorDropdown.open) return;
      flavorDropdown.open = false;
      flavorSummaryControl.focus();
    };

    let arrowNavigating = false;

    flavorSummaryControl.addEventListener(
      'click',
      (event) => {
        if (isSubmitting) event.preventDefault();
      },
      { signal },
    );

    flavorDropdown.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp' || event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          arrowNavigating = true;
          return;
        }
        arrowNavigating = false;
        const target = event.target;
        if (target instanceof HTMLInputElement && target.name === 'flavor' && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          if (!target.disabled) {
            target.checked = true;
            setStatus('');
            updateFlavor();
            refreshHandoff();
            closeFlavorDropdown();
          }
        }
      },
      { signal },
    );

    flavorDropdown.addEventListener(
      'keyup',
      () => {
        arrowNavigating = false;
      },
      { signal },
    );

    flavorInputs.forEach((input) => {
      input.addEventListener(
        'change',
        () => {
          updateFlavor();
          refreshHandoff();
        },
        { signal },
      );

      input.addEventListener(
        'click',
        () => {
          if (arrowNavigating) {
            arrowNavigating = false;
            return;
          }
          setStatus('');
          updateFlavor();
          refreshHandoff();
          closeFlavorDropdown();
        },
        { signal },
      );
    });

    flavorClear.addEventListener(
      'click',
      () => {
        if (isSubmitting) return;
        flavorInputs.forEach((input) => {
          input.checked = false;
        });
        flavorDropdown.open = false;
        setStatus('');
        updateFlavor();
        refreshHandoff();
        flavorSummaryControl.focus();
      },
      { signal },
    );

    document.addEventListener(
      'click',
      (event) => {
        if (!flavorField.contains(event.target as Node | null)) flavorDropdown.open = false;
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && flavorDropdown.open) {
          event.preventDefault();
          closeFlavorDropdown();
        }
      },
      { signal },
    );

    imageInfoWrap.addEventListener('pointerenter', () => {
      delete imageInfoWrap.dataset.dismissed;
    }, { signal });
    imageInfo.addEventListener('focus', () => {
      delete imageInfoWrap.dataset.dismissed;
    }, { signal });
    imageInfo.addEventListener('blur', () => {
      imageInfoWrap.removeAttribute('data-open');
    }, { signal });
    imageInfo.addEventListener('click', () => {
      if (imageInfoWrap.hasAttribute('data-open')) {
        imageInfoWrap.removeAttribute('data-open');
        imageInfoWrap.dataset.dismissed = '';
      } else {
        delete imageInfoWrap.dataset.dismissed;
        imageInfoWrap.dataset.open = '';
      }
    }, { signal });
    document.addEventListener('pointerdown', (event) => {
      if (!imageInfoWrap.contains(event.target as Node)) {
        imageInfoWrap.removeAttribute('data-open');
        imageInfoWrap.dataset.dismissed = '';
      }
    }, { signal });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        imageInfoWrap.removeAttribute('data-open');
        imageInfoWrap.dataset.dismissed = '';
      }
    }, { signal });

    imageTrigger.addEventListener('click', () => imageInput.click(), { signal });

    imageInput.addEventListener(
      'change',
      () => {
        if (isSubmitting) return;
        const known = new Set(images.map(({ file }) => fileKey(file)));
        const additions = Array.from(imageInput.files ?? []).filter((file) => {
          const key = fileKey(file);
          if (known.has(key)) return false;
          known.add(key);
          return true;
        });
        const error = imageSelectionError([...images.map(({ file }) => file), ...additions]);
        imageInput.value = '';
        imageError.textContent = error;
        if (error) {
          imageTrigger.setAttribute('aria-invalid', 'true');
          return;
        }
        imageTrigger.removeAttribute('aria-invalid');
        setStatus('');
        additions.forEach((file) => {
          images.push({ file, url: URL.createObjectURL(file) });
        });
        renderImages();
      },
      { signal },
    );

    imageList.addEventListener(
      'click',
      (event) => {
        if (isSubmitting) return;
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-remove-index]');
        if (!button) return;
        const index = Number(button.dataset.removeIndex);
        URL.revokeObjectURL(images[index].url);
        images = images.filter((_, i) => i !== index);
        imageError.textContent = '';
        imageTrigger.removeAttribute('aria-invalid');
        setStatus('');
        renderImages();
        const next = imageList.querySelectorAll<HTMLButtonElement>('[data-remove-index]')[Math.min(index, images.length - 1)];
        (next ?? imageTrigger).focus();
      },
      { signal },
    );

    form.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();
        if (isSubmitting) return;
        emailAttempted = true;
        const error = emailErrorText(email.value);
        showEmailError(error);
        if (error) {
          setStatus('');
          email.focus();
          return;
        }

        const draft = readDraft();
        const handled = !form.dispatchEvent(
          new CustomEvent<EmailSubmitDetail>(EMAIL_SUBMIT_EVENT, {
            cancelable: true,
            detail: { draft, text: formatEnquiryText(draft) },
          }),
        );
        if (handled || signal.aborted) return;

        const controls = Array.from(
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>('input, textarea, button'),
          (control) => ({ control, disabled: control.disabled }),
        );
        isSubmitting = true;
        form.setAttribute('aria-busy', 'true');
        controls.forEach(({ control }) => { control.disabled = true; });
        flavorDropdown.open = false;

        try {
          const imageUrls: string[] = [];
          for (const [index, image] of images.entries()) {
            setStatus(`Przesyłanie zdjęć (${index + 1} z ${images.length})...`);
            image.uploadedUrl ??= await uploadContactImage(image.file, signal);
            imageUrls.push(image.uploadedUrl);
          }
          setStatus('Wysyłanie wiadomości...');
          await submitContactEnquiry(draft, imageUrls, signal);
          if (signal.aborted) return;

          form.reset();
          images.forEach(({ url }) => URL.revokeObjectURL(url));
          images = [];
          emailAttempted = false;
          showEmailError('');
          imageError.textContent = '';
          imageTrigger.removeAttribute('aria-invalid');
          date.removeAttribute('aria-invalid');
          handoff.hidden = true;
          handoffPreview.value = '';
          handoffStatus.textContent = '';
          renderImages();
          updateOverlays();
          updateFlavor();
          refreshHandoff();
          setStatus('Dziękuję! Twoje zapytanie zostało przyjęte. Odpowiem na podany adres e-mail.', 'success');
        } catch (error) {
          if (signal.aborted) return;
          setStatus(
            error instanceof ContactSubmissionError && error.stage === 'upload'
              ? 'Nie udało się przesłać zdjęć. Dane zostały w formularzu. Spróbuj ponownie.'
              : 'Nie udało się potwierdzić wysyłki. Dane zostały w formularzu. Spróbuj ponownie lub skontaktuj się bezpośrednio.',
            'error',
          );
        } finally {
          isSubmitting = false;
          if (!signal.aborted) {
            form.removeAttribute('aria-busy');
            controls.forEach(({ control, disabled }) => { control.disabled = disabled; });
            updateFlavor();
          }
        }
      },
      { signal },
    );

    channelLinks.forEach((link) =>
      link.addEventListener(
        'click',
        (event) => {
          refreshHandoff();
          const draft = readDraft();
          if (channelSupportsPrefill(link.dataset.channel as ContactChannelId) || !hasCustomContent(draft)) return;

          event.preventDefault();
          handoffNames.forEach((name) => {
            name.textContent = link.dataset.label ?? '';
          });
          handoffOpen.href = link.href;
          handoffStatus.textContent = '';
          handoff.hidden = false;
          handoffPreview.value = formatEnquiryText(draft);
          handoffCopy.focus();
        },
        { signal },
      ),
    );

    handoffCopy.addEventListener(
      'click',
      async () => {
        try {
          await navigator.clipboard.writeText(handoffPreview.value);
          handoffStatus.textContent = 'Skopiowano treść.';
        } catch {
          handoffPreview.focus();
          handoffPreview.select();
          handoffStatus.textContent = 'Nie udało się skopiować automatycznie. Treść jest zaznaczona — skopiuj ją ręcznie.';
        }
      },
      { signal },
    );

    signal.addEventListener('abort', () => {
      images.forEach(({ url }) => URL.revokeObjectURL(url));
      images = [];
    }, { once: true });

    updateOverlays();
    updateFlavor();
    refreshHandoff();
  }

  document.addEventListener('astro:page-load', initContactForm);
  document.addEventListener('astro:before-swap', () => {
    cleanupController?.abort();
    cleanupController = null;
  });
</script>

