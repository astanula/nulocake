---
/**
 * Animated "scroll down" hint for section navigation.
 * Page controllers wire `[data-scroll-hint]` and toggle its visibility.
 * The navigation rail supplies the sizing and alignment variables.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Następna sekcja', class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={['scroll-hint', 'is-hidden', className]}
  data-scroll-hint
  aria-label={label}
  inert
  {...rest}
>
  <span class="scroll-hint-track" aria-hidden="true">
    <span class="scroll-hint-chevron"></span>
    <span class="scroll-hint-chevron scroll-hint-chevron--delayed"></span>
  </span>
</button>

<style>
  .scroll-hint {
    position: relative;
    display: block;
    width: 44px;
    height: var(--hint-target-height);
    padding: 0;
    color: var(--color-on-surface);
    background: none;
    border: none;
    border-radius: 0.25rem;
    cursor: pointer;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 0.3s, color 0.2s, box-shadow 0.2s;
  }

  .scroll-hint:hover,
  .scroll-hint:focus-visible {
    color: var(--color-primary);
  }

  .scroll-hint:focus-visible {
    box-shadow: 0 0 0 2px var(--color-primary);
  }

  .scroll-hint.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .scroll-hint-track {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    width: 100%;
    height: var(--hint-track-height);
    transform: translateY(-50%);
  }

  /* Down chevron: right + bottom borders of a square rotated 45°. */
  .scroll-hint-chevron {
    position: absolute;
    left: var(--hint-axis);
    top: 50%;
    width: calc(var(--scroll-hint-width) * 0.707107);
    height: calc(var(--scroll-hint-width) * 0.707107);
    border: calc(var(--scroll-hint-width) * 0.176777) solid;
    border-color: transparent currentColor currentColor transparent;
    opacity: 0;
    animation: scroll-hint-slide 2s linear infinite;
  }

  .scroll-hint-chevron--delayed {
    animation-delay: -1s;
  }

  @keyframes scroll-hint-slide {
    0%   { opacity: 0; transform: translate(-50%, calc(-50% - var(--hint-travel))) rotate(45deg); }
    20%  { opacity: 1; transform: translate(-50%, calc(-50% - var(--hint-travel) * 0.6)) rotate(45deg); }
    80%  { opacity: 1; transform: translate(-50%, calc(-50% + var(--hint-travel) * 0.6)) rotate(45deg); }
    100% { opacity: 0; transform: translate(-50%, calc(-50% + var(--hint-travel))) rotate(45deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-chevron {
      opacity: 1;
      animation: none;
      transform: translate(-50%, -50%) rotate(45deg);
    }

    .scroll-hint-chevron--delayed {
      display: none;
    }
  }
</style>
