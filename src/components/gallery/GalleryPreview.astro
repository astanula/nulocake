---
import {
  PREVIEW_MARGIN_TOP,
  PREVIEW_MARGIN_BOTTOM,
  PREVIEW_COUNTER_GAP,
  PREVIEW_COUNTER_FONT_SIZE,
  PREVIEW_THUMB_SIZE,
  PREVIEW_THUMB_ACTIVE_SCALE,
  PREVIEW_THUMB_SIDE_OPACITY,
  PREVIEW_PEEK_OPACITY,
  PREVIEW_PEEK_WIDTH_RATIO,
  PREVIEW_PEEK_HEIGHT_RATIO,
  PREVIEW_BACKDROP_BLUR,
  PREVIEW_BACKDROP_DIM,
  PREVIEW_COUNTER_OPACITY
} from '../../config/gallery';
---

<dialog id="gallery-preview" class="gallery-preview" aria-modal="true" aria-roledescription="Podgląd galerii" aria-label="Podgląd galerii">
  <div class="preview-backdrop" aria-hidden="true">
    <img id="preview-backdrop-image" src="" alt="" decoding="async" />
  </div>
  <div class="preview-content">
    <button id="preview-close" type="button" class="preview-close" aria-label="Zamknij podgląd (Esc)">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="preview-layout">
      <div class="preview-main-row">
        <button id="preview-prev" type="button" class="preview-arrow" aria-label="Poprzednie zdjęcie">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="hero-peek-group">
          <button type="button" class="preview-peek peek-left" data-offset="-1" aria-label="Poprzednie zdjęcie">
            <img src="" alt="" />
          </button>

          <div class="hero-stage">
            <div id="preview-spinner" class="spinner" aria-hidden="true"></div>
            <img id="preview-hero-image" src="" alt="" decoding="async" />

            <div class="thumbnail-strip">
              <button type="button" class="thumbnail-slot" data-offset="-2"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot" data-offset="-1"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot is-active" data-offset="0"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot" data-offset="1"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot" data-offset="2"><img src="" alt="" decoding="async" /></button>
            </div>
          </div>

          <button type="button" class="preview-peek peek-right" data-offset="1" aria-label="Następne zdjęcie">
            <img src="" alt="" />
          </button>
        </div>

        <button id="preview-next" type="button" class="preview-arrow" aria-label="Następne zdjęcie">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div id="preview-counter" class="preview-counter" aria-live="polite">
        <span class="sr-only" id="preview-sr-counter">Zdjęcie 1 z 1</span>
        <span aria-hidden="true"><span id="preview-current-index">1</span> / <span id="preview-total-count">1</span></span>
      </div>
    </div>
  </div>
</dialog>

<style define:vars={{
  marginTop: PREVIEW_MARGIN_TOP,
  marginBottom: PREVIEW_MARGIN_BOTTOM,
  counterGap: PREVIEW_COUNTER_GAP,
  counterFontSize: PREVIEW_COUNTER_FONT_SIZE,
  thumbSize: PREVIEW_THUMB_SIZE,
  thumbActiveScale: PREVIEW_THUMB_ACTIVE_SCALE,
  thumbSideOpacity: PREVIEW_THUMB_SIDE_OPACITY,
  peekOpacity: PREVIEW_PEEK_OPACITY,
  peekWidthRatio: PREVIEW_PEEK_WIDTH_RATIO,
  peekHeightRatio: PREVIEW_PEEK_HEIGHT_RATIO,
  backdropBlur: PREVIEW_BACKDROP_BLUR,
  backdropDim: PREVIEW_BACKDROP_DIM,
  counterOpacity: PREVIEW_COUNTER_OPACITY
}}>
  .gallery-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: white;
    z-index: 1000;
  }

  .gallery-preview::backdrop {
    background: var(--backdropDim);
  }

  .preview-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  #preview-backdrop-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(var(--backdropBlur)) brightness(0.5);
    transform: scale(1.1);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #preview-backdrop-image.is-loaded {
    opacity: 1;
  }

  .preview-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .preview-close {
    position: absolute;
    top: max(var(--marginTop), env(safe-area-inset-top));
    right: 1.5rem;
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    z-index: 10;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    opacity: 0.7;
  }

  .preview-close:hover {
    opacity: 1;
  }

  .preview-layout {
    position: absolute;
    top: var(--marginTop);
    bottom: var(--marginBottom);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--counterGap);
    max-width: 100vw;
    min-height: 0;
    --hero-max-height: calc(100vh - var(--marginTop) - var(--marginBottom) - var(--counterGap) - var(--counterFontSize));
  }

  .preview-main-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
  }

  .hero-peek-group {
    position: relative;
    display: inline-block;
    width: var(--hero-width);
    max-width: 100%;
    max-height: var(--hero-max-height);
    min-height: 0;
    line-height: 0;
    --hero-width: 0px;
    --hero-height: 0px;
  }

  .hero-stage {
    position: relative;
    display: block;
    width: 100%;
    min-height: 0;
    min-width: 0;
    max-height: var(--hero-max-height);
    line-height: 0;
  }

  #preview-hero-image {
    max-width: 70vw;
    max-height: var(--hero-max-height);
    width: auto;
    height: auto;
    display: block;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 0;
  }

  #preview-hero-image.is-loaded {
    opacity: 1;
  }

  .spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: white;
    animation: spin 1s ease-in-out infinite;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .spinner.is-visible {
    opacity: 1;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .preview-peek {
    position: absolute;
    top: 50%;
    height: calc(var(--peekHeightRatio) * var(--hero-height));
    transform: translateY(-50%);
    width: calc(var(--peekWidthRatio) * var(--hero-width));
    margin: 0;
    cursor: pointer;
    opacity: var(--peekOpacity);
    transition: opacity 0.3s ease;
    overflow: hidden;
    background: transparent;
    border: none;
    padding: 0;
  }

  .peek-left {
    right: 100%;
    left: auto;
    border-top-left-radius: var(--gallery-image-radius, 8px);
    border-bottom-left-radius: var(--gallery-image-radius, 8px);
  }

  .peek-right {
    left: 100%;
    right: auto;
    border-top-right-radius: var(--gallery-image-radius, 8px);
    border-bottom-right-radius: var(--gallery-image-radius, 8px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .peek-left img {
    object-position: right center;
  }

  .peek-right img {
    object-position: left center;
  }

  .preview-peek:hover {
    opacity: 0.7;
  }

  .preview-peek img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-counter {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-size: var(--counterFontSize);
    line-height: 1;
    opacity: var(--counterOpacity);
  }

  .thumbnail-strip {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .thumbnail-slot {
    background: transparent;
    border: none;
    padding: 0;
    width: var(--thumbSize);
    height: var(--thumbSize);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    opacity: var(--thumbSideOpacity);
    transition: all 0.3s ease;
  }

  .thumbnail-slot:hover {
    opacity: 0.8;
  }

  .thumbnail-slot.is-active {
    opacity: 1;
    transform: scale(var(--thumbActiveScale));
    border: 2px solid white;
    cursor: default;
  }

  .thumbnail-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-arrow {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    align-self: center;
    margin: 0 1.5rem;
  }

  .preview-arrow:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
  }

  .preview-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
</style>

<script>
  let dialog: HTMLDialogElement | null = null;
  let heroImage: HTMLImageElement | null = null;
  let backdropImage: HTMLImageElement | null = null;
  let spinner: HTMLElement | null = null;
  let closeBtn: HTMLButtonElement | null = null;
  let prevBtn: HTMLButtonElement | null = null;
  let nextBtn: HTMLButtonElement | null = null;
  let currentIndexEl: HTMLElement | null = null;
  let totalCountEl: HTMLElement | null = null;
  let scrollContainer: HTMLElement | null = null;
  let peeks: HTMLElement[] = [];
  let thumbnails: HTMLElement[] = [];
  let heroPeekGroup: HTMLElement | null = null;
  let heroResizeObserver: ResizeObserver | null = null;
  let manifest: any[] = [];
  let currentIndex = 0;
  let lastActiveElement: HTMLElement | null = null;
  let isSwapping = false;

  function closePreview() {
    if (dialog && dialog.open) {
      dialog.close();
    }
  }

  function handleBackdropClick(e: MouseEvent) {
    // Treat clicks on the backdrop image behind the hero exactly like clicks on the dialog
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest('.preview-backdrop')) {
      closePreview();
    }
  }

  function handleDialogClose() {
    if (scrollContainer) {
      scrollContainer.style.overflow = '';
    }
    if (heroImage) {
      heroImage.src = '';
      heroImage.classList.remove('is-loaded');
    }
    if (backdropImage) {
      backdropImage.src = '';
      backdropImage.classList.remove('is-loaded');
    }
    // Only go back if we are currently holding the history state and not swapping pages
    if (!isSwapping && history.state && history.state.galleryPreview) {
      history.back();
    }

    // Restore focus to the opener element
    if (lastActiveElement) {
      lastActiveElement.focus();
      lastActiveElement = null;
    } else {
      const wrapper = document.querySelector(`.gallery-image-wrapper[data-original-index="${currentIndex}"]`) as HTMLElement;
      if (wrapper) {
        wrapper.focus();
      }
    }
  }

  function handlePopState(e: PopStateEvent) {
    // If the state no longer has galleryPreview, close the modal
    if (!e.state || !e.state.galleryPreview) {
      if (dialog && dialog.open) {
        dialog.close();
      }
    }
  }

  function syncHeroPeekSizing() {
    if (!heroImage || !heroPeekGroup) return;
    const { width, height } = heroImage.getBoundingClientRect();
    heroPeekGroup.style.setProperty('--hero-width', `${width}px`);
    heroPeekGroup.style.setProperty('--hero-height', `${height}px`);
  }

  function setupHeroResizeObserver() {
    heroResizeObserver?.disconnect();
    if (!heroImage) return;

    heroResizeObserver = new ResizeObserver(() => {
      syncHeroPeekSizing();
    });
    heroResizeObserver.observe(heroImage);
  }

  function preloadImage(index: number) {
    if (index >= 0 && index < manifest.length) {
      const img = new Image();
      img.src = manifest[index].src;
    }
  }

  async function updatePreviewState() {
    if (!dialog || !heroImage || !spinner || !backdropImage) return;

    const imageData = manifest[currentIndex];
    if (!imageData) return;

    // Update Counter
    if (currentIndexEl) currentIndexEl.textContent = (currentIndex + 1).toString();
    if (totalCountEl) totalCountEl.textContent = manifest.length.toString();
    const srCounter = document.getElementById('preview-sr-counter');
    if (srCounter) {
      srCounter.textContent = `Zdjęcie ${currentIndex + 1} z ${manifest.length}: ${imageData.alt}`;
    }

    // Update Buttons
    if (prevBtn) prevBtn.disabled = currentIndex === 0;
    if (nextBtn) nextBtn.disabled = currentIndex === manifest.length - 1;

    // Update Peeks
    peeks.forEach(peek => {
      const offset = parseInt(peek.dataset.offset || '0', 10);
      const targetIndex = currentIndex + offset;
      const img = peek.querySelector('img');
      if (targetIndex >= 0 && targetIndex < manifest.length && img) {
        img.src = manifest[targetIndex].peekSrc || manifest[targetIndex].src;
        img.alt = manifest[targetIndex].alt || '';
        peek.setAttribute('aria-label', `${offset === -1 ? 'Poprzednie' : 'Następne'} zdjęcie: ${manifest[targetIndex].alt}`);
        peek.style.visibility = 'visible';
      } else {
        peek.style.visibility = 'hidden';
      }
    });

    // Update Thumbnails
    thumbnails.forEach(thumb => {
      const offset = parseInt(thumb.dataset.offset || '0', 10);
      const targetIndex = currentIndex + offset;
      const img = thumb.querySelector('img');
      if (targetIndex >= 0 && targetIndex < manifest.length && img) {
        img.src = manifest[targetIndex].thumbSrc || manifest[targetIndex].src;
        img.alt = manifest[targetIndex].alt || '';
        thumb.setAttribute('aria-label', `Pokaż zdjęcie ${targetIndex + 1} z ${manifest.length}: ${manifest[targetIndex].alt}`);
        thumb.style.display = 'block';
      } else {
        thumb.style.display = 'none';
      }
    });

    spinner.classList.add('is-visible');
    heroImage.classList.remove('is-loaded');
    backdropImage.classList.remove('is-loaded');

    try {
      heroImage.src = imageData.src;
      heroImage.alt = imageData.alt || '';
      backdropImage.src = imageData.src;
      await Promise.all([
        heroImage.decode().catch(() => {}),
        backdropImage.decode().catch(() => {})
      ]);
    } catch (error) {
      console.error('Image update failed', error);
    } finally {
      spinner.classList.remove('is-visible');
      heroImage.classList.add('is-loaded');
      backdropImage.classList.add('is-loaded');
      syncHeroPeekSizing();
    }

    // Preload adjacent images
    preloadImage(currentIndex - 1);
    preloadImage(currentIndex + 1);
  }

  function navigate(direction: number) {
    if (manifest.length === 0) return;
    const newIndex = currentIndex + direction;
    if (newIndex >= 0 && newIndex < manifest.length) {
      currentIndex = newIndex;
      updatePreviewState();
    }
  }

  function handlePrevClick() { navigate(-1); }
  function handleNextClick() { navigate(1); }

  function handleKeyDown(e: KeyboardEvent) {
    if (!dialog || !dialog.open) return;
    switch (e.key) {
      case 'ArrowLeft':
        navigate(-1);
        break;
      case 'ArrowRight':
        navigate(1);
        break;
      case 'Home':
        navigate(-currentIndex);
        break;
      case 'End':
        navigate(manifest.length - 1 - currentIndex);
        break;
    }
  }

  async function openPreview(index: number) {
    if (!dialog || !heroImage || !spinner) return;
    
    lastActiveElement = document.activeElement as HTMLElement;

    if (manifest.length === 0) {
      const manifestScript = document.getElementById('gallery-manifest');
      if (manifestScript) {
        try {
          manifest = JSON.parse(manifestScript.textContent || '[]');
        } catch (e) {
          console.error('Failed to parse gallery manifest', e);
          return;
        }
      }
    }

    if (scrollContainer) {
      scrollContainer.style.overflow = 'hidden';
    }

    // Push history state
    if (!history.state || !history.state.galleryPreview) {
      history.pushState({ ...history.state, galleryPreview: true }, '');
    }

    dialog.showModal();
    currentIndex = index;
    updatePreviewState();
  }

  function handleCustomOpen(e: Event) {
    const customEvent = e as CustomEvent;
    if (customEvent.detail && typeof customEvent.detail.index === 'number') {
      openPreview(customEvent.detail.index);
    }
  }

  function cleanupPreview() {
    heroResizeObserver?.disconnect();
    heroResizeObserver = null;
    window.removeEventListener('gallery:open-preview', handleCustomOpen);
    window.removeEventListener('keydown', handleKeyDown);
    window.removeEventListener('popstate', handlePopState);
    document.removeEventListener('astro:before-swap', handleBeforeSwap);
  }

  function handleBeforeSwap() {
    isSwapping = true;
    closePreview();
    if (scrollContainer) {
      scrollContainer.style.overflow = '';
    }
    cleanupPreview();
  }

  function setupPreview() {
    isSwapping = false;
    dialog = document.getElementById('gallery-preview') as HTMLDialogElement;
    heroImage = document.getElementById('preview-hero-image') as HTMLImageElement;
    backdropImage = document.getElementById('preview-backdrop-image') as HTMLImageElement;
    spinner = document.getElementById('preview-spinner');
    closeBtn = document.getElementById('preview-close') as HTMLButtonElement;
    prevBtn = document.getElementById('preview-prev') as HTMLButtonElement;
    nextBtn = document.getElementById('preview-next') as HTMLButtonElement;
    currentIndexEl = document.getElementById('preview-current-index');
    totalCountEl = document.getElementById('preview-total-count');
    scrollContainer = document.querySelector('.scroll-container');
    peeks = Array.from(document.querySelectorAll('.preview-peek'));
    thumbnails = Array.from(document.querySelectorAll('.thumbnail-slot'));
    heroPeekGroup = document.querySelector('.hero-peek-group');

    if (!dialog) return;

    setupHeroResizeObserver();
    syncHeroPeekSizing();

    peeks.forEach(peek => {
      const offset = parseInt(peek.dataset.offset || '0', 10);
      peek.onclick = () => navigate(offset);
    });

    thumbnails.forEach(thumb => {
      const offset = parseInt(thumb.dataset.offset || '0', 10);
      thumb.onclick = () => {
        if (offset !== 0) navigate(offset);
      };
    });

    // Remove old listeners to avoid duplicates during Astro view transitions
    window.removeEventListener('gallery:open-preview', handleCustomOpen);
    window.addEventListener('gallery:open-preview', handleCustomOpen);

    dialog.removeEventListener('close', handleDialogClose);
    dialog.addEventListener('close', handleDialogClose);

    dialog.removeEventListener('click', handleBackdropClick);
    dialog.addEventListener('click', handleBackdropClick);

    if (closeBtn) {
      closeBtn.removeEventListener('click', closePreview);
      closeBtn.addEventListener('click', closePreview);
    }

    if (prevBtn) {
      prevBtn.removeEventListener('click', handlePrevClick);
      prevBtn.addEventListener('click', handlePrevClick);
    }

    if (nextBtn) {
      nextBtn.removeEventListener('click', handleNextClick);
      nextBtn.addEventListener('click', handleNextClick);
    }

    window.removeEventListener('keydown', handleKeyDown);
    window.addEventListener('keydown', handleKeyDown);

    window.removeEventListener('popstate', handlePopState);
    window.addEventListener('popstate', handlePopState);

    document.removeEventListener('astro:before-swap', handleBeforeSwap);
    document.addEventListener('astro:before-swap', handleBeforeSwap);
  }

  // Set up listeners on initial load and view transition page loads
  document.addEventListener('astro:page-load', setupPreview);
</script>
