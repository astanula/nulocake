---
import {
  PREVIEW_MARGIN_TOP,
  PREVIEW_MARGIN_BOTTOM,
  PREVIEW_COUNTER_GAP,
  PREVIEW_COUNTER_FONT_SIZE,
  PREVIEW_THUMB_SIZE,
  PREVIEW_THUMB_ACTIVE_SCALE,
  PREVIEW_THUMB_SIDE_OPACITY,
  PREVIEW_PEEK_OPACITY,
  PREVIEW_PEEK_WIDTH_RATIO,
  PREVIEW_PEEK_HEIGHT_RATIO,
  PREVIEW_BACKDROP_BLUR,
  PREVIEW_BACKDROP_DIM,
  PREVIEW_COUNTER_OPACITY,
  PREVIEW_OPEN_SHIFT_DURATION,
  PREVIEW_OPEN_HERO_BACKDROP_DURATION,
  PREVIEW_OPEN_CHROME_DURATION,
  PREVIEW_OPEN_EASE
} from '../../config/gallery';
---

<dialog id="gallery-preview" class="gallery-preview" aria-modal="true" aria-roledescription="Podgląd galerii" aria-label="Podgląd galerii">
  <div class="preview-backdrop" aria-hidden="true">
    <img id="preview-backdrop-image" src="" alt="" decoding="async" />
    <div id="preview-backdrop-dim" class="preview-backdrop-dim"></div>
  </div>
  <div id="preview-fly-layer" aria-hidden="true"></div>
  <div class="preview-content">
    <button id="preview-close" type="button" class="preview-close preview-chrome" aria-label="Zamknij podgląd (Esc)">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="preview-layout">
      <div class="preview-main-row">
        <button id="preview-prev" type="button" class="preview-arrow preview-chrome" aria-label="Poprzednie zdjęcie">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="hero-peek-group">
          <button type="button" class="preview-peek peek-left preview-chrome" data-offset="-1" aria-label="Poprzednie zdjęcie">
            <img src="" alt="" />
          </button>

          <div class="hero-stage">
            <img id="preview-hero-image" src="" alt="" decoding="async" />

            <div class="thumbnail-strip preview-chrome">
              <button type="button" class="thumbnail-slot" data-offset="-2"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot" data-offset="-1"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot is-active" data-offset="0"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot" data-offset="1"><img src="" alt="" decoding="async" /></button>
              <button type="button" class="thumbnail-slot" data-offset="2"><img src="" alt="" decoding="async" /></button>
            </div>
          </div>

          <button type="button" class="preview-peek peek-right preview-chrome" data-offset="1" aria-label="Następne zdjęcie">
            <img src="" alt="" />
          </button>
        </div>

        <button id="preview-next" type="button" class="preview-arrow preview-chrome" aria-label="Następne zdjęcie">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div id="preview-counter" class="preview-counter preview-chrome" aria-live="polite">
        <span class="sr-only" id="preview-sr-counter">Zdjęcie 1 z 1</span>
        <span aria-hidden="true"><span id="preview-current-index">1</span> / <span id="preview-total-count">1</span></span>
      </div>
    </div>
  </div>
</dialog>

<style define:vars={{
  marginTop: PREVIEW_MARGIN_TOP,
  marginBottom: PREVIEW_MARGIN_BOTTOM,
  counterGap: PREVIEW_COUNTER_GAP,
  counterFontSize: PREVIEW_COUNTER_FONT_SIZE,
  thumbSize: PREVIEW_THUMB_SIZE,
  thumbActiveScale: PREVIEW_THUMB_ACTIVE_SCALE,
  thumbSideOpacity: PREVIEW_THUMB_SIDE_OPACITY,
  peekOpacity: PREVIEW_PEEK_OPACITY,
  peekWidthRatio: PREVIEW_PEEK_WIDTH_RATIO,
  peekHeightRatio: PREVIEW_PEEK_HEIGHT_RATIO,
  backdropBlur: PREVIEW_BACKDROP_BLUR,
  backdropDim: PREVIEW_BACKDROP_DIM,
  counterOpacity: PREVIEW_COUNTER_OPACITY
}}>
  .gallery-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: white;
    z-index: 1000;
  }

  .gallery-preview::backdrop {
    background: transparent;
  }

  .preview-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #preview-backdrop-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(var(--backdropBlur)) brightness(0.5);
    transform: scale(1.1);
    opacity: 0;
  }

  .preview-backdrop-dim {
    position: absolute;
    inset: 0;
    background: var(--backdropDim);
    opacity: 0;
    pointer-events: none;
  }

  #preview-fly-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  #preview-fly-layer img {
    position: fixed;
    object-fit: cover;
    border-radius: var(--gallery-image-radius, 8px);
    margin: 0;
  }

  .preview-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
  }

  .preview-close {
    position: absolute;
    top: max(var(--marginTop), env(safe-area-inset-top));
    right: 1.5rem;
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    z-index: 10;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }

  .preview-close:hover {
    opacity: 1;
  }

  .preview-layout {
    position: absolute;
    top: var(--marginTop);
    bottom: var(--marginBottom);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--counterGap);
    max-width: 100vw;
    min-height: 0;
    --hero-max-height: calc(100vh - var(--marginTop) - var(--marginBottom) - var(--counterGap) - var(--counterFontSize));
  }

  .preview-main-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
  }

  .hero-peek-group {
    position: relative;
    display: inline-block;
    width: var(--hero-width);
    max-width: 100%;
    max-height: var(--hero-max-height);
    min-height: 0;
    line-height: 0;
    --hero-width: 0px;
    --hero-height: 0px;
    --peek-slide-offset: 48px;
  }

  .hero-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 0;
    min-width: 0;
    max-height: var(--hero-max-height);
    line-height: 0;
  }

  #preview-hero-image {
    max-width: 70vw;
    max-height: var(--hero-max-height);
    width: auto;
    height: auto;
    display: block;
    opacity: 0;
    border-radius: 0;
  }

  .preview-peek {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: calc(var(--peekHeightRatio) * var(--hero-height));
    width: calc(var(--peekWidthRatio) * var(--hero-width));
    margin: 0;
    cursor: pointer;
    opacity: 0;
    overflow: hidden;
    background: transparent;
    border: none;
    padding: 0;
  }

  .peek-left {
    right: 100%;
    left: auto;
    border-top-left-radius: var(--gallery-image-radius, 8px);
    border-bottom-left-radius: var(--gallery-image-radius, 8px);
  }

  .peek-right {
    left: 100%;
    right: auto;
    border-top-right-radius: var(--gallery-image-radius, 8px);
    border-bottom-right-radius: var(--gallery-image-radius, 8px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .peek-left img {
    object-position: right center;
  }

  .peek-right img {
    object-position: left center;
  }

  .preview-peek:hover {
    opacity: 0.7;
  }

  .preview-peek img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-counter {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-size: var(--counterFontSize);
    line-height: 1;
    opacity: 0;
  }

  .preview-counter.preview-chrome.is-settled {
    opacity: var(--counterOpacity);
  }

  .thumbnail-strip {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform-origin: center bottom;
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .thumbnail-slot {
    background: transparent;
    border: none;
    padding: 0;
    width: var(--thumbSize);
    height: var(--thumbSize);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    opacity: var(--thumbSideOpacity);
  }

  .thumbnail-slot:hover {
    opacity: 0.8;
  }

  .thumbnail-slot.is-active {
    opacity: 1;
    transform: scale(var(--thumbActiveScale));
    border: 2px solid white;
    cursor: default;
  }

  .thumbnail-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-arrow {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    margin: 0 1.5rem;
    opacity: 0;
  }

  .preview-arrow:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
  }

  .preview-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
</style>

<script>
  import gsap from 'gsap';
  import {
    PREVIEW_OPEN_SHIFT_DURATION,
    PREVIEW_OPEN_HERO_BACKDROP_DURATION,
    PREVIEW_OPEN_CHROME_DURATION,
    PREVIEW_OPEN_EASE,
    PREVIEW_PEEK_OPACITY
  } from '../../config/gallery';

  type ManifestEntry = {
    src: string;
    peekSrc?: string;
    thumbSrc?: string;
    gridSrc?: string;
    alt: string;
    width: number;
    height: number;
    originalIndex: number;
  };

  let dialog: HTMLDialogElement | null = null;
  let heroImage: HTMLImageElement | null = null;
  let backdropImage: HTMLImageElement | null = null;
  let backdropDim: HTMLElement | null = null;
  let backdropLayer: HTMLElement | null = null;
  let flyLayer: HTMLElement | null = null;
  let closeBtn: HTMLButtonElement | null = null;
  let prevBtn: HTMLButtonElement | null = null;
  let nextBtn: HTMLButtonElement | null = null;
  let currentIndexEl: HTMLElement | null = null;
  let totalCountEl: HTMLElement | null = null;
  let scrollContainer: HTMLElement | null = null;
  let previewLayout: HTMLElement | null = null;
  let heroStage: HTMLElement | null = null;
  let thumbStrip: HTMLElement | null = null;
  let peeks: HTMLElement[] = [];
  let thumbnails: HTMLElement[] = [];
  let chromeEls: HTMLElement[] = [];
  let heroPeekGroup: HTMLElement | null = null;
  let heroResizeObserver: ResizeObserver | null = null;
  let manifest: ManifestEntry[] = [];
  let currentIndex = 0;
  let lastActiveElement: HTMLElement | null = null;
  let isSwapping = false;
  let isChoreographyActive = false;
  let openTimeline: gsap.core.Timeline | null = null;
  let closeTimeline: gsap.core.Timeline | null = null;
  let flyClone: HTMLImageElement | null = null;
  let centeredTileWidth = 0;
  let centeredTileHeight = 0;
  let finalHeroWidth = 0;
  let finalHeroHeight = 0;
  const pendingSwapTargets = new WeakMap<HTMLImageElement, string>();

  function computeFinalHeroSize(
    naturalW: number,
    naturalH: number,
    maxW: number,
    maxH: number
  ): { width: number; height: number } {
    if (naturalW <= 0 || naturalH <= 0) {
      return { width: maxW, height: maxH };
    }
    const scale = Math.min(maxW / naturalW, maxH / naturalH, 1);
    return {
      width: Math.round(naturalW * scale),
      height: Math.round(naturalH * scale)
    };
  }

  function getHeroMaxBox(): { maxW: number; maxH: number } {
    const maxH = previewLayout
      ? parseFloat(getComputedStyle(previewLayout).getPropertyValue('--hero-max-height')) || window.innerHeight * 0.7
      : window.innerHeight * 0.7;
    const stageW = heroStage?.clientWidth ?? window.innerWidth;
    const maxW = Math.min(window.innerWidth * 0.7, stageW);
    return { maxW, maxH };
  }

  function getTileRect(opener: HTMLElement): DOMRect | null {
    const img = opener.querySelector('.gallery-image') as HTMLImageElement | null;
    return img?.getBoundingClientRect() ?? null;
  }

  function getHeroStageCenter(): { centerX: number; centerY: number } {
    const rect = heroStage?.getBoundingClientRect();
    if (!rect) {
      return { centerX: window.innerWidth / 2, centerY: window.innerHeight / 2 };
    }
    return {
      centerX: rect.left + rect.width / 2,
      centerY: rect.top + rect.height / 2
    };
  }

  function silentSwapSrc(img: HTMLImageElement, url: string, alt?: string): void {
    if (!url) return;
    pendingSwapTargets.set(img, url);
    if (img.src === url) {
      if (alt !== undefined) img.alt = alt;
      return;
    }
    const probe = new Image();
    probe.src = url;
    probe.decode()
      .catch(() => {})
      .finally(() => {
        if (img.isConnected && pendingSwapTargets.get(img) === url) {
          img.src = url;
          if (alt !== undefined) img.alt = alt;
        }
      });
  }

  function getManifestEntry(index: number): ManifestEntry | undefined {
    return manifest.find((m) => m.originalIndex === index) ?? manifest[index];
  }

  function ensureManifest(): boolean {
    if (manifest.length > 0) return true;
    const manifestScript = document.getElementById('gallery-manifest');
    if (!manifestScript) return false;
    try {
      manifest = JSON.parse(manifestScript.textContent || '[]');
      return manifest.length > 0;
    } catch (e) {
      console.error('Failed to parse gallery manifest', e);
      return false;
    }
  }

  function killTimelines(): void {
    openTimeline?.kill();
    closeTimeline?.kill();
    openTimeline = null;
    closeTimeline = null;
  }

  function clearFlyClone(): void {
    if (flyClone) {
      flyClone.remove();
      flyClone = null;
    }
    if (flyLayer) flyLayer.innerHTML = '';
  }

  function resetHeroInlineStyles(): void {
    if (!heroImage) return;
    gsap.set(heroImage, { clearProps: 'width,height,maxWidth,maxHeight,opacity,transform,x,y,scale' });
    heroImage.style.opacity = '1';
  }

  function setChromeHidden(): void {
    chromeEls.forEach((el) => gsap.set(el, { opacity: 0 }));
    if (thumbStrip) {
      gsap.set(thumbStrip, {
        xPercent: -50,
        left: '50%',
        scale: 0.01,
        transformOrigin: 'center bottom'
      });
    }
    peeks.forEach((peek) => {
      gsap.set(peek, { opacity: 0, y: 0 });
    });
    if (backdropLayer) gsap.set(backdropLayer, { opacity: 0 });
    if (backdropImage) gsap.set(backdropImage, { opacity: 0 });
    if (backdropDim) gsap.set(backdropDim, { opacity: 0 });
  }

  function applyPreviewContent(index: number): void {
    const imageData = getManifestEntry(index);
    if (!imageData) return;

    const position = manifest.findIndex((m) => m.originalIndex === index);
    const displayIndex = position >= 0 ? position + 1 : index + 1;

    if (currentIndexEl) currentIndexEl.textContent = displayIndex.toString();
    if (totalCountEl) totalCountEl.textContent = manifest.length.toString();
    const srCounter = document.getElementById('preview-sr-counter');
    if (srCounter) {
      srCounter.textContent = `Zdjęcie ${displayIndex} z ${manifest.length}: ${imageData.alt}`;
    }

    if (prevBtn) prevBtn.disabled = position <= 0;
    if (nextBtn) nextBtn.disabled = position >= manifest.length - 1;

    peeks.forEach((peek) => {
      const offset = parseInt(peek.dataset.offset || '0', 10);
      const target = position >= 0 ? manifest[position + offset] : undefined;
      const img = peek.querySelector('img');
      if (target && img) {
        img.src = target.gridSrc || target.peekSrc || target.src;
        img.alt = target.alt || '';
        peek.setAttribute(
          'aria-label',
          `${offset === -1 ? 'Poprzednie' : 'Następne'} zdjęcie: ${target.alt}`
        );
        peek.style.visibility = 'visible';
      } else {
        peek.style.visibility = 'hidden';
      }
    });

    thumbnails.forEach((thumb) => {
      const offset = parseInt(thumb.dataset.offset || '0', 10);
      const target = position >= 0 ? manifest[position + offset] : undefined;
      const img = thumb.querySelector('img');
      if (target && img) {
        img.src = target.thumbSrc || target.gridSrc || target.src;
        img.alt = target.alt || '';
        const targetPos = manifest.findIndex((m) => m.originalIndex === target.originalIndex);
        thumb.setAttribute(
          'aria-label',
          `Pokaż zdjęcie ${targetPos + 1} z ${manifest.length}: ${target.alt}`
        );
        thumb.style.display = 'block';
      } else {
        thumb.style.display = 'none';
      }
    });
  }

  function loadHeroAndBackdrop(index: number, immediateSrc?: string): void {
    if (!heroImage || !backdropImage) return;
    const imageData = getManifestEntry(index);
    if (!imageData) return;

    const visibleSrc =
      immediateSrc || imageData.gridSrc || imageData.thumbSrc || imageData.src;
    heroImage.src = visibleSrc;
    heroImage.alt = imageData.alt || '';
    backdropImage.src = visibleSrc;
    backdropImage.alt = '';

    silentSwapSrc(heroImage, imageData.src, imageData.alt);
    silentSwapSrc(backdropImage, imageData.src);
  }

  function preloadImage(index: number): void {
    const entry = manifest.find((m) => m.originalIndex === index);
    if (entry) {
      const img = new Image();
      img.src = entry.src;
    }
  }

  function syncHeroPeekSizing(): void {
    if (!heroImage || !heroPeekGroup) return;
    const { width, height } = heroImage.getBoundingClientRect();
    heroPeekGroup.style.setProperty('--hero-width', `${width}px`);
    heroPeekGroup.style.setProperty('--hero-height', `${height}px`);
  }

  function setupHeroResizeObserver(): void {
    heroResizeObserver?.disconnect();
    if (!heroImage) return;
    heroResizeObserver = new ResizeObserver(() => syncHeroPeekSizing());
    heroResizeObserver.observe(heroImage);
  }

  function updatePreviewState(): void {
    if (!dialog || !heroImage || !backdropImage) return;
    applyPreviewContent(currentIndex);
    loadHeroAndBackdrop(currentIndex);
    syncHeroPeekSizing();
    preloadImage(currentIndex - 1);
    preloadImage(currentIndex + 1);
  }

  function navigate(direction: number): void {
    if (isChoreographyActive || manifest.length === 0) return;
    const position = manifest.findIndex((m) => m.originalIndex === currentIndex);
    if (position < 0) return;
    const newPosition = position + direction;
    if (newPosition >= 0 && newPosition < manifest.length) {
      currentIndex = manifest[newPosition].originalIndex;
      updatePreviewState();
    }
  }

  function handlePrevClick(): void {
    navigate(-1);
  }

  function handleNextClick(): void {
    navigate(1);
  }

  function handleKeyDown(e: KeyboardEvent): void {
    if (!dialog?.open || isChoreographyActive) return;
    switch (e.key) {
      case 'ArrowLeft':
        navigate(-1);
        break;
      case 'ArrowRight':
        navigate(1);
        break;
      case 'Home':
        if (manifest.length > 0) {
          currentIndex = manifest[0].originalIndex;
          updatePreviewState();
        }
        break;
      case 'End':
        if (manifest.length > 0) {
          currentIndex = manifest[manifest.length - 1].originalIndex;
          updatePreviewState();
        }
        break;
    }
  }

  function createFlyClone(tileSrc: string, tileRect: DOMRect): HTMLImageElement {
    clearFlyClone();
    flyClone = document.createElement('img');
    flyClone.src = tileSrc;
    flyClone.alt = '';
    flyClone.decoding = 'async';
    gsap.set(flyClone, {
      position: 'fixed',
      left: tileRect.left,
      top: tileRect.top,
      width: tileRect.width,
      height: tileRect.height,
      margin: 0,
      zIndex: 2
    });
    flyLayer?.appendChild(flyClone);
    return flyClone;
  }

  function openPreview(index: number, opener?: HTMLElement): void {
    if (!dialog || !heroImage || !backdropImage || !flyLayer) return;
    if (isChoreographyActive || dialog.open) return;
    if (!ensureManifest()) return;

    const imageData = getManifestEntry(index);
    if (!imageData) return;

    lastActiveElement = document.activeElement as HTMLElement;
    currentIndex = index;

    if (scrollContainer) scrollContainer.style.overflow = 'hidden';

    if (!history.state?.galleryPreview) {
      history.pushState({ ...history.state, galleryPreview: true }, '');
    }

    killTimelines();
    isChoreographyActive = true;
    clearFlyClone();
    resetHeroInlineStyles();

    const tileImg = opener?.querySelector('.gallery-image') as HTMLImageElement | null;
    const tileRect = opener ? getTileRect(opener) : null;
    const tileSrc =
      tileImg?.currentSrc || tileImg?.src || imageData.gridSrc || imageData.thumbSrc || imageData.src;

    applyPreviewContent(index);
    loadHeroAndBackdrop(index, tileSrc);

    dialog.showModal();
    setChromeHidden();

    if (!tileRect) {
      gsap.set(heroImage, { opacity: 1 });
      const { maxW, maxH } = getHeroMaxBox();
      const final = computeFinalHeroSize(imageData.width, imageData.height, maxW, maxH);
      finalHeroWidth = final.width;
      finalHeroHeight = final.height;
      centeredTileWidth = final.width;
      centeredTileHeight = final.height;
      finishOpenWithoutFly();
      return;
    }

    centeredTileWidth = tileRect.width;
    centeredTileHeight = tileRect.height;
    const { maxW, maxH } = getHeroMaxBox();
    const final = computeFinalHeroSize(imageData.width, imageData.height, maxW, maxH);
    finalHeroWidth = final.width;
    finalHeroHeight = final.height;

    const { centerX, centerY } = getHeroStageCenter();
    const finalLeft = centerX - finalHeroWidth / 2;
    const finalTop = centerY - finalHeroHeight / 2;

    const clone = createFlyClone(tileSrc, tileRect);
    gsap.set(heroImage, { opacity: 0 });

    openTimeline = gsap.timeline({
      defaults: { ease: PREVIEW_OPEN_EASE },
      onComplete: () => {
        isChoreographyActive = false;
        openTimeline = null;
        syncHeroPeekSizing();
        preloadImage(currentIndex - 1);
        preloadImage(currentIndex + 1);
        window.dispatchEvent(new CustomEvent('gallery:preview-pause'));
        closeBtn?.focus();
      }
    });

    const growDuration = PREVIEW_OPEN_SHIFT_DURATION + PREVIEW_OPEN_HERO_BACKDROP_DURATION;

    openTimeline.to(clone, {
      left: finalLeft,
      top: finalTop,
      width: finalHeroWidth,
      height: finalHeroHeight,
      duration: growDuration
    });

    if (backdropLayer) {
      openTimeline.to(
        backdropLayer,
        { opacity: 1, duration: growDuration },
        '<'
      );
    }
    if (backdropImage) {
      openTimeline.to(
        backdropImage,
        { opacity: 1, duration: growDuration },
        '<'
      );
    }
    if (backdropDim) {
      openTimeline.to(
        backdropDim,
        { opacity: 1, duration: growDuration },
        '<'
      );
    }

    openTimeline.add(() => {
      clearFlyClone();
      gsap.set(heroImage, {
        opacity: 1,
        width: finalHeroWidth,
        height: finalHeroHeight,
        maxWidth: 'none',
        maxHeight: 'none'
      });
      syncHeroPeekSizing();
    });

    if (thumbStrip) {
      openTimeline.fromTo(
        thumbStrip,
        { xPercent: -50, left: '50%', scale: 0.01, transformOrigin: 'center bottom' },
        { scale: 1, duration: PREVIEW_OPEN_CHROME_DURATION }
      );
    }

    peeks.forEach((peek) => {
      if (peek.style.visibility === 'hidden') return;
      const offset = finalHeroHeight * 0.5 + 24;
      openTimeline.fromTo(
        peek,
        { opacity: 0, y: offset },
        { opacity: PREVIEW_PEEK_OPACITY, y: 0, duration: PREVIEW_OPEN_CHROME_DURATION },
        '<'
      );
    });

    chromeEls.forEach((el) => {
      if (el === thumbStrip || peeks.includes(el)) return;
      openTimeline.to(el, { opacity: 1, duration: PREVIEW_OPEN_CHROME_DURATION }, '<');
    });

    openTimeline.add(() => {
      document.getElementById('preview-counter')?.classList.add('is-settled');
    });
  }

  function finishOpenWithoutFly(): void {
    if (!heroImage || !backdropImage) return;

    openTimeline = gsap.timeline({
      defaults: { ease: PREVIEW_OPEN_EASE },
      onComplete: () => {
        isChoreographyActive = false;
        openTimeline = null;
        syncHeroPeekSizing();
        preloadImage(currentIndex - 1);
        preloadImage(currentIndex + 1);
        window.dispatchEvent(new CustomEvent('gallery:preview-pause'));
        closeBtn?.focus();
      }
    });

    gsap.set(heroImage, {
      opacity: 1,
      width: finalHeroWidth,
      height: finalHeroHeight,
      maxWidth: 'none',
      maxHeight: 'none'
    });

    if (backdropLayer) openTimeline.set(backdropLayer, { opacity: 1 });
    openTimeline.to(backdropImage, { opacity: 1, duration: PREVIEW_OPEN_HERO_BACKDROP_DURATION });
    if (backdropDim) {
      openTimeline.to(backdropDim, { opacity: 1, duration: PREVIEW_OPEN_HERO_BACKDROP_DURATION }, '<');
    }

    if (thumbStrip) {
      openTimeline.fromTo(
        thumbStrip,
        { xPercent: -50, left: '50%', scale: 0.01, transformOrigin: 'center bottom' },
        { scale: 1, duration: PREVIEW_OPEN_CHROME_DURATION }
      );
    }

    peeks.forEach((peek) => {
      if (peek.style.visibility === 'hidden') return;
      openTimeline.fromTo(
        peek,
        { opacity: 0, y: 48 },
        { opacity: PREVIEW_PEEK_OPACITY, y: 0, duration: PREVIEW_OPEN_CHROME_DURATION },
        '<'
      );
    });

    chromeEls.forEach((el) => {
      if (el === thumbStrip || peeks.includes(el)) return;
      openTimeline.to(el, { opacity: 1, duration: PREVIEW_OPEN_CHROME_DURATION }, '<');
    });

    document.getElementById('preview-counter')?.classList.add('is-settled');
  }

  function requestClosePreview(): void {
    if (!dialog?.open || !heroImage) return;
    if (closeTimeline) return;

    if (openTimeline) {
      openTimeline.kill();
      openTimeline = null;
    }

    isChoreographyActive = true;
    clearFlyClone();

    const peekOffset = () => {
      const h = heroImage?.getBoundingClientRect().height ?? finalHeroHeight;
      return h * 0.5 + 24;
    };

    closeTimeline = gsap.timeline({
      defaults: { ease: PREVIEW_OPEN_EASE },
      onComplete: () => {
        isChoreographyActive = false;
        closeTimeline = null;
        resetHeroInlineStyles();
        setChromeHidden();
        document.getElementById('preview-counter')?.classList.remove('is-settled');
        dialog?.close();
      }
    });

    closeTimeline.addLabel('chromeOut');

    chromeEls.forEach((el) => {
      if (el === thumbStrip || peeks.includes(el)) return;
      closeTimeline!.to(el, { opacity: 0, duration: PREVIEW_OPEN_CHROME_DURATION }, 'chromeOut');
    });

    if (thumbStrip) {
      closeTimeline.to(
        thumbStrip,
        { scale: 0.01, duration: PREVIEW_OPEN_CHROME_DURATION },
        'chromeOut'
      );
    }

    peeks.forEach((peek) => {
      if (peek.style.visibility === 'hidden') return;
      closeTimeline!.to(
        peek,
        { opacity: 0, y: peekOffset(), duration: PREVIEW_OPEN_CHROME_DURATION },
        'chromeOut'
      );
    });

    closeTimeline.addLabel('fadeOut', '+=0');

    if (backdropImage) {
      closeTimeline.to(
        backdropImage,
        { opacity: 0, duration: PREVIEW_OPEN_HERO_BACKDROP_DURATION },
        'fadeOut'
      );
    }
    if (backdropDim) {
      closeTimeline.to(
        backdropDim,
        { opacity: 0, duration: PREVIEW_OPEN_HERO_BACKDROP_DURATION },
        'fadeOut'
      );
    }
    if (backdropLayer) {
      closeTimeline.to(
        backdropLayer,
        { opacity: 0, duration: PREVIEW_OPEN_HERO_BACKDROP_DURATION },
        'fadeOut'
      );
    }

    closeTimeline.to(
      heroImage,
      {
        opacity: 0,
        duration: PREVIEW_OPEN_HERO_BACKDROP_DURATION
      },
      'fadeOut'
    );

    closeTimeline.add(() => {
      window.dispatchEvent(new CustomEvent('gallery:preview-resume'));
    }, 'fadeOut');
  }

  function closePreviewImmediate(): void {
    killTimelines();
    clearFlyClone();
    isChoreographyActive = false;
    if (dialog?.open) dialog.close();
  }

  function handleBackdropClick(e: MouseEvent): void {
    if (isChoreographyActive) return;
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest('.preview-backdrop')) {
      requestClosePreview();
    }
  }

  function handleDialogClose(): void {
    killTimelines();
    clearFlyClone();
    isChoreographyActive = false;

    if (scrollContainer) scrollContainer.style.overflow = '';

    if (heroImage) {
      pendingSwapTargets.delete(heroImage);
      heroImage.src = '';
      resetHeroInlineStyles();
    }
    if (backdropImage) {
      pendingSwapTargets.delete(backdropImage);
      backdropImage.src = '';
      gsap.set(backdropImage, { opacity: 0 });
    }
    if (backdropDim) gsap.set(backdropDim, { opacity: 0 });
    if (backdropLayer) gsap.set(backdropLayer, { opacity: 0 });

    setChromeHidden();
    document.getElementById('preview-counter')?.classList.remove('is-settled');

    if (!isSwapping && history.state?.galleryPreview) {
      history.back();
    }

    if (lastActiveElement) {
      lastActiveElement.focus();
      lastActiveElement = null;
    } else {
      const wrapper = document.querySelector(
        `.gallery-image-wrapper[data-original-index="${currentIndex}"]`
      ) as HTMLElement;
      wrapper?.focus();
    }
  }

  function handlePopState(e: PopStateEvent): void {
    if (!e.state?.galleryPreview && dialog?.open) {
      requestClosePreview();
    }
  }

  function handleCancel(e: Event): void {
    e.preventDefault();
    requestClosePreview();
  }

  function handleCustomOpen(e: Event): void {
    const customEvent = e as CustomEvent<{ index: number; opener?: HTMLElement }>;
    if (customEvent.detail && typeof customEvent.detail.index === 'number') {
      openPreview(customEvent.detail.index, customEvent.detail.opener);
    }
  }

  function cleanupPreview(): void {
    heroResizeObserver?.disconnect();
    heroResizeObserver = null;
    killTimelines();
    window.removeEventListener('gallery:open-preview', handleCustomOpen);
    window.removeEventListener('keydown', handleKeyDown);
    window.removeEventListener('popstate', handlePopState);
    document.removeEventListener('astro:before-swap', handleBeforeSwap);
  }

  function handleBeforeSwap(): void {
    isSwapping = true;
    closePreviewImmediate();
    if (scrollContainer) scrollContainer.style.overflow = '';
    cleanupPreview();
  }

  function setupPreview(): void {
    isSwapping = false;
    dialog = document.getElementById('gallery-preview') as HTMLDialogElement;
    heroImage = document.getElementById('preview-hero-image') as HTMLImageElement;
    backdropImage = document.getElementById('preview-backdrop-image') as HTMLImageElement;
    backdropDim = document.getElementById('preview-backdrop-dim');
    backdropLayer = document.querySelector('.preview-backdrop');
    flyLayer = document.getElementById('preview-fly-layer');
    closeBtn = document.getElementById('preview-close') as HTMLButtonElement;
    prevBtn = document.getElementById('preview-prev') as HTMLButtonElement;
    nextBtn = document.getElementById('preview-next') as HTMLButtonElement;
    currentIndexEl = document.getElementById('preview-current-index');
    totalCountEl = document.getElementById('preview-total-count');
    scrollContainer = document.querySelector('.scroll-container');
    previewLayout = document.querySelector('.preview-layout');
    heroStage = document.querySelector('.hero-stage');
    thumbStrip = document.querySelector('.thumbnail-strip');
    peeks = Array.from(document.querySelectorAll('.preview-peek'));
    thumbnails = Array.from(document.querySelectorAll('.thumbnail-slot'));
    heroPeekGroup = document.querySelector('.hero-peek-group');
    chromeEls = Array.from(document.querySelectorAll('.preview-chrome'));

    if (!dialog) return;

    setupHeroResizeObserver();

    peeks.forEach((peek) => {
      const offset = parseInt(peek.dataset.offset || '0', 10);
      peek.onclick = () => navigate(offset);
    });

    thumbnails.forEach((thumb) => {
      const offset = parseInt(thumb.dataset.offset || '0', 10);
      thumb.onclick = () => {
        if (offset !== 0) navigate(offset);
      };
    });

    window.removeEventListener('gallery:open-preview', handleCustomOpen);
    window.addEventListener('gallery:open-preview', handleCustomOpen);

    dialog.removeEventListener('close', handleDialogClose);
    dialog.addEventListener('close', handleDialogClose);

    dialog.removeEventListener('cancel', handleCancel);
    dialog.addEventListener('cancel', handleCancel);

    dialog.removeEventListener('click', handleBackdropClick);
    dialog.addEventListener('click', handleBackdropClick);

    if (closeBtn) {
      closeBtn.removeEventListener('click', requestClosePreview);
      closeBtn.addEventListener('click', requestClosePreview);
    }

    if (prevBtn) {
      prevBtn.removeEventListener('click', handlePrevClick);
      prevBtn.addEventListener('click', handlePrevClick);
    }

    if (nextBtn) {
      nextBtn.removeEventListener('click', handleNextClick);
      nextBtn.addEventListener('click', handleNextClick);
    }

    window.removeEventListener('keydown', handleKeyDown);
    window.addEventListener('keydown', handleKeyDown);

    window.removeEventListener('popstate', handlePopState);
    window.addEventListener('popstate', handlePopState);

    document.removeEventListener('astro:before-swap', handleBeforeSwap);
    document.addEventListener('astro:before-swap', handleBeforeSwap);
  }

  document.addEventListener('astro:page-load', setupPreview);
</script>
