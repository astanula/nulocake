---
---

<dialog id="gallery-preview" class="gallery-preview" aria-modal="true" aria-label="Podgląd obrazu">
  <div class="preview-backdrop" aria-hidden="true">
    <img id="preview-backdrop-image" src="" alt="" decoding="async" />
  </div>
  <div class="preview-content">
    <button id="preview-close" class="preview-close" aria-label="Zamknij podgląd (Esc)">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="preview-grid">
      <!-- Row 1: Peeks & Hero -->
      <div class="preview-peek peek-left" data-offset="-1"><img src="" alt="" /></div>
      <div class="hero-stage">
        <div id="preview-spinner" class="spinner" aria-hidden="true"></div>
        <img id="preview-hero-image" src="" alt="" decoding="async" />
      </div>
      <div class="preview-peek peek-right" data-offset="1"><img src="" alt="" /></div>

      <!-- Row 2: Counter -->
      <div id="preview-counter" class="preview-counter" aria-live="polite">
        <span id="preview-current-index">1</span> / <span id="preview-total-count">1</span>
      </div>

      <!-- Row 3: Arrows & Thumbnails -->
      <button id="preview-prev" class="preview-arrow" aria-label="Poprzednie zdjęcie">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="thumbnail-strip">
        <button class="thumbnail-slot" data-offset="-2"><img src="" alt="" decoding="async" /></button>
        <button class="thumbnail-slot" data-offset="-1"><img src="" alt="" decoding="async" /></button>
        <button class="thumbnail-slot is-active" data-offset="0"><img src="" alt="" decoding="async" /></button>
        <button class="thumbnail-slot" data-offset="1"><img src="" alt="" decoding="async" /></button>
        <button class="thumbnail-slot" data-offset="2"><img src="" alt="" decoding="async" /></button>
      </div>
      <button id="preview-next" class="preview-arrow" aria-label="Następne zdjęcie">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</dialog>

<style>
  .gallery-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: white;
    z-index: 1000;
  }

  .gallery-preview::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }

  .preview-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  #preview-backdrop-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(40px) brightness(0.5);
    transform: scale(1.1);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #preview-backdrop-image.is-loaded {
    opacity: 1;
  }

  .preview-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .preview-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    z-index: 10;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    opacity: 0.7;
  }

  .preview-close:hover {
    opacity: 1;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: min-content min-content min-content;
    grid-template-rows: min-content min-content min-content;
    gap: var(--preview-gap-y, 1rem) var(--preview-gap-x, 2rem);
    justify-content: center;
    align-content: center;
    align-items: stretch;
    max-width: 95vw;
    max-height: 95vh;
  }

  .hero-stage {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #preview-hero-image {
    max-width: 70vw;
    max-height: 65vh;
    width: auto;
    height: auto;
    display: block;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: var(--gallery-image-radius, 8px);
  }

  #preview-hero-image.is-loaded {
    opacity: 1;
  }

  .spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: white;
    animation: spin 1s ease-in-out infinite;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .spinner.is-visible {
    opacity: 1;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .preview-peek {
    width: var(--peek-width, 6vw);
    min-width: 40px;
    max-width: 100px;
    cursor: pointer;
    opacity: 0.3;
    transition: opacity 0.3s ease;
    overflow: hidden;
    border-radius: var(--gallery-image-radius, 8px);
  }

  .preview-peek:hover {
    opacity: 0.7;
  }

  .preview-peek img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .peek-left {
    grid-column: 1;
    grid-row: 1;
  }

  .peek-right {
    grid-column: 3;
    grid-row: 1;
  }

  .preview-counter {
    grid-column: 2;
    grid-row: 2;
    justify-self: center;
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .thumbnail-strip {
    grid-column: 2;
    grid-row: 3;
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }

  .thumbnail-slot {
    background: transparent;
    border: none;
    padding: 0;
    width: 60px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    transition: all 0.3s ease;
  }

  .thumbnail-slot:hover {
    opacity: 0.8;
  }

  .thumbnail-slot.is-active {
    opacity: 1;
    transform: scale(1.15);
    border: 2px solid white;
    cursor: default;
  }

  .thumbnail-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-arrow {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    justify-self: center;
    align-self: center;
  }

  .preview-arrow:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
  }

  .preview-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  #preview-prev {
    grid-column: 1;
    grid-row: 3;
  }

  #preview-next {
    grid-column: 3;
    grid-row: 3;
  }
</style>

<script>
  let dialog: HTMLDialogElement | null = null;
  let heroImage: HTMLImageElement | null = null;
  let backdropImage: HTMLImageElement | null = null;
  let spinner: HTMLElement | null = null;
  let closeBtn: HTMLButtonElement | null = null;
  let prevBtn: HTMLButtonElement | null = null;
  let nextBtn: HTMLButtonElement | null = null;
  let currentIndexEl: HTMLElement | null = null;
  let totalCountEl: HTMLElement | null = null;
  let scrollContainer: HTMLElement | null = null;
  let peeks: HTMLElement[] = [];
  let thumbnails: HTMLElement[] = [];
  let manifest: any[] = [];
  let currentIndex = 0;

  function closePreview() {
    if (dialog && dialog.open) {
      dialog.close();
    }
  }

  function handleBackdropClick(e: MouseEvent) {
    // Treat clicks on the backdrop image behind the hero exactly like clicks on the dialog
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest('.preview-backdrop')) {
      closePreview();
    }
  }

  function handleDialogClose() {
    if (scrollContainer) {
      scrollContainer.style.overflow = '';
    }
    if (heroImage) {
      heroImage.src = '';
      heroImage.classList.remove('is-loaded');
    }
    if (backdropImage) {
      backdropImage.src = '';
      backdropImage.classList.remove('is-loaded');
    }
    // Only go back if we are currently holding the history state
    if (history.state && history.state.galleryPreview) {
      history.back();
    }
  }

  function handlePopState(e: PopStateEvent) {
    // If the state no longer has galleryPreview, close the modal
    if (!e.state || !e.state.galleryPreview) {
      if (dialog && dialog.open) {
        dialog.close();
      }
    }
  }

  function preloadImage(index: number) {
    if (index >= 0 && index < manifest.length) {
      const img = new Image();
      img.src = manifest[index].src;
    }
  }

  async function updatePreviewState() {
    if (!dialog || !heroImage || !spinner || !backdropImage) return;

    const imageData = manifest[currentIndex];
    if (!imageData) return;

    // Update Counter
    if (currentIndexEl) currentIndexEl.textContent = (currentIndex + 1).toString();
    if (totalCountEl) totalCountEl.textContent = manifest.length.toString();

    // Update Buttons
    if (prevBtn) prevBtn.disabled = currentIndex === 0;
    if (nextBtn) nextBtn.disabled = currentIndex === manifest.length - 1;

    // Update Peeks
    peeks.forEach(peek => {
      const offset = parseInt(peek.dataset.offset || '0', 10);
      const targetIndex = currentIndex + offset;
      const img = peek.querySelector('img');
      if (targetIndex >= 0 && targetIndex < manifest.length && img) {
        img.src = manifest[targetIndex].src;
        peek.style.visibility = 'visible';
      } else {
        peek.style.visibility = 'hidden';
      }
    });

    // Update Thumbnails
    thumbnails.forEach(thumb => {
      const offset = parseInt(thumb.dataset.offset || '0', 10);
      const targetIndex = currentIndex + offset;
      const img = thumb.querySelector('img');
      if (targetIndex >= 0 && targetIndex < manifest.length && img) {
        img.src = manifest[targetIndex].src;
        thumb.style.display = 'block';
      } else {
        thumb.style.display = 'none';
      }
    });

    spinner.classList.add('is-visible');
    heroImage.classList.remove('is-loaded');
    backdropImage.classList.remove('is-loaded');

    try {
      heroImage.src = imageData.src;
      backdropImage.src = imageData.src;
      await Promise.all([
        heroImage.decode().catch(() => {}),
        backdropImage.decode().catch(() => {})
      ]);
    } catch (error) {
      console.error('Image update failed', error);
    } finally {
      spinner.classList.remove('is-visible');
      heroImage.classList.add('is-loaded');
      backdropImage.classList.add('is-loaded');
    }

    // Preload adjacent images
    preloadImage(currentIndex - 1);
    preloadImage(currentIndex + 1);
  }

  function navigate(direction: number) {
    if (manifest.length === 0) return;
    const newIndex = currentIndex + direction;
    if (newIndex >= 0 && newIndex < manifest.length) {
      currentIndex = newIndex;
      updatePreviewState();
    }
  }

  function handlePrevClick() { navigate(-1); }
  function handleNextClick() { navigate(1); }

  function handleKeyDown(e: KeyboardEvent) {
    if (!dialog || !dialog.open) return;
    switch (e.key) {
      case 'ArrowLeft':
        navigate(-1);
        break;
      case 'ArrowRight':
        navigate(1);
        break;
      case 'Home':
        navigate(-currentIndex);
        break;
      case 'End':
        navigate(manifest.length - 1 - currentIndex);
        break;
    }
  }

  async function openPreview(index: number) {
    if (!dialog || !heroImage || !spinner) return;
    
    if (manifest.length === 0) {
      const manifestScript = document.getElementById('gallery-manifest');
      if (manifestScript) {
        try {
          manifest = JSON.parse(manifestScript.textContent || '[]');
        } catch (e) {
          console.error('Failed to parse gallery manifest', e);
          return;
        }
      }
    }

    if (scrollContainer) {
      scrollContainer.style.overflow = 'hidden';
    }

    // Push history state
    if (!history.state || !history.state.galleryPreview) {
      history.pushState({ ...history.state, galleryPreview: true }, '');
    }

    dialog.showModal();
    currentIndex = index;
    updatePreviewState();
  }

  function handleCustomOpen(e: Event) {
    const customEvent = e as CustomEvent;
    if (customEvent.detail && typeof customEvent.detail.index === 'number') {
      openPreview(customEvent.detail.index);
    }
  }

  function setupPreview() {
    dialog = document.getElementById('gallery-preview') as HTMLDialogElement;
    heroImage = document.getElementById('preview-hero-image') as HTMLImageElement;
    backdropImage = document.getElementById('preview-backdrop-image') as HTMLImageElement;
    spinner = document.getElementById('preview-spinner');
    closeBtn = document.getElementById('preview-close') as HTMLButtonElement;
    prevBtn = document.getElementById('preview-prev') as HTMLButtonElement;
    nextBtn = document.getElementById('preview-next') as HTMLButtonElement;
    currentIndexEl = document.getElementById('preview-current-index');
    totalCountEl = document.getElementById('preview-total-count');
    scrollContainer = document.querySelector('.scroll-container');
    peeks = Array.from(document.querySelectorAll('.preview-peek'));
    thumbnails = Array.from(document.querySelectorAll('.thumbnail-slot'));

    if (!dialog) return;

    peeks.forEach(peek => {
      const offset = parseInt(peek.dataset.offset || '0', 10);
      peek.onclick = () => navigate(offset);
    });

    thumbnails.forEach(thumb => {
      const offset = parseInt(thumb.dataset.offset || '0', 10);
      thumb.onclick = () => {
        if (offset !== 0) navigate(offset);
      };
    });

    // Remove old listeners to avoid duplicates during Astro view transitions
    window.removeEventListener('gallery:open-preview', handleCustomOpen);
    window.addEventListener('gallery:open-preview', handleCustomOpen);

    dialog.removeEventListener('close', handleDialogClose);
    dialog.addEventListener('close', handleDialogClose);

    dialog.removeEventListener('click', handleBackdropClick);
    dialog.addEventListener('click', handleBackdropClick);

    if (closeBtn) {
      closeBtn.removeEventListener('click', closePreview);
      closeBtn.addEventListener('click', closePreview);
    }

    if (prevBtn) {
      prevBtn.removeEventListener('click', handlePrevClick);
      prevBtn.addEventListener('click', handlePrevClick);
    }

    if (nextBtn) {
      nextBtn.removeEventListener('click', handleNextClick);
      nextBtn.addEventListener('click', handleNextClick);
    }

    window.removeEventListener('keydown', handleKeyDown);
    window.addEventListener('keydown', handleKeyDown);

    window.removeEventListener('popstate', handlePopState);
    window.addEventListener('popstate', handlePopState);
  }

  // Set up listeners on initial load and view transition page loads
  document.addEventListener('astro:page-load', setupPreview);
</script>
