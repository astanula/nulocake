---
import {
  BUTTON_VARIANTS,
  COLOR_TOKEN_GROUPS,
  ELEVATION_STRIP_VARS,
  MATERIALITY_RULES,
  RESPONSIVE_TIERS,
  SECTION_TITLE_SCALES,
  TYPOGRAPHY_SCALE,
} from '../config/designSystem';

const totalColorTokens = COLOR_TOKEN_GROUPS.reduce((sum, group) => sum + group.tokens.length, 0);
---

<div
  id="design-system-tooltip"
  class="ds-tooltip"
  popover="manual"
  role="dialog"
  aria-label="Noir Patisserie Design System Specification"
  data-ds-tooltip
>
  <header class="ds-header">
    <div class="ds-header-titles">
      <p class="ds-eyebrow">Design System Specification · Live Token Inspector</p>
      <h2 class="ds-title">Noir Patisserie — UI Architecture &amp; Tokens</h2>
    </div>
    <div class="ds-header-meta">
      <span class="ds-viewport-pill" data-ds-viewport aria-live="polite"></span>
      <span class="ds-dismiss-hint">Click token value to copy · Click outside or press Esc to dismiss</span>
    </div>
  </header>

  <div class="ds-bento">
    <!-- LEFT COLUMN: 01 COLOR PALETTE -->
    <section class="ds-card ds-card--colors" aria-labelledby="ds-heading-colors">
      <div class="ds-section-head">
        <h3 id="ds-heading-colors" class="ds-section-title">
          01 · Color Palette &amp; Semantic Tokens ({totalColorTokens})
        </h3>
        <code class="ds-source-tag">global.css (@theme)</code>
      </div>

      {COLOR_TOKEN_GROUPS.map((group) => (
        <div class="ds-color-group">
          <h4 class="ds-group-label">
            {group.title} ({group.tokens.length})
          </h4>
          <ul class="ds-color-list">
            {group.tokens.map((token) => (
              <li class="ds-color-row">
                <span
                  class:list={['ds-swatch', { 'ds-swatch--keyline': token.needsKeyline }]}
                  style={`background: var(${token.cssVar});`}
                  aria-hidden="true"
                />
                <button
                  type="button"
                  class="ds-hex-btn"
                  data-ds-copy-var={token.cssVar}
                  title={`Click to copy resolved value of ${token.cssVar}`}
                >
                  <code data-ds-var={token.cssVar} />
                </button>
                <code class="ds-token-name" title={token.cssVar}>
                  {token.tokenName}
                </code>
                <span class="ds-usage">{token.usage}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <!-- RIGHT COLUMN: 02 BUTTONS + 03 TYPOGRAPHY + 04 MATERIALITY + 05 RESPONSIVE -->
    <div class="ds-right-stack">
      <!-- 02 BUTTON VARIANTS -->
      <section class="ds-card" aria-labelledby="ds-heading-buttons">
        <div class="ds-section-head">
          <h3 id="ds-heading-buttons" class="ds-section-title">
            02 · Button Variants ({BUTTON_VARIANTS.length} Live Specimens)
          </h3>
          <code class="ds-source-tag" data-ds-btn-geometry />
        </div>

        <ul class="ds-btn-list">
          {BUTTON_VARIANTS.map((variant) => (
            <li class="ds-btn-row">
              <div class="ds-btn-specimen-cell">
                {variant.id === 'primary' && (
                  <button type="button" class="btn-primary ds-specimen-btn">
                    {variant.specimenLabel}
                  </button>
                )}
                {variant.id === 'secondary' && (
                  <button type="button" class="btn-secondary ds-specimen-btn">
                    {variant.specimenLabel}
                  </button>
                )}
                {variant.id === 'nav-cta' && (
                  <button type="button" class="ds-specimen-nav-cta">
                    {variant.specimenLabel}
                  </button>
                )}
                {variant.id === 'channel' && (
                  <button type="button" class="ds-specimen-channel">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
                    </svg>
                    <span>{variant.specimenLabel}</span>
                  </button>
                )}
                {variant.id === 'icon-circle' && (
                  <div class="ds-specimen-icon-pair">
                    <button type="button" class="ds-specimen-circle" aria-label="Previous specimen">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="m15 18-6-6 6-6" />
                      </svg>
                    </button>
                    <button type="button" class="ds-specimen-circle" aria-label="Next specimen">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    </button>
                  </div>
                )}
              </div>

              <div class="ds-btn-meta">
                <div class="ds-btn-meta-top">
                  <strong class="ds-item-title">{variant.name}</strong>
                  <code class="ds-selector">{variant.selector}</code>
                </div>
                <p
                  class="ds-token-recipe"
                  data-ds-btn-recipe
                  data-fill-vars={variant.fillVars.join(',')}
                  data-ink-var={variant.inkVar}
                  data-border-var={variant.borderVar ?? ''}
                  data-hover-note={variant.hoverNote}
                />
                <p class="ds-usage">{variant.usage}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- 03 TYPOGRAPHY & FLUID TYPE SCALE -->
      <section class="ds-card" aria-labelledby="ds-heading-type">
        <div class="ds-section-head">
          <h3 id="ds-heading-type" class="ds-section-title">03 · Typography &amp; Fluid Type Scale</h3>
          <code class="ds-source-tag" data-ds-font-families />
        </div>

        <ul class="ds-type-list">
          {TYPOGRAPHY_SCALE.map((entry) => (
            <li class="ds-type-row">
              <div class="ds-type-specimen-wrap">
                {entry.id === 'display-lg' ? (
                  <span class="ds-specimen-display-lg">
                    Display <em class="accent-italic">Accent</em>
                  </span>
                ) : entry.id === 'display-sm' ? (
                  <span class="ds-specimen-display-sm">{entry.label}</span>
                ) : entry.id === 'title-lg' ? (
                  <span class="ds-specimen-title-lg">{entry.label}</span>
                ) : entry.id === 'label-md' ? (
                  <span class="label-md ds-specimen-label">{entry.label}</span>
                ) : (
                  <span class="ds-specimen-body">{entry.label} — Editorial copy</span>
                )}
                <code class="ds-selector">{entry.selector}</code>
              </div>
              <div class="ds-type-details">
                <code
                  class="ds-type-formula"
                  data-ds-type-spec
                  data-family-var={entry.familyVar}
                  data-size-var={entry.sizeVar}
                  data-weight-var={entry.weightVar}
                  data-leading-var={entry.leadingVar ?? ''}
                  data-tracking-var={entry.trackingVar ?? ''}
                  data-extra-var={entry.extraVar ?? ''}
                />
                <span class="ds-usage">{entry.usage}</span>
              </div>
            </li>
          ))}
        </ul>

        <div class="ds-subsection">
          <h4 class="ds-group-label">Responsive Section Title Clamps (:root)</h4>
          <ul class="ds-clamp-list">
            {SECTION_TITLE_SCALES.map((scale) => (
              <li class="ds-clamp-row">
                <span class="ds-clamp-label">
                  <strong>{scale.label}</strong>
                  <code class="ds-selector">{scale.selector}</code>
                </span>
                <code
                  class="ds-type-formula"
                  data-ds-section-clamp={JSON.stringify(scale.varsByTier)}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 04 MATERIALITY, ELEVATION & MOTION -->
      <section class="ds-card" aria-labelledby="ds-heading-materiality">
        <div class="ds-section-head">
          <h3 id="ds-heading-materiality" class="ds-section-title">
            04 · Materiality, Elevation &amp; Motion Standards
          </h3>
          <code class="ds-source-tag">No-Line Gallery System</code>
        </div>

        <div class="ds-elevation-strip" aria-label="Surface elevation progression from lowest to highest">
          {ELEVATION_STRIP_VARS.map((step) => (
            <div
              class="ds-elevation-step"
              style={`background: var(${step.cssVar});`}
              data-ds-elevation-step={step.cssVar}
            >
              <span>{step.name}</span>
            </div>
          ))}
        </div>

        <div class="ds-rules-grid">
          {MATERIALITY_RULES.map((rule) => (
            <div class="ds-rule-cell">
              <div class="ds-rule-head">
                <strong class="ds-item-title">{rule.title}</strong>
                <code class="ds-rule-values" data-ds-rule-vars={rule.cssVars.join(',')} />
              </div>
              <p class="ds-usage">{rule.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 05 RESPONSIVE DESIGN & VIEWPORT ARCHITECTURE -->
      <section class="ds-card" aria-labelledby="ds-heading-responsive">
        <div class="ds-section-head">
          <h3 id="ds-heading-responsive" class="ds-section-title">
            05 · Responsive Design &amp; Viewport Architecture
          </h3>
          <code class="ds-source-tag" data-ds-container-cap />
        </div>

        <ul class="ds-tier-list">
          {RESPONSIVE_TIERS.map((tier) => (
            <li class="ds-tier-row" data-ds-tier={tier.id}>
              <div class="ds-tier-badge-col">
                <span class="ds-tier-name">{tier.tierName}</span>
                <code class="ds-tier-range">{tier.rangeLabel}</code>
                {tier.dynamicVars && (
                  <code class="ds-tier-dynamic" data-ds-tier-vars={tier.dynamicVars.join(',')} />
                )}
              </div>
              <ul class="ds-tier-points">
                {tier.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</div>

<script>
  import {
    HOVER_INTENT_MS,
    TOOLTIP_ANCHOR_GAP_PX,
    TOOLTIP_VIEWPORT_MARGIN_PX,
  } from '../config/designSystem';
  import { getViewportTier } from '../config/responsive';

  let lifecycleController: AbortController | null = null;
  let hoverTimer: number | null = null;

  function cleanFontName(raw: string): string {
    return raw.split(',')[0].replace(/['"]/g, '').trim();
  }

  function readVar(styles: CSSStyleDeclaration, name: string): string {
    return styles.getPropertyValue(name).trim();
  }

  function hydrateDesignTokens(tooltip: HTMLElement): void {
    const styles = getComputedStyle(document.documentElement);

    tooltip.querySelectorAll<HTMLElement>('[data-ds-var]').forEach((el) => {
      const cssVar = el.dataset.dsVar;
      if (cssVar) el.textContent = readVar(styles, cssVar);
    });

    tooltip.querySelectorAll<HTMLElement>('[data-ds-elevation-step]').forEach((el) => {
      const cssVar = el.dataset.dsElevationStep;
      if (cssVar) el.title = `${cssVar}: ${readVar(styles, cssVar)}`;
    });

    const btnGeometry = tooltip.querySelector<HTMLElement>('[data-ds-btn-geometry]');
    if (btnGeometry) {
      const py = readVar(styles, '--btn-padding-y');
      const px = readVar(styles, '--btn-padding-x');
      const radius = readVar(styles, '--radius-xs');
      btnGeometry.textContent = `pad ${py} ${px} · radius ${radius}`;
    }

    tooltip.querySelectorAll<HTMLElement>('[data-ds-btn-recipe]').forEach((el) => {
      const fillVars = (el.dataset.fillVars ?? '').split(',').filter(Boolean);
      const inkVar = el.dataset.inkVar ?? '';
      const borderVar = el.dataset.borderVar ?? '';
      const hoverNote = el.dataset.hoverNote ?? '';

      const parts: string[] = [];
      if (fillVars.length > 1) {
        parts.push(`Fill: ${fillVars.map((v) => readVar(styles, v)).join(' → ')}`);
      } else if (fillVars.length === 1) {
        parts.push(`Fill: ${readVar(styles, fillVars[0])}`);
      } else {
        parts.push('Fill: transparent');
      }
      if (inkVar) parts.push(`Ink: ${readVar(styles, inkVar)}`);
      if (borderVar) parts.push(`Border: ${readVar(styles, borderVar)}`);
      if (hoverNote) parts.push(hoverNote);
      el.textContent = parts.join(' · ');
    });

    const fontFamilies = tooltip.querySelector<HTMLElement>('[data-ds-font-families]');
    if (fontFamilies) {
      const display = cleanFontName(readVar(styles, '--font-family-display'));
      const body = cleanFontName(readVar(styles, '--font-family-body'));
      fontFamilies.textContent = `${display} + ${body}`;
    }

    tooltip.querySelectorAll<HTMLElement>('[data-ds-type-spec]').forEach((el) => {
      const family = cleanFontName(readVar(styles, el.dataset.familyVar ?? ''));
      const size = readVar(styles, el.dataset.sizeVar ?? '');
      const weight = readVar(styles, el.dataset.weightVar ?? '');
      const leading = el.dataset.leadingVar ? readVar(styles, el.dataset.leadingVar) : '';
      const tracking = el.dataset.trackingVar ? readVar(styles, el.dataset.trackingVar) : '';
      const extra = el.dataset.extraVar ? readVar(styles, el.dataset.extraVar) : '';

      const segments = [`${family} ${weight}`, size];
      if (leading) segments.push(`lh ${leading}`);
      if (tracking) segments.push(`ls ${tracking}`);
      if (extra) segments.push(`max ${extra}`);
      el.textContent = segments.join(' · ');
    });

    tooltip.querySelectorAll<HTMLElement>('[data-ds-section-clamp]').forEach((el) => {
      const tierOrder = [
        'large-desktop',
        'desktop',
        'laptop',
        'tablet',
        'mobile',
        'small-mobile',
      ];
      const varsByTier = JSON.parse(el.dataset.dsSectionClamp ?? '{}') as Record<string, string[]>;
      const formulas = tierOrder.map((tier) => ({
        tier,
        formula: `clamp(${(varsByTier[tier] ?? []).map((cssVar) => readVar(styles, cssVar)).join(', ')})`,
      }));
      const groups: { start: string; end: string; formula: string; count: number }[] = [];

      formulas.forEach(({ tier, formula }) => {
        const previous = groups[groups.length - 1];
        if (previous?.formula === formula) {
          previous.end = tier;
          previous.count += 1;
        } else {
          groups.push({ start: tier, end: tier, formula, count: 1 });
        }
      });

      el.textContent = groups.length === 1
        ? `All tiers: ${groups[0].formula}`
        : groups
          .map((group) => `${group.count === 1 ? group.start : `${group.start}–${group.end}`}: ${group.formula}`)
          .join(' · ');
    });

    tooltip.querySelectorAll<HTMLElement>('[data-ds-rule-vars]').forEach((el) => {
      const vars = (el.dataset.dsRuleVars ?? '').split(',').filter(Boolean);
      el.textContent = vars.map((v) => readVar(styles, v)).join(' · ');
    });

    const containerCap = tooltip.querySelector<HTMLElement>('[data-ds-container-cap]');
    if (containerCap) {
      containerCap.textContent = `container max ${readVar(styles, '--layout-max-width')}`;
    }

    tooltip.querySelectorAll<HTMLElement>('[data-ds-tier-vars]').forEach((el) => {
      const vars = (el.dataset.dsTierVars ?? '').split(',').filter(Boolean);
      if (vars.length === 1) {
        el.textContent = `max-width: ${readVar(styles, vars[0])}`;
      } else if (vars.length === 3) {
        el.textContent = `hero clamp(${vars.map((v) => readVar(styles, v)).join(', ')})`;
      }
    });
  }

  function updateViewportState(tooltip: HTMLElement): void {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const tier = getViewportTier(w);

    const badge = tooltip.querySelector<HTMLElement>('[data-ds-viewport]');
    if (badge) {
      badge.textContent = `Viewport: ${w}×${h}px · Active: ${tier.label} (${tier.range})`;
    }

    tooltip.querySelectorAll<HTMLElement>('[data-ds-tier]').forEach((row) => {
      if (row.dataset.dsTier === tier.id) {
        row.setAttribute('data-active', 'true');
      } else {
        row.removeAttribute('data-active');
      }
    });
  }

  function positionTooltip(tooltip: HTMLElement, trigger: HTMLElement): void {
    const rect = trigger.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const margin = TOOLTIP_VIEWPORT_MARGIN_PX;

    const availableAbove = rect.top - TOOLTIP_ANCHOR_GAP_PX - margin;
    if (availableAbove >= 260) {
      tooltip.style.bottom = `${Math.round(vh - rect.top + TOOLTIP_ANCHOR_GAP_PX)}px`;
      tooltip.style.maxHeight = `${Math.min(740, Math.floor(availableAbove))}px`;
    } else {
      tooltip.style.bottom = `${margin}px`;
      tooltip.style.maxHeight = `${Math.min(740, vh - margin * 2)}px`;
    }

    const sheetWidth = tooltip.offsetWidth;
    const maxLeft = Math.max(margin, vw - sheetWidth - margin);
    const clampedLeft = Math.min(Math.max(margin, Math.round(rect.left)), maxLeft);
    tooltip.style.left = `${clampedLeft}px`;
  }

  function teardownDesignSystemTooltip(): void {
    if (hoverTimer !== null) {
      window.clearTimeout(hoverTimer);
      hoverTimer = null;
    }
    const openTooltip = document.querySelector<HTMLElement>('[data-ds-tooltip]');
    if (openTooltip?.matches(':popover-open')) {
      openTooltip.hidePopover();
    }
    lifecycleController?.abort();
    lifecycleController = null;
  }

  function initDesignSystemTooltip(): void {
    teardownDesignSystemTooltip();

    const trigger = document.querySelector<HTMLElement>('[data-ds-trigger]');
    const tooltip = document.querySelector<HTMLElement>('[data-ds-tooltip]');
    if (!trigger || !tooltip || typeof tooltip.showPopover !== 'function') return;

    lifecycleController = new AbortController();
    const { signal } = lifecycleController;

    const isOpen = () => tooltip.matches(':popover-open');

    const openTooltip = () => {
      if (hoverTimer !== null) {
        window.clearTimeout(hoverTimer);
        hoverTimer = null;
      }
      hydrateDesignTokens(tooltip);
      updateViewportState(tooltip);
      if (!isOpen()) {
        tooltip.showPopover();
      }
      positionTooltip(tooltip, trigger);
    };

    const closeTooltip = () => {
      if (hoverTimer !== null) {
        window.clearTimeout(hoverTimer);
        hoverTimer = null;
      }
      if (isOpen()) {
        tooltip.hidePopover();
      }
    };

    trigger.addEventListener(
      'pointerenter',
      (e) => {
        if (e.pointerType !== 'mouse' || isOpen()) return;
        if (hoverTimer !== null) window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => {
          hoverTimer = null;
          openTooltip();
        }, HOVER_INTENT_MS);
      },
      { signal },
    );

    trigger.addEventListener(
      'pointerleave',
      () => {
        if (hoverTimer !== null) {
          window.clearTimeout(hoverTimer);
          hoverTimer = null;
        }
      },
      { signal },
    );

    trigger.addEventListener(
      'click',
      () => {
        if (!isOpen()) openTooltip();
      },
      { signal },
    );

    tooltip.addEventListener(
      'click',
      (e) => {
        const copyBtn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-ds-copy-var]');
        if (!copyBtn) return;
        const cssVar = copyBtn.dataset.dsCopyVar;
        if (!cssVar) return;
        const value = readVar(getComputedStyle(document.documentElement), cssVar);
        if (!value) return;
        navigator.clipboard?.writeText(value).catch(() => {});
        const codeEl = copyBtn.querySelector('code');
        if (codeEl) {
          codeEl.textContent = 'Copied';
          window.setTimeout(() => {
            if (tooltip.isConnected) codeEl.textContent = value;
          }, 1100);
        }
      },
      { signal },
    );

    // Isolate scroll/touch/navigation-key events inside the open sheet so
    // home snapNavigator and v2 stackFade never fire underneath.
    const stopBubble = (e: Event) => {
      if (isOpen()) e.stopPropagation();
    };
    tooltip.addEventListener('wheel', stopBubble, { passive: true, signal });
    tooltip.addEventListener('touchstart', stopBubble, { passive: true, signal });
    tooltip.addEventListener('touchmove', stopBubble, { passive: true, signal });
    tooltip.addEventListener(
      'keydown',
      (e) => {
        if (!isOpen()) return;
        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(e.key)) {
          e.stopPropagation();
        }
      },
      { signal },
    );

    document.addEventListener(
      'pointerdown',
      (e) => {
        if (!isOpen()) return;
        const target = e.target as Node | null;
        if (target && (tooltip.contains(target) || trigger.contains(target))) return;
        closeTooltip();
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && isOpen()) {
          e.preventDefault();
          e.stopImmediatePropagation();
          closeTooltip();
        }
      },
      { capture: true, signal },
    );

    window.addEventListener(
      'resize',
      () => {
        if (!isOpen()) return;
        updateViewportState(tooltip);
        positionTooltip(tooltip, trigger);
      },
      { passive: true, signal },
    );
  }

  document.addEventListener('astro:page-load', initDesignSystemTooltip);
  document.addEventListener('astro:before-swap', teardownDesignSystemTooltip);
</script>

<style>
  .ds-tooltip {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 1.25rem 1.375rem;
    width: min(1140px, calc(100vw - 2rem));
    max-height: min(78dvh, 740px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: color-mix(in srgb, var(--color-surface-dim) 95%, transparent);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid color-mix(in srgb, var(--color-outline) 26%, transparent);
    border-radius: var(--radius-sm);
    box-shadow:
      0 24px 56px rgba(0, 0, 0, 0.68),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    color: var(--color-on-surface);
    font-family: var(--font-family-body);
    line-height: 1.45;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.22s var(--ease-standard),
      transform 0.22s var(--ease-standard),
      display 0.22s allow-discrete,
      overlay 0.22s allow-discrete;
  }

  .ds-tooltip:popover-open {
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    .ds-tooltip:popover-open {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* ── Header ────────────────────────────────────── */
  .ds-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-bottom: 0.875rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
  }

  .ds-eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-primary);
    margin-bottom: 0.1875rem;
  }

  .ds-title {
    font-family: var(--font-family-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-on-surface);
  }

  .ds-header-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem 0.875rem;
