---
import DesignSystemTooltip from './DesignSystemTooltip.astro';
---
<footer class="footer">
  <div class="footer-inner">
    <p class="footer-copy">
      <span class="footer-copy-trigger" data-ds-trigger>&copy; 2026 Nulo Cake.</span> The Digital Gallery of Edible Art.
    </p>
  </div>
  <DesignSystemTooltip />
</footer>

<style>
  .footer {
    flex-shrink: 0;
    margin-top: auto;
    padding: 1rem 2rem;
    background: var(--color-background);
    border-top: 1px solid var(--ghost-border);
  }

  .footer-inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  .footer-copy {
    font-family: var(--font-family-body);
    font-size: 0.75rem;
    color: var(--color-outline);
    letter-spacing: 0.02em;
  }

  .footer-copy-trigger {
    color: inherit;
    cursor: inherit;
  }

  @media (max-width: 768px) {
    .footer-inner {
      text-align: center;
    }
  }
</style>
