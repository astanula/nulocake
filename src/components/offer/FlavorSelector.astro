---
import CakeCrossSection from './CakeCrossSection.astro';
import FlavorLayerMap from './FlavorLayerMap.astro';
import { CAKE_FLAVORS, CREAM_HEIGHT_CM, SPONGE_HEIGHT_CM } from '../../config/cakeFlavors';
---

<div class="flavor-selector" data-flavor-selector>
  <p class="flavor-hint" id="flavor-hint">Wybierz smak, aby zobaczyć szczegóły.</p>

  <div class="flavor-layout">
    <fieldset class="flavor-picks" aria-describedby="flavor-hint">
      <legend class="visually-hidden">Smak tortu</legend>
      <div class="flavor-pick-list">
        {CAKE_FLAVORS.map((flavor, index) => (
          <label class="flavor-pick">
            <input type="radio" name="cake-flavor" value={flavor.id} aria-controls="flavor-card" checked={index === 0} />
            <span class="flavor-thumb"><CakeCrossSection flavor={flavor} /></span>
            <span class="flavor-pick-name">{flavor.name}</span>
            <svg class="flavor-pick-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M3 8.5l3.2 3L13 4.5" />
            </svg>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="flavor-card" id="flavor-card">
      {CAKE_FLAVORS.map((flavor, index) => (
        <article class="flavor-panel" data-flavor-panel={flavor.id} data-flavor-name={flavor.name} aria-labelledby={`flavor-${flavor.id}-title`} hidden={index !== 0}>
          <h3 class="flavor-card-title" id={`flavor-${flavor.id}-title`}>{flavor.name}</h3>
          <FlavorLayerMap flavor={flavor} />
        </article>
      ))}
    </div>
  </div>

  <div class="flavor-accordion">
    {CAKE_FLAVORS.map((flavor) => (
      <details class="flavor-accordion-item" name="cake-flavor-details" data-flavor-accordion={flavor.id}>
        <summary class="flavor-pick">
          <span class="flavor-thumb"><CakeCrossSection flavor={flavor} /></span>
          <span class="flavor-pick-name">{flavor.name}</span>
          <svg class="flavor-pick-toggle" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M3 5.5l5 5 5-5" />
          </svg>
        </summary>
        <div class="flavor-accordion-panel">
          <FlavorLayerMap flavor={flavor} />
        </div>
      </details>
    ))}
  </div>

  <p class="flavor-note">Każdy tort to trzy warstwy biszkoptu po {SPONGE_HEIGHT_CM} cm i dwie warstwy kremu po {CREAM_HEIGHT_CM} cm. Dodatki są częścią kremów. Przekrój jest poglądowy.</p>
  <p class="visually-hidden" role="status" data-flavor-status></p>
</div>

<script>
  let cleanupController: AbortController | null = null;

  function initFlavorSelector() {
    cleanupController?.abort();
    cleanupController = null;

    const root = document.querySelector<HTMLElement>('[data-flavor-selector]');
    if (!root) return;

    cleanupController = new AbortController();
    const { signal } = cleanupController;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-flavor-panel]'));
    const status = root.querySelector<HTMLElement>('[data-flavor-status]')!;

    const showFlavor = (id: string, announce: boolean) => {
      const active = panels.find((panel) => panel.dataset.flavorPanel === id);
      panels.forEach((panel) => {
        panel.hidden = panel !== active;
      });
      if (announce && active) status.textContent = `Pokazuję warstwy smaku: ${active.dataset.flavorName}.`;
    };

    root.addEventListener(
      'change',
      (event) => {
        const input = event.target as HTMLInputElement;
        if (input.name === 'cake-flavor') showFlavor(input.value, true);
      },
      { signal },
    );

    // Browsers may restore a checked radio on history navigation.
    const selected = root.querySelector<HTMLInputElement>('input[name="cake-flavor"]:checked')
      ?? root.querySelector<HTMLInputElement>('input[name="cake-flavor"]');
    if (selected) {
      selected.checked = true;
      showFlavor(selected.value, false);
    }
  }

  document.addEventListener('astro:page-load', initFlavorSelector);
  document.addEventListener('astro:before-swap', () => {
    cleanupController?.abort();
    cleanupController = null;
  });
</script>

<style>
  .flavor-selector {
    --flavor-card-width: 34rem;
    --flavor-eyebrow-gap: 1.25rem;
    width: 100%;
    margin: 0.5rem 0 1rem;
  }

  .flavor-hint {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--color-primary);
  }

  .flavor-layout {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .flavor-picks {
    min-width: 0;
    border: 0;
  }

  .flavor-pick-list {
    display: flex;
    flex-direction: column;
  }

  .flavor-pick {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 15px;
    gap: 0.625rem;
    align-items: center;
    padding: 0.40625rem 0.625rem;
    border-top: 1px solid var(--color-outline-variant);
    list-style: none;
    cursor: pointer;
  }

  .flavor-pick::-webkit-details-marker {
    display: none;
  }

  .flavor-pick:last-child {
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .flavor-pick input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .flavor-pick:hover {
    background: var(--color-surface-container-low);
  }

  .flavor-pick:has(input:focus-visible),
  .flavor-pick:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .flavor-pick:has(input:checked),
  [open] > .flavor-pick {
    background: color-mix(in srgb, var(--color-primary) 7%, var(--color-surface-container-low));
    box-shadow: inset 2px 0 var(--color-primary);
  }

  .flavor-thumb {
    display: flex;
    width: 32px;
    height: 31px;
  }

  .flavor-pick-name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-on-surface);
  }

  .flavor-pick:has(input:checked) .flavor-pick-name,
  [open] > .flavor-pick .flavor-pick-name {
    color: var(--color-primary);
  }

  .flavor-pick-mark,
  .flavor-pick-toggle {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flavor-pick-mark {
    visibility: hidden;
  }

  .flavor-pick:has(input:checked) .flavor-pick-mark {
    visibility: visible;
  }

  [open] > .flavor-pick .flavor-pick-toggle {
    transform: rotate(180deg);
  }

  .flavor-card {
    justify-self: start;
    min-width: 0;
    width: var(--flavor-card-width);
    max-width: 100%;
    padding: 1.75rem;
    border: 1px solid var(--color-outline-variant);
    background: var(--color-surface);
  }

  .flavor-panel[hidden] {
    display: none;
  }

  .flavor-card-title {
    margin-bottom: var(--flavor-eyebrow-gap);
    font-family: var(--font-family-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--color-on-surface);
    overflow-wrap: anywhere;
  }

  .flavor-accordion {
    container: flavor-accordion / inline-size;
    display: none;
    width: var(--flavor-card-width);
    max-width: 100%;
  }

  .flavor-accordion-item:last-child {
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .flavor-accordion-panel {
    padding: var(--flavor-eyebrow-gap) 1.75rem;
    border: 1px solid var(--color-outline-variant);
    border-bottom: 0;
    background: var(--color-surface);
  }

  @container flavor-accordion (width < 34rem) {
    .flavor-accordion-panel {
      --cake-cross-section-width: 4.5rem;
      --layer-map-gap: 1.375rem;
      --layer-row-height: 1.8125rem;
      --layer-name-size: 0.8125rem;
      --layer-addition-size: 0.6875rem;
      padding: var(--flavor-eyebrow-gap) 0.9375rem;
    }
  }

  .flavor-note {
    margin-top: 1.25rem;
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flavor-pick {
      transition: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .flavor-pick-toggle {
      transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .flavor-panel:not([hidden]),
    [open] > .flavor-accordion-panel {
      animation: flavor-panel-in 0.2s ease-out;
    }

    @keyframes flavor-panel-in {
      from {
        opacity: 0;
        transform: translateY(5px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 768px) {
    .flavor-layout {
      display: none;
    }

    .flavor-accordion {
      display: block;
    }
  }
</style>
