---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getGlobalFontFamilies, googleFontsUrl } from '../config/fonts';
import globalCss from '../styles/global.css?raw';
import { withBase } from '../utils/withBase';

interface Props {
  title: string;
  description?: string;
  isSubpage?: boolean;
}

const { 
  title, 
  description = 'Artystyczne torty na zamówienie tworzone z pasją. Nulo Cake — jadalne dzieła sztuki.',
  isSubpage = false
} = Astro.props;
const fontStylesheets = getGlobalFontFamilies(globalCss).map((font) => googleFontsUrl([font]));
---

<!doctype html>
<html lang="pl">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" href={withBase('favicon.ico')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {fontStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#hero-scroll-container" class="skip-link">Przejdź do treści</a>
    {isSubpage ? (
      <Navigation />
      <div class="scroll-container">
        <slot />
        <Footer />
      </div>
    ) : (
      <slot />
    )}

    <script>
      function updateScrollLayout() {
        document.body.classList.toggle(
          'scroll-layout-active',
          Boolean(document.querySelector('.scroll-container')),
        );
        document.body.classList.toggle(
          'gallery-page-active',
          window.location.pathname.includes('/galeria'),
        );
      }

      if (typeof document !== 'undefined') {
        document.addEventListener('astro:page-load', updateScrollLayout);
        document.addEventListener('astro:before-swap', () => {
          document.body.classList.remove('scroll-layout-active');
          document.body.classList.remove('gallery-page-active');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  body.scroll-layout-active {
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  body.scroll-layout-active .nav {
    position: relative !important;
  }

  .scroll-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-gutter: stable;
    min-height: 0;
  }
</style>

