---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  isSubpage?: boolean;
}

const { 
  title, 
  description = 'Artystyczne torty na zamówienie tworzone z pasją. Nulo Cake — jadalne dzieła sztuki.',
  isSubpage = false
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Manrope:wght@300;400;500;600;700;800&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#hero-scroll-container" class="skip-link">Przejdź do treści</a>
    {isSubpage ? (
      <Navigation />
      <div class="scroll-container">
        <slot />
        <Footer />
      </div>
    ) : (
      <slot />
    )}

    <script>
      function updateScrollLayout() {
        const isSubpage = window.location.pathname !== '/' && window.location.pathname !== '';
        if (isSubpage) {
          document.body.classList.add('scroll-layout-active');
        } else {
          document.body.classList.remove('scroll-layout-active');
        }
      }

      if (typeof document !== 'undefined') {
        document.addEventListener('astro:page-load', updateScrollLayout);
        document.addEventListener('astro:before-swap', () => {
          document.body.classList.remove('scroll-layout-active');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  body.scroll-layout-active {
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  body.scroll-layout-active .nav {
    position: relative !important;
  }

  .scroll-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    min-height: 0;
  }
</style>

